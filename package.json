{
  "name": "liberty-city-bot",
  "version": "2.0.0",
  "description": "Liberty City - بوت ديسكورد شامل ومتكامل مع حماية، تكتات، AI وإعدادات متقدمة",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "nodemon --exec ts-node src/index.ts",
    "lint": "eslint src/**/*.ts",
    "register:commands": "node dist/utils/registerCommands.js",
    "deploy": "npm run build && npm run start"
  },
  "keywords": [
    "discord",
    "bot",
    "liberty-city",
    "protection",
    "tickets",
    "ai",
    "moderation"
  ],
  "author": "Liberty City Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@napi-rs/canvas": "^1.0.11",
    "axios": "^1.6.7",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "discord.js": "^14.14.1",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "helmet": "^7.1.0",
    "i18next": "^23.10.1",
    "i18next-fs-backend": "^2.3.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "moment-duration-format": "^2.3.2",
    "mongoose": "^8.1.1",
    "ms": "^2.1.3",
    "node-cron": "^3.0.3",
    "openai": "^4.28.0",
    "rate-limiter-flexible": "^5.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/figlet": "^1.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/ms": "^0.7.34",
    "@types/node": "^20.11.17",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "nodemon": "^3.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
