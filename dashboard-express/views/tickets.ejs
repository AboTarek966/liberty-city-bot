<%- include('layout-top', { title: 'التذاكر', activePage: 'tickets' }) %>

<% const GID = guild.id; const list = (Array.isArray(tickets) ? tickets : []); const openCnt = list.filter(t => t.status === 'open').length; const claimed = list.filter(t => t.status === 'claimed').length; %>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--green),var(--blue));display:grid;place-items:center;font-size:26px;"><i class="bi bi-lifebuoy"></i></div>
  <div>
    <div class="h-title">لوحة التذاكر
      <span class="chip green"><%= openCnt %> مفتوحة</span>
      <% if (claimed) { %><span class="chip blue"><%= claimed %> مُستلمة</span><% } %>
    </div>
    <div class="h-desc">تابع تذاكر السيرفر — استلم، رد، أغلق، أو امسح — كل إجراء ينفذه البوت مباشرة في Discord</div>
  </div>
  <div class="h-actions btn-group">
    <button class="btn" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i> تحديث</button>
  </div>
</div>

<div class="card">
  <div class="card-body" style="display:flex;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--line);">
    <input id="tSearch" class="inp" style="max-width:300px;" placeholder="🔎 بحث بموضوع / معرف المستخدم…">
    <select id="tFilter" class="inp" style="max-width:170px;">
      <option value="">كل الحالات</option>
      <option value="open">مفتوحة</option>
      <option value="claimed">مُستلمة</option>
      <option value="closed">مغلقة</option>
    </select>
    <span class="chip purple" style="margin-inline-start:auto;"><%= list.length %> تذكرة</span>
  </div>
  <div class="card-body tight">
    <% const S = { open: ['مفتوحة', 'green'], claimed: ['مُستلمة', 'blue'], closed: ['مغلقة', ''], deleted: ['محذوفة', 'red'] }; %>
    <% if (!list.length) { %>
      <div class="empty"><i class="bi bi-lifebuoy"></i><h4>لا تذاكر بعد</h4><p>عند أنشاء تذكرة بالسيرفر ستظهر هنا فوراً (مباشر من قاعدة البيانات المشتركة)</p></div>
    <% } else { %>
      <% list.forEach((t, i) => { const st = S[t.status] || ['?', '']; %>
      <div class="feat tk-row" data-search="<%= (((t.subject || '') + ' ' + (t.userId || ''))).toLowerCase() %>" data-status="<%= t.status || '' %>">
        <div class="f-ico" style="background:var(--<%= st[1] ? st[1] : 'purple' %>-soft);color:var(--<%= st[1] ? st[1] : 'primary-2' %>);"><i class="bi bi-ticket-perforated"></i></div>
        <div class="f-info">
          <div class="f-name">
            #<%= (t.number || list.length - i) %> — <%= (t.subject || t.type || 'تذكرة').slice(0, 44) %>
            <span class="chip <%= st[1] %>"><%= st[0] %></span>
          </div>
          <div class="f-desc">صاحبها <code class="code-cell"><%= t.userId || '؟' %></code>
            <% if (t.claimedBy) { %> · مستلمها <b class="text-mid"><%= t.claimedBy %></b><% } %>
            · <%= t.createdAt ? new Date(t.createdAt).toLocaleString('ar-EG', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %>
          </div>
        </div>
        <div class="f-actions">
          <% if (t.status !== 'closed') { %>
            <% if (!t.claimedBy) { %><button class="btn sm green" onclick="act('<%= t._id || t.channelId %>', 'claim')"><i class="bi bi-hand-thumbs-up"></i> استلام</button><% } else { %><button class="btn sm" onclick="act('<%= t._id || t.channelId %>', 'unclaim')"><i class="bi bi-arrow-counterclockwise"></i> رجوع</button><% } %>
            <button class="btn sm" onclick="openTicket('<%= t._id || t.channelId %>')"><i class="bi bi-chat-dots"></i> فتح</button>
            <button class="btn sm warn" onclick="act('<%= t._id || t.channelId %>', 'close')"><i class="bi bi-lock"></i> إغلاق</button>
          <% } else { %>
            <button class="btn sm" onclick="openTicket('<%= t._id || t.channelId %>')">عرض الخلصة</button>
          <% } %>
          <button class="btn sm danger" onclick="act('<%= t._id || t.channelId %>', 'delete')"><i class="bi bi-trash"></i></button>
        </div>
      </div>
      <% }) %>
    <% } %>
  </div>
</div>

<script>
  const GID = '<%= GID %>';

  async function act(id, action) {
    let body = {};
    if (action === 'close' && !await LC.confirmBox('إغلاق التذكرة', 'سيُغلق روم التذكرة ويُحفظ الخلصة — متأكد؟')) return;
    if (action === 'delete' && !await LC.confirmBox('حذف التذكرة', 'حذف نهائي لسجل التذكرة + رومها — متأكد؟')) return;
    if (action === 'claim') body.actor = '<%= user?.username || 'لوحة التحكم' %>';
    if (action === 'reply') {
      const content = prompt('اكتب رسالتك للصاحب:');
      if (!content) return;
      body.content = content;
    }
    try {
      await LC.api(`/api/guilds/${GID}/tickets/${id}/${action}`, { method: 'POST', body });
      LC.toast('تم التنفيذ عبر البوت ✅');
      setTimeout(() => location.reload(), 800);
    } catch (e) { LC.toast('فشل: ' + e.message, 'error', 6000); }
  }

  async function openTicket(id) {
    const m = LC.modal({
      title: 'تفاصيل التذكرة', wide: true,
      body: '<div class="flex"><span class="spinner"></span> <span class="text-dim" style="font-weight:700;">جاري الجلب…</span></div>',
      actions: [],
    });
    try {
      const t = await LC.api(`/api/guilds/${GID}/tickets/${id}`);
      const st = (t.status || '').replace('claimed', 'مُستلمة').replace('open', 'مفتوحة').replace('closed', 'مغلقة');
      const fields = (t.fields || []).map(f => `<div style="margin-bottom:8px;"><div class="text-dim" style="font-size:10.5px;font-weight:800;">${LC.esc(f.label || '')}</div><div style="font-size:12.5px;font-weight:600;">${LC.esc(f.value || '')}</div></div>`).join('');
      const msg = (t.transcript || '').split('\n').map(LC.esc).join('<br>');
      m.querySelector('.modal-body').innerHTML = `
        <div class="spread mb-3">
          <div>
            <div class="fw800" style="font-size:15px;">${LC.esc(t.subject || t.type || 'تذكرة')} <span class="chip blue">${st}</span></div>
            <div class="text-dim" style="font-size:11.5px;">من ${LC.esc(t.userId || '؟')} · ${t.createdAt ? new Date(t.createdAt).toLocaleString('ar-EG') : ''} · ${LC.esc(t.priority || '')}</div>
          </div>
          ${t.channelId ? `<a class="btn sm" target="_blank" href="https://discord.com/channels/${GID}/${t.channelId}"><i class="bi bi-box-arrow-up-right"></i> رومها</a>` : ''}
        </div>
        ${fields ? `<div class="card mb-3" style="box-shadow:none;"><div class="card-body" style="padding:13px;font-size:12.5px;">${fields}</div></div>` : ''}
        ${t.claimedBy ? `<div class="chip blue mb-3"><i class="bi bi-person-check"></i> مستلمها ${LC.esc(t.claimedBy)}</div>` : ''}
        ${msg ? `<div style="background:var(--bg-soft);border:1px solid var(--line);border-radius:10px;padding:12px;max-height:260px;overflow:auto;font-size:12.5px;line-height:1.8;">${msg || '<span class="text-dim">لا محتوى محفوظ</span>'}</div>` : '<div class="text-dim" style="font-size:12px;">لا محتوى/خلصة محفوظة بعد</div>'}
        ${t.status !== 'closed' ? `<div class="mt-3 flex"><input id="tkReply" class="inp" placeholder="اكتب رداً يظهر في روم التذكرة…"><button class="btn primary" onclick="replyNow('${id}')"><i class="bi bi-send"></i> إرسال</button></div>` : ''}`;
    } catch (e) {
      m.querySelector('.modal-body').innerHTML = `<div class="empty"><i class="bi bi-slash-circle"></i><h4>تعذر</h4><p>${LC.esc(e.message)}</p></div>`;
    }
  }
  async function replyNow(id) {
    const content = document.getElementById('tkReply').value.trim();
    if (!content) return LC.toast('اكتب شيئاً', 'warn');
    try {
      await LC.api(`/api/guilds/${GID}/tickets/${id}/reply`, { method: 'POST', body: { content, actor: '<%= user?.username || 'لوحة التحكم' %>' } });
      LC.toast('أُرسل الرد إلى روم التذكرة ✅'); LC.close();
    } catch (e) { LC.toast(e.message, 'error'); }
  }

  document.getElementById('tSearch').addEventListener('input', applyFilter);
  document.getElementById('tFilter').addEventListener('change', applyFilter);
  function applyFilter() {
    const q = document.getElementById('tSearch').value.trim().toLowerCase();
    const f = document.getElementById('tFilter').value;
    $$('.tk-row').forEach(r => {
      const okQ = !q || r.dataset.search.includes(q);
      const okF = !f || r.dataset.status === f;
      r.style.display = okQ && okF ? '' : 'none';
    });
  }
</script>

<%- include('layout-bottom') %>
