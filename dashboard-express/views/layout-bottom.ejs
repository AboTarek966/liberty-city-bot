    </main>

    <footer style="padding:22px 26px;color:var(--text-3);font-size:11.5px;font-weight:600;text-align:center;">
      Liberty City © 2026 — بوابة القنصل · متصلة بقاعدة بيانات مشتركة مع البوت
    </footer>
  </div>
</div>

<script src="/js/ui.js?v=21"></script>
<script>
  // Bot connection pill (nav) — checks the queue with a light ping
  (async () => {
    const pill = document.getElementById('connPill');
    const text = document.getElementById('connText');
    if (!pill) return;
    const guildId = '<%= locals.guild?.id || '' %>';
    const check = async (silent = false) => {
      try {
        const r = await LC.api('/api/bot/status' + (guildId ? `?guildId=${guildId}` : ''));
        if (r.online) { pill.className = 'conn ok'; text.textContent = 'البوت متصل الآن'; return true; }
        pill.className = 'conn bad'; text.textContent = 'البوت غير متصل — الأوامر تنتظر أوتاً';
        return false;
      } catch { pill.className = 'conn bad'; text.textContent = 'تعذر فحص حالة البوت'; return false; }
    };
    let ok = await check();
    if (!ok) // one quick retry after boot
      setTimeout(() => { if (!pill.classList.contains('ok')) check(); }, 12000);
  })();

  // wire auto-saving switches with the current guild (when present)
  document.addEventListener('DOMContentLoaded', () => {
    LC.initTabs();
    const gid = '<%= locals.guild?.id || '' %>';
    if (gid) LC.wireSwitches(gid);
  });
</script>
<%- locals.tail || '' %>
</body>
</html>
