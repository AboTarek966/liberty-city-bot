<%- include('layout-top', { title: 'الاقتصاد والمستويات', activePage: 'economy' }) %>

<% const E = settings?.economy || {}; const L = settings?.leveling || {}; const GID = guild.id; const cur = E.currencySymbol || '👑';
  const totalBal = (economy || []).reduce((s, u) => s + (u.balance || 0), 0);
  const top = (economy || []).slice(0, 12);
%>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--amber),var(--green));display:grid;place-items:center;font-size:26px;"><i class="bi bi-coin"></i></div>
  <div>
    <div class="h-title">الاقتصاد والمستويات
      <span class="chip <%= E.enabled ? 'green' : '' %>">اقتصاد: <%= E.enabled ? 'ON' : 'OFF' %></span>
      <span class="chip <%= L.enabled ? 'green' : '' %>">مستويات: <%= L.enabled ? 'ON' : 'OFF' %></span>
    </div>
    <div class="h-desc">الرصيد · البنك · المتجر · مقامرة · مكافأت الرولات بالمستويات</div>
    <div class="h-chips">
      <span class="chip amber"><i class="bi bi-piggy-bank"></i> إجمالي التداول: <span class="num"><%= totalBal.toLocaleString('en-US') %></span> <%= cur %></span>
      <span class="chip blue"><%= (economy || []).length %> محفظة مسجلة</span>
    </div>
  </div>
</div>

<div class="tabs" data-group="ec">
  <button class="tab active" data-target="pane-lb"><i class="bi bi-trophy"></i> لوحة الصدارة</button>
  <button class="tab" data-target="pane-eco"><i class="bi bi-sliders"></i> إعدادات الاقتصاد</button>
  <button class="tab" data-target="pane-lvl"><i class="bi bi-graph-up-arrow"></i> المستويات</button>
</div>

<div>
<!-- ════ الرصيد ════ -->
<div class="tabpane active" data-group="ec" id="pane-lb">
  <div class="card">
    <div class="card-head">
      <h3><i class="bi bi-trophy"></i> أغنى أعضاء السيرفر</h3>
      <div class="head-side">
        <button class="btn sm" onclick="resetAll()"><i class="bi bi-arrow-counterclockwise"></i> تصفير الكل</button>
        <button class="btn sm primary" onclick="giveModal()"><i class="bi bi-plus-circle"></i> منح رصيد</button>
      </div>
    </div>
    <div class="card-body tight">
      <% if (!top.length) { %><div class="empty"><i class="bi bi-wallet2"></i><h4>لا محافظ بعد</h4><p>أول من يستخدم أمر الرصيد يظهر هنا فوراً</p></div><% } %>
      <% top.forEach((u, i) => { %>
      <div class="feat">
        <div class="f-ico" style="border-radius:50%;background:var(--panel-2);border:1px solid var(--line);font-weight:900;color:var(--text-2);"><%= i + 1 %></div>
        <div class="avatar-wrap">
          <% if (u.avatar) { %><img src="https://cdn.discordapp.com/avatars/<%= u.userId %>/<%= u.avatar %>.png?size=64" style="width:40px;height:40px;border-radius:50%;">
          <% } else { %><div class="m-letter" style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--cyan));display:grid;place-items:center;font-weight:900;">؟</div><% } %>
        </div>
        <div class="f-info">
          <div class="f-name"><%= u.username || u.userId %></div>
          <div class="f-desc">مستوى <span class="num"><%= u.level || 0 %></span> · <span class="num"><%= (u.totalXp || u.xp || 0).toLocaleString('en-US') %></span> XP</div>
        </div>
        <div class="chip amber num"><i class="bi bi-piggy-bank"></i> <%= (u.balance || 0).toLocaleString('en-US') %> <%= cur %></div>
        <button class="btn sm" onclick="giveModal('<%= u.userId %>', '<%= u.username || u.userId %>')"><i class="bi bi-plus-lg"></i></button>
      </div>
      <% }) %>
    </div>
  </div>
</div>

<!-- ════ إعدادات ════ -->
<div class="tabpane" data-group="ec" id="pane-eco">
  <div class="card mb-3">
    <div class="card-head">
      <h3><i class="bi bi-sliders2"></i> نظام الاقتصاد</h3>
      <div class="head-side">
        <span class="chip <%= E.enabled ? 'green' : '' %>"><%= E.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="economy.enabled" <%= E.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="form-row-3">
        <div class="field"><label>رمز العملة</label><input class="inp" data-text="economy.currencySymbol" value="<%= E.currencySymbol || '👑' %>" maxlength="4"></div>
        <div class="field"><label>اسم العملة</label><input class="inp" data-text="economy.currency" value="<%= E.currency || 'ملكة' %>" maxlength="10"></div>
        <div class="field"><label>مكافأة اليومي</label><input type="number" class="inp num" data-num="economy.dailyAmount" value="<%= E.dailyAmount ?? 500 %>" min="0" max="100000"></div>
      </div>
      <div class="form-row-3 mt-3">
        <div class="field"><label>العمل — الحد الأدنى</label><input type="number" class="inp num" data-field="economy.workAmount.min" value="<%= E.workAmount?.min ?? 100 %>" min="0" max="50000"></div>
        <div class="field"><label>العمل — الحد الأقصى</label><input type="number" class="inp num" data-field="economy.workAmount.max" value="<%= E.workAmount?.max ?? 500 %>" min="0" max="50000"></div>
        <div class="field"><label>البقاشي — الحد الأقصى</label><input type="number" class="inp num" data-field="economy.begAmount.max" value="<%= E.begAmount?.max ?? 100 %>" min="0" max="10000"></div>
      </div>
      <div class="form-row-3 mt-3">
        <div class="field"><label>مكافأة أسبوعي</label><input type="number" class="inp num" data-num="economy.weeklyAmount" value="<%= E.weeklyAmount ?? 2500 %>" min="0"></div>
        <div class="field"><label>مكافأة شهري</label><input type="number" class="inp num" data-num="economy.monthlyAmount" value="<%= E.monthlyAmount ?? 10000 %>" min="0"></div>
        <div class="field"><label>مكافأة الدقيقة صوتي</label><input type="number" class="inp num" data-num="economy.voiceRewardPerMinute" value="<%= E.voiceRewardPerMinute ?? 2 %>"></div>
      </div>
      <div class="sec-title"><i class="bi bi-cast"></i> أنشطة وقيود</div>
      <div class="grid-3">
        <% [['robEnabled', 'السرقة بين الأعضاء', E.robEnabled], ['slotsEnabled', 'سبتيد الألعاب', E.slotsEnabled], ['blackjackEnabled', 'بلاك جاك', E.blackjackEnabled], ['coinflipEnabled', 'عملة تقستي', E.coinflipEnabled], ['diceEnabled', 'النرد', E.diceEnabled], ['inventoryEnabled', 'الحقائب', E.inventoryEnabled], ['transferEnabled', 'التحويل بين الأعضاء', E.transferEnabled], ['leaderboardEnabled', 'لوحة الصدارة', E.leaderboardEnabled], ['voiceRewardsEnabled', 'مكافأة الصوتيات', E.voiceRewardsEnabled]].forEach(x => { %>
        <label class="field-check"><input type="checkbox" data-toggle="economy.<%= x[0] %>" <%= x[2] ? 'checked' : '' %>><span><%= x[1] %></span></label>
        <% }) %>
      </div>
      <div class="form-row-3 mt-3">
        <div class="field"><label>ضريبة التحويل %</label><input type="number" class="inp num" data-num="economy.transferTax" value="<%= E.transferTax ?? 5 %>" min="0" max="50"></div>
        <div class="field"><label>فترة الانتظار للتحويل (دقائق)</label><input type="number" class="inp num" data-num="economy.transferCooldown" value="<%= Math.round((E.transferCooldown ?? 0) / 60000) %>" min="0" max="1440"></div>
        <div class="field"><label>رول DJ للموسيقى</label><select class="inp role-sel" data-text="music.djRoleId" data-value="<%= settings?.music?.djRoleId || '' %>"></select></div>
      </div>
    </div>
  </div>
</div>

<!-- ════ المستويات ════ -->
<div class="tabpane" data-group="ec" id="pane-lvl">
  <div class="card mb-3">
    <div class="card-head">
      <h3><i class="bi bi-graph-up-arrow"></i> نظام المستويات</h3>
      <div class="head-side">
        <span class="chip <%= L.enabled ? 'green' : '' %>"><%= L.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="leveling.enabled" <%= L.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="form-row-3">
        <div class="field"><label>XP بكل رسالة</label><input type="number" class="inp num" data-num="leveling.xpPerMessage" value="<%= L.xpPerMessage ?? 15 %>" min="1" max="200"></div>
        <div class="field"><label>فترة الانتظار (ثواني)</label><input type="number" class="inp num" data-num="leveling.xpCooldown" value="<%= Math.round((L.xpCooldown ?? 60000) / 1000) %>" min="0" max="600"></div>
        <div class="field"><label>XP بالدقيقة صوتي</label><input type="number" class="inp num" data-num="leveling.voiceXpPerMinute" value="<%= L.voiceXpPerMinute ?? 5 %>"></div>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>قناة إعلانات الترقية <span class="hint">فارغ = روم الرسالة</span></label>
          <select class="inp chan-sel" data-text="leveling.levelUpChannelId" data-types="0,5" data-value="<%= L.levelUpChannelId || '' %>"></select>
        </div>
        <div class="field"><label>أسلوب رسالة الترقية</label>
          <select class="inp" data-text="leveling.levelUpStyle">
            <% [['embed', 'إمبد أنيق'], ['text', 'نص بسيط']].forEach(o => { %><option value="<%= o[0] %>" <%= (L.levelUpStyle || 'embed') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="field mt-3"><label>رسالة الترقية <span class="hint">المتغيرات: {user} {level} {server}</span></label>
        <textarea class="inp" style="min-height:70px;" data-text="leveling.levelUpMessage"><%= L.levelUpMessage || '🎉 مبروك {user} — وصلت للفيد {level}!' %></textarea>
      </div>

      <div class="sec-title"><i class="bi bi-person-badge"></i> رولات المستويات — أضف/عدّل</div>
      <div class="mb-3">
        <div class="flex" style="gap:8px;">
          <input type="number" id="lr_level" class="inp" style="max-width:130px;" placeholder="المستوي">
          <select id="lr_role" class="inp role-sel" style="max-width:260px;"></select>
          <button class="btn primary" onclick="addLevelRole()"><i class="bi bi-plus-lg"></i> إضافة</button>
        </div>
      </div>
      <div id="lrList">
        <% const lr = L.levelRoles || L.levelRewards || []; %>
        <% if (!(lr instanceof Array && lr.length)) { %>
        <% if (typeof lr === 'object' && Object.keys(lr).length) { %>
          <% Object.entries(lr).forEach(([lv, rl]) => { %><div class="feat"><div class="f-ico" style="background:var(--green-soft);color:var(--green);"><i class="bi bi-award"></i></div><div class="f-info"><div class="f-name">المستوي <span class="num"><%= lv %></span></div><div class="f-desc">رول: <code class="code-cell"><%= rl %></code></div></div><button class="btn sm danger" onclick="delLevelRole('<%= lv %>')"><i class="bi bi-trash"></i></button></div><% }) %>
        <% } else { %><div class="empty" style="padding:20px;"><i class="bi bi-award"></i><h4>لا رولات مستويات</h4><p>أضف أعلاه: مستوى x يحصل عضوه على رول</p></div><% } %>
        <% } else { lr.forEach(r => { %><div class="feat"><div class="f-ico" style="background:var(--green-soft);color:var(--green);"><i class="bi bi-award"></i></div><div class="f-info"><div class="f-name">المستوي <span class="num"><%= r.level %></span></div><div class="f-desc">رول: <code class="code-cell"><%= r.roleId %></code></div></div></div><% }) } %>
      </div>

      <div class="sec-title"><i class="bi bi-list-stars"></i> القنوات و الرولات المستثناة</div>
      <div class="form-row">
        <div class="field"><label>قنوات لا تُعطى فيها XP</label><input class="inp" data-array="leveling.ignoredChannels" value="<%= (L.ignoredChannels || []).join(',') %>" placeholder="ID, ID"></div>
        <div class="field"><label>رولات لا تُعطى XP</label><input class="inp" data-array="leveling.ignoredRoles" value="<%= (L.ignoredRoles || []).join(',') %>"></div>
      </div>
    </div>
  </div>
</div>
</div>

<script>
  const GID = '<%= GID %>';
  document.addEventListener('DOMContentLoaded', async () => {
    await LC.loadChannels(GID, $$('.chan-sel'));
    await LC.loadRoles(GID, $$('.role-sel'));
    $$('.inp[data-array]').forEach(el => el.addEventListener('change', async () => {
      const path = el.dataset.array.split('.');
      const arr = el.value.split(',').map(s => s.trim()).filter(Boolean);
      const payload = {}; let node = payload;
      path.slice(0, -1).forEach(k => { node[k] = node[k] || {}; node = node[k]; });
      node[path[path.length - 1]] = arr;
      await LC.saveSetting(GID, payload, null);
    }));
    // nested numeric save (workAmount.min etc.)
    $$('.inp[data-field]').forEach(el => el.addEventListener('change', async () => {
      const path = el.dataset.field.split('.');
      const payload = {}; let node = payload;
      path.slice(0, -1).forEach(k => { node[k] = node[k] || {}; node = node[k]; });
      node[path[path.length - 1]] = Number(el.value || 0);
      await LC.saveSetting(GID, payload, null);
    }));
  });

  function giveModal(userId = '', name = '') {
    LC.modal({
      title: 'منح رصيد',
      body: `
        <div class="field mb-3"><label>العضو</label><input id="gv_user" class="inp" placeholder="User ID" value="${userId}" ${userId ? 'readonly' : ''}></div>
        <div class="field"><label>الكمية</label><input id="gv_amt" type="number" class="inp" value="500" min="1"></div>
        ${name ? `<div class="text-dim" style="font-size:11.5px;">سيُمنح لـ${LC.esc(name)}</div>` : ''}`,
      actions: [
        { label: 'منح', cls: 'green', icon: 'plus-circle', onclick: async () => {
          const u = document.getElementById('gv_user').value.trim();
          const a = Number(document.getElementById('gv_amt').value);
          if (!u || !a) { LC.toast('أكمل البيانات', 'warn'); throw new Error('skip'); }
          await LC.api(`/api/guilds/${GID}/economy/give`, { method: 'POST', body: { userId: u, amount: a } });
          LC.toast('تم المنح ✅'); setTimeout(() => location.reload(), 700);
        }},
        { label: 'إلغاء', cls: 'ghost' },
      ],
    });
  }
  async function resetAll() {
    if (!await LC.confirmBox('تصفير الاقتصاد', 'سيتم تصفير رصيد وبنك كل الأعضاء إلى 0 — إجراء خطير!', {})) return;
    await LC.api(`/api/guilds/${GID}/economy/reset`, { method: 'POST', body: {} });
    LC.toast('تم تصفير الكل'); setTimeout(() => location.reload(), 700);
  }
  async function addLevelRole() {
    const lv = Number(document.getElementById('lr_level').value);
    const rl = document.getElementById('lr_role').value;
    if (!lv || !rl) return LC.toast('اختر مستوى ورول', 'warn');
    const cur = ( <%= JSON.stringify(Object.fromEntries((L.levelRoles instanceof Map) ? [...L.levelRoles.entries()] : Object.entries(L.levelRoles || {}))) %> );
    cur[String(lv)] = rl;
    if (await LC.saveSetting(GID, { '_direct:leveling.levelRoles': cur })) setTimeout(() => location.reload(), 700);
  }
  async function delLevelRole(lv) {
    const cur = ( <%= JSON.stringify(Object.fromEntries((L.levelRoles instanceof Map) ? [...L.levelRoles.entries()] : Object.entries(L.levelRoles || {}))) %> );
    delete cur[String(lv)];
    if (await LC.saveSetting(GID, { '_direct:leveling.levelRoles': cur })) setTimeout(() => location.reload(), 700);
  }
</script>

<%- include('layout-bottom') %>
