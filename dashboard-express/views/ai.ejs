<%- include('layout-top', { title: 'الذكاء الاصطناعي', activePage: 'ai' }) %>

<% const P = settings?.protection || {}; const A = settings?.ai || {}; const GID = guild.id; %>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--primary),var(--cyan));display:grid;place-items:center;font-size:26px;"><i class="bi bi-stars"></i></div>
  <div>
    <div class="h-title">الذكاء الاصطناعي
      <span class="chip <%= A.enabled || P.aiAutoMod?.enabled ? 'green' : '' %>"><%= A.enabled || P.aiAutoMod?.enabled ? 'نشط' : 'معطّل' %></span>
    </div>
    <div class="h-desc">الردود الذكية، منع المحتوى الضار تلقائياً، مردّد التذاكر والمترجم الفوري — عقل للسيرفر</div>
    <div class="h-chips">
      <span class="chip purple"><i class="bi bi-cpu"></i> <%= A.model || 'موديل افتراضي' %></span>
      <% if (A.enabled) { %><span class="chip green"><i class="bi bi-chat-dots"></i> الردود مفعّلة</span><% } else { %><span class="chip"><i class="bi bi-chat"></i> الردود معطّلة</span><% } %>
    </div>
  </div>
</div>

<% if (!settings?.ai || !A.enabled) { %>
<div class="banner warn"><i class="bi bi-plug"></i> نظام الردود الذكية غير مفعّل — فعّل "الردود العامة" أدناه، وسيستخدم البوت مفاتيح Groq من ملفاته (مفتاح Groq مجاني). الحماية بالذكاء الاصطناعي مستقلة عنه.</div>
<% } %>

<div class="grid-2 mb-4">
  <!-- الردود العامة -->
  <div class="card">
    <div class="card-head">
      <h3><i class="bi bi-chat-dots"></i> الردود العامة</h3>
      <div class="head-side">
        <span class="chip <%= A.enabled ? 'green' : '' %>"><%= A.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="ai.enabled" <%= A.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="form-row">
        <div class="field">
          <label>المزوّد</label>
          <select class="inp" data-text="ai.provider">
            <% [['openai', 'OpenAI (GPT)'], ['anthropic', 'Anthropic (Claude)'], ['both', 'تحكيم بالاثنين']].forEach(o => { %><option value="<%= o[0] %>" <%= A.provider === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
        </div>
        <div class="field">
          <label>لغة الرد</label>
          <select class="inp" data-text="ai.responseLanguage">
            <% [['ar', 'العربية'], ['en', 'English'], ['auto', 'تلقائي (لغة السؤال)']].forEach(o => { %><option value="<%= o[0] %>" <%= A.responseLanguage === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="form-row-3 mt-3">
        <div class="field"><label>درجة الإبداع (Temperature)</label>
          <input type="range" class="range" min="0" max="10" value="<%= Math.round((A.temperature ?? 0.7) * 10) %>" oninput="this.nextElementSibling.textContent=(this.value/10).toFixed(1)" onchange="LC.saveSetting('<%= GID %>', { ai: { temperature: this.value/10 } })">
          <span class="chip cyan num"><%= (A.temperature ?? 0.7).toFixed(1) %></span>
        </div>
        <div class="field"><label>أقصى طول الرد (توكنز)</label><input type="number" class="inp num" data-num="ai.maxTokens" value="<%= A.maxTokens || 800 %>" min="100" max="4000"></div>
        <div class="field"><label>الانتظار بين الردود (ثواني)</label><input type="number" class="inp num" data-num="ai.cooldown" value="<%= Math.round((A.cooldown || 3)) %>" min="0" max="600"></div>
      </div>
      <div class="field mt-3">
        <label>شخصية البوت (System Prompt) <span class="hint">تحدد سلوك رده</span></label>
        <textarea class="inp" data-text="ai.systemPrompt" placeholder="أنت مساعد ذكي ودود في سيرفر Liberty City..."><%= A.systemPrompt || '' %></textarea>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>قنوات مسموحة <span class="hint">فارغ = الكل</span></label><input class="inp" data-array="ai.allowedChannels" value="<%= (A.allowedChannels || []).join(',') %>" placeholder="ID, ID"></div>
        <div class="field"><label>رولات مسموحة <span class="hint">فارغ = الكل</span></label><input class="inp" data-array="ai.allowedRoles" value="<%= (A.allowedRoles || []).join(',') %>" placeholder="ID, ID"></div>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>قنوات مستثناة</label><input class="inp" data-array="ai.ignoredChannels" value="<%= (A.ignoredChannels || []).join(',') %>" placeholder="ID, ID"></div>
        <div class="field"><label>رولات مستثناة</label><input class="inp" data-array="ai.ignoredRoles" value="<%= (A.ignoredRoles || []).join(',') %>" placeholder="ID, ID"></div>
      </div>
    </div>
  </div>

  <!-- مودريتور AI -->
  <div class="card">
    <div class="card-head">
      <h3><i class="bi bi-shield-exclamation"></i> رقيب المحتوى (AI AutoMod)</h3>
      <div class="head-side">
        <span class="chip <%= P.aiAutoMod?.enabled ? 'green' : '' %>"><%= P.aiAutoMod?.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="protection.aiAutoMod.enabled" <%= P.aiAutoMod?.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="field mb-3">
        <label>الحساسية <span class="hint">أعلى = تدقيق أكثر</span></label>
        <input type="range" class="range" min="1" max="10" value="<%= P.aiAutoMod?.sensitivity || 7 %>" oninput="this.nextElementSibling.textContent=this.value" onchange="LC.saveSetting('<%= GID %>', { protection: { aiAutoMod: { sensitivity: Number(this.value) } } })">
        <span class="chip cyan num"><%= P.aiAutoMod?.sensitivity || 7 %></span>
      </div>
      <div class="sec-title"><i class="bi bi-list-check"></i> التصنيفات — تفعيل + إجراء لكل نوع</div>
      <div id="aiModGrid" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;">
        <% const CAT = [['spam', 'سبام'], ['toxicity', 'إساءة'], ['nsfw', 'إباحي'], ['scam', 'احتيال'], ['threat', 'تهديد'], ['pii', 'بيانات شخصية'], ['raid', 'رايد لغوي'], ['selfharm', 'إيذاء الذات']];
           const ACTS = [['delete', 'حذف'], ['warn', 'تحذير'], ['mute', 'كتم'], ['ban', 'حظر'], ['resources', 'موارد مساعدة']];
           const cs = P.aiAutoMod?.categories || {}; const acts = P.aiAutoMod?.actions || {}; %>
        <% CAT.forEach(([id, lb]) => { const on = cs[id] !== false; %>
        <div style="display:flex;align-items:center;gap:6px;border:1px solid var(--line);border-radius:10px;padding:6px 10px;">
          <label style="display:flex;align-items:center;gap:7px;cursor:pointer;flex:1;">
            <input type="checkbox" data-toggle="protection.aiAutoMod.categories.<%= id %>" <%= on ? 'checked' : '' %> style="width:16px;height:16px;accent-color:var(--primary);">
            <span style="font-size:12px;font-weight:700;"><%= lb %></span>
          </label>
          <select style="background:var(--bg-soft);border:1px solid var(--line);color:var(--text-2);border-radius:8px;padding:3px 8px;font-family:inherit;font-size:11px;font-weight:700;cursor:pointer;" data-cat-act="<%= id %>">
            <% const selfharmOpts = id === 'selfharm' ? ACTS : ACTS.filter(a => a[0] !== 'resources'); %>
            <% selfharmOpts.forEach(a => { %><option value="<%= a[0] %>" <%= (acts[id] || (id === 'spam' ? 'delete' : 'mute')) === a[0] ? 'selected' : '' %>><%= a[1] %></option><% }) %>
          </select>
        </div>
        <% }) %>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>مدة الكتم الافتراضية للربيب (ثواني)</label><input type="number" class="inp num" data-num="protection.aiAutoMod.muteDuration" value="<%= P.aiAutoMod?.muteDuration || 600 %>" min="60"></div>
        <div class="field"><label>قناة سجلات الرقيب</label><select class="inp chan-sel" data-text="protection.aiAutoMod.logChannel" data-types="0,5" data-value="<%= P.aiAutoMod?.logChannel || '' %>"></select></div>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>قنوات مستثناة</label><input class="inp" data-array="protection.aiAutoMod.ignoredChannels" value="<%= (P.aiAutoMod?.ignoredChannels || []).join(',') %>" placeholder="ID, ID"></div>
        <div class="field"><label>رولات مستثناة</label><input class="inp" data-array="protection.aiAutoMod.ignoredRoles" value="<%= (P.aiAutoMod?.ignoredRoles || []).join(',') %>"></div>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>قناة سجلات الرقيب</label><select class="inp chan-sel" data-text="protection.aiAutoMod.logChannel" data-types="0,5" data-value="<%= P.aiAutoMod?.logChannel || '' %>"></select></div>
        <div class="field">
          <label>تصعيد التكرارات (Escalation)</label>
          <label class="field-check"><input type="checkbox" data-toggle="protection.aiAutoMod.escalation" <%= P.aiAutoMod?.escalation ? 'checked' : '' %>><span>فعّل التصعيد بعد تحذيرات متكررة</span></label>
        </div>
      </div>
      <div class="field"><label>عدد داخل التصعيد (تحذيرات)</label><input type="number" class="inp num" data-num="protection.aiAutoMod.maxWarningsBeforeEscalation" value="<%= P.aiAutoMod?.maxWarningsBeforeEscalation || 3 %>" min="1" max="20"></div>
    </div>
  </div>
</div>

<div class="grid-2">
  <!-- مساعد التذاكر -->
  <div class="card">
    <div class="card-head">
      <h3><i class="bi bi-ticket-detailed"></i> مساعد التذاكر (AI)</h3>
      <div class="head-side">
        <span class="chip <%= P.aiTicketAssistant?.enabled ? 'green' : '' %>"><%= P.aiTicketAssistant?.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="protection.aiTicketAssistant.enabled" <%= P.aiTicketAssistant?.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="grid-2" style="gap:8px;">
        <label class="field-check"><input type="checkbox" data-toggle="protection.aiTicketAssistant.autoClaim" <%= P.aiTicketAssistant?.autoClaim ? 'checked' : '' %>><span>استلام تلقائي للتذاكر</span></label>
        <label class="field-check"><input type="checkbox" data-toggle="protection.aiTicketAssistant.analyzeOnCreate" <%= P.aiTicketAssistant?.analyzeOnCreate ? 'checked' : '' %>><span>تحليل عند الإنشاء</span></label>
        <label class="field-check"><input type="checkbox" data-toggle="protection.aiTicketAssistant.requireAdminApprovalForRoles" <%= P.aiTicketAssistant?.requireAdminApprovalForRoles ? 'checked' : '' %>><span>إذن إداري لتغيير الرولات</span></label>
        <label class="field-check"><input type="checkbox" data-toggle="protection.aiTicketAssistant.requireAdminApprovalForBans" <%= P.aiTicketAssistant?.requireAdminApprovalForBans ? 'checked' : '' %>><span>إذن إداري للحظر</span></label>
        <label class="field-check"><input type="checkbox" data-toggle="protection.aiTicketAssistant.requireAdminApprovalForPermissions" <%= P.aiTicketAssistant?.requireAdminApprovalForPermissions ? 'checked' : '' %>><span>إذن إداري لتغيير الصلاحيات</span></label>
        <label class="field-check"><input type="checkbox" data-toggle="protection.aiTicketAssistant.notifyAdminsOnFailure" <%= P.aiTicketAssistant?.notifyAdminsOnFailure ? 'checked' : '' %>><span>تنبيه الإدارة عند فشله</span></label>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>حد الثقة (%)</label>
          <input class="inp num" type="number" min="50" max="100" id="aiConf" value="<%= Math.round(((P.aiTicketAssistant?.confidenceThreshold ?? 0.8) <= 1 ? P.aiTicketAssistant?.confidenceThreshold ?? 0.8 : 0.8) * 100) %>">
          <div class="text-dim" style="font-size:10.5px;">يستلم تلقائياً فقط إذا وثقته فوق هذا الحد</div>
        </div>
        <div class="field"><label>أقصى إجراءات لكل تذكرة</label><input type="number" class="inp num" data-num="protection.aiTicketAssistant.maxAutoActionsPerTicket" value="<%= P.aiTicketAssistant?.maxAutoActionsPerTicket || 3 %>" min="1" max="10"></div>
      </div>
      <div class="field mt-3"><label>قناة سجلات المساعد</label><select class="inp chan-sel" data-text="protection.aiTicketAssistant.logChannel" data-types="0,5" data-value="<%= P.aiTicketAssistant?.logChannel || '' %>"></select></div>
    </div>
  </div>

  <!-- المترجم -->
  <div class="card">
    <div class="card-head">
      <h3><i class="bi bi-translate"></i> المترجم الفوري (AI Translator)</h3>
      <div class="head-side">
        <span class="chip <%= P.aiTranslator?.enabled ? 'green' : '' %>"><%= P.aiTranslator?.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="protection.aiTranslator.enabled" <%= P.aiTranslator?.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="form-row">
        <div class="field">
          <label>لغة الترجمة الافتراضية</label>
          <select class="inp" data-text="protection.aiTranslator.defaultTargetLang">
            <% [['ar', 'العربية'], ['en', 'English'], ['fr', 'الفرنسية']].forEach(o => { %><option value="<%= o[0] %>" <%= (P.aiTranslator?.defaultTargetLang || 'ar') === o[0] ? 'selected' : '' %>><%= o[1] %></option><% }) %>
          </select>
        </div>
        <div class="field"><label>أقصى طول للترجمة</label><input type="number" class="inp num" data-num="protection.aiTranslator.maxLength" value="<%= P.aiTranslator?.maxLength || 1000 %>" min="100"></div>
      </div>
      <div class="label mt-3" style="font-size:12px;font-weight:800;color:var(--text-2);">قنوات الترجمة التلقائية <span class="hint" style="font-weight:600;color:var(--text-3);">فارغ = متوقف الترجمات التلقائية</span></label>
      <input class="inp" data-array="protection.aiTranslator.autoTranslateChannels" value="<%= (P.aiTranslator?.autoTranslateChannels || []).join(',') %>" placeholder="ID, ID">
      <div class="form-row mt-3">
        <div class="field"><label>قنوات مستثناة</label><input class="inp" data-array="protection.aiTranslator.ignoredChannels" value="<%= (P.aiTranslator?.ignoredChannels || []).join(',') %>"></div>
        <div class="field"><label>رولات مستثناة</label><input class="inp" data-array="protection.aiTranslator.ignoredRoles" value="<%= (P.aiTranslator?.ignoredRoles || []).join(',') %>"></div>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>قناة سجلات المترجم</label><select class="inp chan-sel" data-text="protection.aiTranslator.logChannel" data-types="0,5" data-value="<%= P.aiTranslator?.logChannel || '' %>"></select></div>
        <div class="field">
          <label>إظهار النص الأصلي أسفل الترجمة</label>
          <label class="field-check"><input type="checkbox" data-toggle="protection.aiTranslator.showOriginal" <%= P.aiTranslator?.showOriginal ? 'checked' : '' %>><span>فعّل</span></label>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const GID = '<%= GID %>';
  document.addEventListener('DOMContentLoaded', async () => {
    await LC.loadChannels(GID, $$('.chan-sel'));
    // arrays with live endpoints fall back to plain comma inputs — auto-PATCH on change
    $$('.inp[data-array]').forEach(el => {
      el.addEventListener('change', async () => {
        const path = el.dataset.array.split('.');
        const arr = el.value.split(',').map(s => s.trim()).filter(Boolean);
        const payload = {}; let node = payload;
        path.slice(0, -1).forEach(k => { node[k] = node[k] || {}; node = node[k]; });
        node[path[path.length - 1]] = arr;
        await LC.saveSetting(GID, payload, null);
      });
    });
    // per-category action selects
    $$('select[data-cat-act]').forEach(sel => {
      sel.addEventListener('change', async () => {
        const cat = sel.dataset.catAct;
        await LC.saveSetting(GID, { protection: { aiAutoMod: { actions: { [cat]: sel.value } } } });
      });
    });
    // confidence slider (0..1 semantics)
    const conf = document.getElementById('aiConf');
    conf?.addEventListener('change', async () => {
      const pct = Math.min(100, Math.max(50, Number(conf.value || 80)));
      await LC.saveSetting(GID, { protection: { aiTicketAssistant: { confidenceThreshold: pct / 100 } } });
    });
  });
</script>

<%- include('layout-bottom') %>
