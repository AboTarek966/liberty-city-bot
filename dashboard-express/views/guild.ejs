<%- include('layout-top', { title: 'نظرة عامة', activePage: 'guild' }) %>

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
  <div>
    <h1><i class="bi bi-grid-1x2"></i> <%= guild.name %></h1>
    <p>نظرة عامة على السيرفر والبوت — آخر تحديث الآن</p>
  </div>
  <div class="btn-group">
    <a href="/dashboard/<%= guild.id %>/settings" class="btn btn-outline-secondary"><i class="bi bi-gear"></i> الإعدادات</a>
    <button class="btn btn-primary" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i> تحديث</button>
  </div>
</div>

<!-- Stats -->
<div class="grid-4 mb-4">
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--info-bg);color:var(--info);"><i class="bi bi-people"></i></div>
    <div class="stat-info">
      <div class="stat-label">الأعضاء</div>
      <div class="stat-value"><%= (stats?.memberCount || 0).toLocaleString('en-US') %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--success-bg);color:var(--success);"><i class="bi bi-hash"></i></div>
    <div class="stat-info">
      <div class="stat-label">القنوات</div>
      <div class="stat-value"><%= stats?.channelCount || 0 %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--purple-bg);color:var(--purple);"><i class="bi bi-person-badge"></i></div>
    <div class="stat-info">
      <div class="stat-label">الرولات</div>
      <div class="stat-value"><%= stats?.roleCount || 0 %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--warning-bg);color:var(--warning);"><i class="bi bi-ticket-perforated"></i></div>
    <div class="stat-info">
      <div class="stat-label">تذاكر مفتوحة</div>
      <div class="stat-value"><%= Array.isArray(tickets) ? tickets.filter(t => t.status === 'open').length : 0 %></div>
    </div>
  </div>
</div>

<!-- Quick actions -->
<div class="grid-3 mb-4">
  <a href="/dashboard/<%= guild.id %>/protection" class="guild-card text-decoration-none">
    <div class="cat-icon" style="background:var(--danger-bg);color:var(--danger);"><i class="bi bi-shield-check" style="font-size:20px;"></i></div>
    <div class="guild-title">الحماية</div>
    <div class="guild-meta">Anti-Raid، Anti-Spam، فلتر الروابط، حماية الرولات والقنوات</div>
    <span class="badge <%= settings?.protection?.antiRaid?.enabled || settings?.protection?.antiSpam?.enabled ? 'bg-success' : 'bg-secondary' %>">
      <%= settings?.protection?.antiRaid?.enabled || settings?.protection?.antiSpam?.enabled ? 'مفعّلة' : 'معطّلة' %>
    </span>
  </a>
  <a href="/dashboard/<%= guild.id %>/ai" class="guild-card text-decoration-none">
    <div class="cat-icon" style="background:var(--purple-bg);color:var(--purple);"><i class="bi bi-robot" style="font-size:20px;"></i></div>
    <div class="guild-title">الذكاء الاصطناعي</div>
    <div class="guild-meta">أوتومود بالـ AI، مساعد التذاكر، المترجم، الردود الذكية</div>
    <span class="badge <%= settings?.protection?.aiModerator?.enabled ? 'bg-success' : 'bg-secondary' %>">
      <%= settings?.protection?.aiModerator?.enabled ? 'مفعّل' : 'معطّل' %>
    </span>
  </a>
  <a href="/dashboard/<%= guild.id %>/welcome" class="guild-card text-decoration-none">
    <div class="cat-icon" style="background:var(--success-bg);color:var(--success);"><i class="bi bi-door-open" style="font-size:20px;"></i></div>
    <div class="guild-title">الترحيب</div>
    <div class="guild-meta">رسائل ترحيب ومغادرة مع بطاقة مرّسومة وDM</div>
    <span class="badge <%= settings?.welcome?.enabled ? 'bg-success' : 'bg-secondary' %>">
      <%= settings?.welcome?.enabled ? 'مفعّل' : 'معطّل' %>
    </span>
  </a>
</div>

<div class="row g-4">
  <!-- Status of systems -->
  <div class="col-12 col-lg-7">
    <div class="card h-100">
      <div class="card-header">
        <h5><i class="bi bi-list-check"></i> حالة الأنظمة</h5>
      </div>
      <div class="card-body p-0">
        <%
          const systems = [
            { name: 'نظام التذاكر', icon: 'ticket-perforated', on: settings?.tickets?.enabled !== false, page: 'tickets' },
            { name: 'الترحيب والمغادرة', icon: 'door-open', on: !!settings?.welcome?.enabled, page: 'welcome' },
            { name: 'المستويات والخبرة', icon: 'graph-up', on: settings?.leveling?.enabled !== false, page: 'settings' },
            { name: 'الاقتصاد', icon: 'coin', on: settings?.economy?.enabled !== false, page: 'economy' },
            { name: 'أوتومود', icon: 'shield', on: settings?.automod?.enabled !== false, page: 'settings' },
            { name: 'التوثيق', icon: 'patch-check', on: !!settings?.verification?.enabled, page: 'settings' },
            { name: 'السجلات', icon: 'journal-text', on: settings?.logging?.enabled !== false, page: 'logs' },
            { name: 'الرول التلقائي', icon: 'person-plus', on: !!settings?.autorole?.enabled, page: 'settings' },
          ];
        %>
        <% systems.forEach(s => { %>
        <div class="switch-card" style="border-radius:0;border-left:none;border-right:none;border-top:none;">
          <div class="switch-info d-flex align-items-center gap-3">
            <div class="cat-icon" style="background:<%= s.on ? 'var(--success-bg)' : 'rgba(90,101,133,0.12)' %>;color:<%= s.on ? 'var(--success)' : 'var(--text-muted)' %>;">
              <i class="bi bi-<%= s.icon %>"></i>
            </div>
            <div>
              <h6><%= s.name %></h6>
              <p><%= s.on ? 'مفعّل ويعمل' : 'معطّل' %></p>
            </div>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge <%= s.on ? 'bg-success' : 'bg-secondary' %>"><%= s.on ? '● يعمل' : '○ متوقف' %></span>
            <a href="/dashboard/<%= guild.id %>/<%= s.page %>" class="btn btn-outline-secondary btn-sm">إعدادات</a>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </div>

  <!-- Recent activity -->
  <div class="col-12 col-lg-5">
    <div class="card h-100">
      <div class="card-header">
        <h5><i class="bi bi-clock-history"></i> آخر الأنشطة</h5>
        <a href="/dashboard/<%= guild.id %>/logs" class="btn btn-outline-secondary btn-sm">الكل</a>
      </div>
      <div class="card-body p-0">
        <%
          const recentLogs = (logs && logs.logs) ? logs.logs.slice(0, 8) : (Array.isArray(logs) ? logs.slice(0, 8) : []);
        %>
        <% if (recentLogs.length === 0) { %>
          <div class="empty-state" style="padding:40px 20px;">
            <i class="bi bi-inbox"></i>
            <h5>لا توجد أنشطة</h5>
            <p>ستظهر هنا إجراءات الإشراف الأخيرة (تحذيرات، طرود، حظر...)</p>
          </div>
        <% } else { %>
          <% recentLogs.forEach(l => { %>
          <div class="switch-card" style="border-radius:0;border-left:none;border-right:none;border-top:none;">
            <div class="switch-info d-flex align-items-center gap-3">
              <div class="cat-icon" style="background:var(--info-bg);color:var(--info);">
                <i class="bi bi-<%= l.type === 'ban' ? 'x-circle' : l.type === 'kick' ? 'door-open' : l.type === 'warn' ? 'exclamation-triangle' : 'shield' %>"></i>
              </div>
              <div>
                <h6 style="font-size:13px;">
                  <%= l.type === 'ban' ? 'حظر' : l.type === 'kick' ? 'طرد' : l.type === 'warn' ? 'تحذير' : l.type %>
                </h6>
                <p style="font-size:11.5px;"><code><%= l.targetId %></code> — <%= l.reason || 'بدون سبب' %></p>
              </div>
            </div>
            <small class="text-muted"><%= l.createdAt ? new Date(l.createdAt).toLocaleDateString('ar-SA') : '' %></small>
          </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>
</div>

<%- include('layout-bottom') %>
