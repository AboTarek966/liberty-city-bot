<%- include('layout-top', { title: 'نظرة عامة', activePage: 'guild' }) %>

<% const live = stats?.source === 'bot'; %>
<div class="hero">
  <% if (guild.icon) { %>
    <img class="h-logo" src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=128" alt="">
  <% } else { %>
    <div class="h-logo" style="background:linear-gradient(135deg,var(--primary),var(--cyan));display:grid;place-items:center;font-size:24px;"><%= (guild.name||'?').charAt(0) %></div>
  <% } %>
  <div style="min-width:230px;">
    <div class="h-title">
      <%= guild.name %>
      <% if (live) { %><span class="chip green"><i class="bi bi-broadcast"></i> بيانات حية</span><% } %>
      <% if (guild.owner) { %><span class="chip green"><i class="bi bi-person-fill-gear"></i> مالك</span><% } %>
    </div>
    <div class="h-desc">
      <% if (stats?.ownerTag) { %>👑 <%= stats.ownerTag %> · <% } %>
      <code class="code-cell"><%= guild.id %></code>
      <% if (stats?.createdAt) { %> · تأسس <%= new Date(stats.createdAt).toLocaleDateString('ar-EG', { year: 'numeric', month: 'long' }) %><% } %>
    </div>
    <div class="h-chips">
      <span class="chip <%= live ? 'green' : 'amber' %>"><i class="bi bi-activity"></i> <%= live ? 'مباشر من البوت' : 'وضع احتياطي (قاعدة البيانات)' %></span>
      <% if (stats?.boostLevel > 0) { %><span class="chip pink"><i class="bi bi-rocket-takeoff"></i> <%= ['','مستوى 1','مستوى 2','مستوى 3'][stats.boostLevel] || stats.boostLevel %> · <%= stats.boosts %> بوست</span><% } %>
    </div>
  </div>
  <div class="h-actions btn-group">
    <a href="/dashboard/<%= guild.id %>/protection" class="btn"><i class="bi bi-shield-check"></i> الحماية</a>
    <a href="/dashboard/<%= guild.id %>/settings" class="btn"><i class="bi bi-sliders"></i> إعدادات</a>
  </div>
</div>

<% if (!live && (stats?.workerAlive === false)) { %>
<div class="banner warn"><i class="bi bi-plug"></i> البوت على FadeHost غير متصل الآن — سترى آخر قيم محفوظة. الأرقام الحية ستعود تلقائياً عند عودته.</div>
<% } %>

<div class="tiles">
  <div class="tile">
    <div class="t-ico" style="background:var(--blue-soft);color:var(--blue);"><i class="bi bi-people"></i></div>
    <div>
      <div class="t-label">إجمالي الأعضاء</div>
      <div class="t-value num"><%= stats?.memberCount != null ? stats.memberCount.toLocaleString('en-US') : '—' %></div>
      <div class="t-note"><% if (stats?.profilesCount != null) { %><%= stats.profilesCount %> ملف في القاعدة<% } %></div>
    </div>
  </div>
  <div class="tile">
    <div class="t-ico" style="background:var(--green-soft);color:var(--green);"><i class="bi bi-broadcast-pin"></i></div>
    <div>
      <div class="t-label">أعضاء متصلون</div>
      <div class="t-value num"><%= stats?.onlineCount != null ? stats.onlineCount.toLocaleString('en-US') : '—' %></div>
      <div class="t-note"><% if (stats?.botCount != null) { %><%= stats.botCount %> بوت<% } %></div>
    </div>
  </div>
  <div class="tile">
    <div class="t-ico" style="background:var(--primary-soft);color:var(--primary-2);"><i class="bi bi-collection-play"></i></div>
    <div>
      <div class="t-label">القنوات</div>
      <div class="t-value num"><%= stats?.channelCount != null ? stats.channelCount.toLocaleString('en-US') : '—' %></div>
      <div class="t-note"><% if (stats?.textChannelCount != null) { %>نصية <%= stats.textChannelCount %> · صوتية <%= stats.voiceChannelCount %><% } %></div>
    </div>
  </div>
  <div class="tile">
    <div class="t-ico" style="background:var(--amber-soft);color:var(--amber);"><i class="bi bi-person-badge"></i></div>
    <div>
      <div class="t-label">الرولات</div>
      <div class="t-value num"><%= stats?.roleCount != null ? stats.roleCount.toLocaleString('en-US') : '—' %></div>
      <div class="t-note">تظهر في صفحة الأعضاء للإدارة</div>
    </div>
  </div>
</div>

<div class="row-split mb-4">
  <div class="card">
    <div class="card-head"><h3><i class="bi bi-ui-checks"></i> تفعيلات الأنظمة — بمسة واحدة</h3>
      <div class="head-side"><span class="chip cyan">حفظ فوري</span></div>
    </div>
    <div class="card-body tight" id="systemsList">
      <%
        const feats = [
          { id: 'protection', icon: 'shield-fill-check', name: 'الحماية المتقدمة', desc: 'Anti-Raid · Spam · Links · Nuke', on: !!(settings?.protection?.antiRaid?.enabled || settings?.protection?.antiSpam?.enabled), key: 'protection.antiRaid.enabled', cur: !!settings?.protection?.antiRaid?.enabled, page: 'protection' },
          { id: 'welcome', icon: 'door-open', name: 'الترحيب والمغادرة', desc: 'رسائل + بطاقة + DM', on: !!settings?.welcome?.enabled, key: 'welcome.enabled', cur: !!settings?.welcome?.enabled, page: 'welcome' },
          { id: 'tickets', icon: 'lifebuoy', name: 'نظام التذاكر', desc: 'بانل + استلام + محفوظات', on: (settings?.tickets?.panels || []).length > 0 || !!settings?.tickets?.autoMessageEnabled, page: 'tickets' },
          { id: 'logging', icon: 'journal-text', name: 'السجلات', desc: 'توثيق كل الأحدث بلوق', on: !!settings?.logging?.enabled, key: 'logging.enabled', cur: !!settings?.logging?.enabled, page: 'logs' },
          { id: 'leveling', icon: 'graph-up-arrow', name: 'المستويات والخبرة', desc: 'XP per رسالة + مكافآت', on: !!settings?.leveling?.enabled, key: 'leveling.enabled', cur: !!settings?.leveling?.enabled, page: 'economy' },
          { id: 'economy', icon: 'coin', name: 'الاقتصاد', desc: 'رصيد · بنك · متجر · مقامرة', on: !!settings?.economy?.enabled, key: 'economy.enabled', cur: !!settings?.economy?.enabled, page: 'economy' },
          { id: 'verification', icon: 'patch-check', name: 'التوثيق', desc: 'زر توثيق للأعضاء', on: !!settings?.verification?.enabled, key: 'verification.enabled', cur: !!settings?.verification?.enabled, page: 'settings' },
          { id: 'autorole', icon: 'person-fill-add', name: 'رول تلقائي', desc: 'يُعطى عند الانضمام', on: !!settings?.autorole?.enabled, key: 'autorole.enabled', cur: !!settings?.autorole?.enabled, page: 'settings' },
        ];
      %>
      <% feats.forEach(f => { %>
      <div class="feat">
        <div class="f-ico" style="background:<%= f.on ? 'var(--green-soft)' : 'var(--panel-2)' %>;color:<%= f.on ? 'var(--green)' : 'var(--text-3)' %>;border:1px solid <%= f.on ? 'rgba(45,212,167,.2)' : 'var(--line)' %>;"><i class="bi bi-<%= f.icon %>"></i></div>
        <div class="f-info">
          <div class="f-name"><%= f.name %></div>
          <div class="f-desc"><%= f.desc %></div>
        </div>
        <div class="f-actions">
          <% if (f.key) { %>
          <label class="switch"><input type="checkbox" data-toggle="<%= f.key %>" <%= f.cur ? 'checked' : '' %>><span class="track"></span></label>
          <% } else { %><span class="chip <%= f.on ? 'green' : '' %>"><%= f.on ? 'مفعّل' : 'غير مضبوط' %></span><% } %>
          <a class="btn sm" href="/dashboard/<%= guild.id %>/<%= f.page %>"><i class="bi bi-gear"></i> تخصيص</a>
        </div>
      </div>
      <% }) %>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h3><i class="bi bi-clock-history"></i> آخر إجراءات الإشراف</h3>
      <div class="head-side"><a href="/dashboard/<%= guild.id %>/logs" class="btn sm">عرض الكل</a></div>
    </div>
    <div class="card-body tight">
      <% const typesMap = { ban: ['hammer', 'red'], kick: ['door-open', 'amber'], warn: ['exclamation-triangle', 'amber'], mute: ['mic-mute', 'blue'], unmute: ['mic', 'green'], timeout: ['hourglass-split', 'amber'], untimeout: ['arrow-counterclockwise', 'green'], softban: ['brush', 'amber'], note: ['sticky', 'cyan'], role_add: ['person-plus', 'green'], role_remove: ['person-dash', 'red'] }; %>
      <% const recentLogs = ((logs && logs.logs) ? logs.logs : []).slice(0, 7); %>
      <% if (!recentLogs.length) { %>
        <div class="empty"><i class="bi bi-inbox"></i><h4>لا إجراءات بعد</h4><p>تحذيرات وأطفال البوت ستظهر هنا فور تنفيذها من أي مكان.</p></div>
      <% } else { %>
        <% recentLogs.forEach(l => { const t = typesMap[l.type] || ['shield', 'cyan']; %>
        <div class="feat">
          <div class="f-ico" style="background:var(--<%= t[1] %>-soft);color:var(--<%= t[1] %>);"><i class="bi bi-<%= t[0] %>"></i></div>
          <div class="f-info">
            <div class="f-name">كيس #<%= l.caseId || '—' %> · <%= l.type %></div>
            <div class="f-desc"><%= (l.reason || 'بدون سبب').slice(0, 60) %></div>
          </div>
          <small class="text-dim" style="font-size:10.5px;"><%= l.createdAt ? new Date(l.createdAt).toLocaleDateString('ar-EG', { month: 'short', day: 'numeric' }) : '' %></small>
        </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-head"><h3><i class="bi bi-bolt"></i> إجراءات سريعة</h3></div>
  <div class="card-body">
    <div class="grid-3">
      <a class="btn w-100" href="/dashboard/<%= guild.id %>/members" style="flex-direction:column;padding:20px;gap:8px;"><i class="bi bi-people" style="font-size:22px;color:var(--blue);"></i> <span>إدارة الأعضاء</span><small class="text-dim">طرد · حظر · رولات · توقيت</small></a>
      <a class="btn w-100" href="/dashboard/<%= guild.id %>/tickets" style="flex-direction:column;padding:20px;gap:8px;"><i class="bi bi-lifebuoy" style="font-size:22px;color:var(--green);"></i> <span>لوحة التذاكر</span><small class="text-dim">فحص · ردود · إغلاق</small></a>
      <button class="btn w-100" onclick="unlockdown(this)" style="flex-direction:column;padding:20px;gap:8px;"><i class="bi bi-unlock" id="ldIcon" style="font-size:22px;color:<%= settings?.protection?.lockdown ? 'var(--red)' : 'var(--amber)' %>;"></i>
        <span>وضع الطوارئ (Lockdown)</span>
        <small class="text-dim">حالة: <b id="ldState"><%= settings?.protection?.lockdown ? 'مُفعّل — القنوات مقفلة!' : 'غير مفعّل' %></b></small>
      </button>
    </div>
  </div>
</div>

<script>
  const GID = '<%= guild.id %>';
  const LC2 = window.LC;
  async function unlockdown(btn) {
    const cur = '<%= settings?.protection?.lockdown ? '1' : '0' %>';
    const target = cur === '1';
    const yes = await LC2.confirmBox('وضع الطوارئ', target
      ? 'سيعاد فتح الكتابة والدخول في كل القنوات — تأكيد؟'
      : 'سيُقفل كتابة الدخول في جميع القنوات فوراً (وضع الطوارئ) — تأكيد؟', { danger: !target, okLabel: 'نعم، نفّذ' });
    if (!yes) return;
    const ok = await LC2.saveSetting(GID, { protection: { lockdown: !target } }, btn);
    if (ok) {
      document.getElementById('ldState').textContent = !target ? 'مُفعّل — القنوات مقفلة!' : 'غير مفعّل';
      document.getElementById('ldIcon').style.color = !target ? 'var(--red)' : 'var(--amber)';
      LC2.toast(!target ? 'وضع الطوارئ مُفعّل' : 'فُتح السيرفر — انتهى الطوارئ', !target ? 'warn' : 'success');
    }
  }
</script>

<%- include('layout-bottom') %>
