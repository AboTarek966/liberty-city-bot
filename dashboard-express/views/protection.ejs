      ['chan', 'logChannel', 'قناة السجلات', ''],
    ]},
    { id: 'antiAlt', icon: 'person-exclamation', grad: 'linear-gradient(135deg,#ff6ac1,#35d0f0)', name: 'Anti-Alt', desc: 'ضد الحسابات البديلة', fields: [
