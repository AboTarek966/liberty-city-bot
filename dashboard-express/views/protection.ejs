    ]},
    { id: 'antiMention', icon: 'at', grad: 'linear-gradient(135deg,#35d0f0,#2dd4a7)', name: 'Anti-Mention', desc: 'ضد المنشن-سبام', fields: [
      ['num', 'max', 'أقصى منشنات بالرسالة', 5, 1, 30],
      ['sel', 'action', 'الإجراء', [['delete', 'حذف'], ['warn', 'تحذير'], ['mute', 'كتم']], 'delete'],
