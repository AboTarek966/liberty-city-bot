<%- include('layout-top', { title: 'الحماية', activePage: 'protection' }) %>

<% const P = settings?.protection || {}; const GID = guild.id; %>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--red),var(--amber));display:grid;place-items:center;font-size:26px;"><i class="bi bi-shield-fill-check"></i></div>
  <div>
    <div class="h-title">الحماية المتقدمة
      <span class="chip <%= P.antiRaid?.enabled || P.antiSpam?.enabled ? 'green' : '' %>"><%= P.antiRaid?.enabled || P.antiSpam?.enabled ? 'أنظمة نشطة' : 'معطّلة' %></span>
    </div>
    <div class="h-desc">درع ضد الرايد والسبام واللنكات والاختراق — كل تعديل يُحفظ لحظياً في قاعدة البيانات</div>
    <div class="h-chips">
      <span class="chip <%= P.lockdown ? 'red' : 'cyan' %>"><i class="bi bi-<%= P.lockdown ? 'lock' : 'unlock' %>"></i> الطوارئ: <%= P.lockdown ? 'مقفل' : 'حر' %></span>
      <span class="chip purple"><i class="bi bi-shield"></i> <%= Object.keys(P).length %> وحدة مُعرّفة</span>
    </div>
  </div>
  <div class="h-actions btn-group">
    <button class="btn" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i> تحديث</button>
  </div>
</div>

<!-- الإعدادات العامة -->
<div class="card mb-4">
  <div class="card-head"><h3><i class="bi bi-sliders2"></i> الإعدادات العامة للحماية</h3></div>
  <div class="card-body">
    <div class="form-row">
      <div class="field">
        <label>📢 قناة التنبيهات الافتراضية <span class="hint">تُستخدم إذا لم تحدد قناة لوحدة فرعية</span></label>
        <select class="inp chan-sel" data-text="protection.logChannel" data-types="0,5" data-value="<%= P.logChannel || '' %>" data-placeholder="القناة الافتراضية للحماية"></select>
      </div>
      <div class="field">
        <label>⛽ كلمة مرور لوحة الإعدادات <span class="hint">أمر السيتنجات بالبوت</span></label>
        <input class="inp" type="text" data-text="settingsPassword" value="<%= settings?.settingsPassword || '' %>" placeholder="7421" maxlength="12">
      </div>
    </div>
    <div class="form-row mt-3">
      <div class="field">
        <label>👑 موافقة المالك للإطفاء <span class="hint">ينصح بتركها مفعلة</span></label>
        <div class="spread">
          <label class="switch lg"><input type="checkbox" data-toggle="protection.ownerApproval" <%= P.ownerApproval !== false ? 'checked' : '' %>><span class="track"></span></label>
          <span class="text-dim" style="font-size:11px;">إطفاء أي حماية يتطلب عرضاً على صاحب التاج</span>
        </div>
      </div>
      <div class="field">
        <label>🚨 وضع الطوارئ (Lockdown)</label>
        <div class="spread">
          <label class="switch lg"><input type="checkbox" data-toggle="protection.lockdown" <%= P.lockdown ? 'checked' : '' %>><span class="track"></span></label>
          <span class="text-dim" style="font-size:11px;">قفل فوري لكل قنوات السيرفر — للطوارئ فقط</span>
        </div>
      </div>
    </div>

    <div class="sec-title"><i class="bi bi-person-check-fill"></i> الوينثلست — مستثنون من الحماية</div>
    <div class="form-row">
      <label class="field-check"><input type="checkbox" data-toggle="protection.whitelist.enabled" <%= P.whitelist?.enabled ? 'checked' : '' %>><span>تفعيل قائمة المستثنين</span></label>
      <div class="field">
        <label>أعضاء مستثنون (IDs مفصولة بفاصلة) <span class="hint">النسخة بالسيرفر أضيف بالبوت</span></label>
        <input class="inp" data-live="protection.whitelist.userIds" value="<%= (P.whitelist?.userIds || []).join(',') %>" placeholder="1234567890, 2345678901">
      </div>
    </div>
  </div>
</div>

<%
