      ['num', 'maxUsesPerInvite', 'أقصى استخدادات للرابط', 40, 5, 500],
      ['role', 'rewardRoleId', 'رول المكافأة', ''],
      ['num', 'rewardInvites', 'عدد الدعوات للمكافأة', 10, 1, 500],
      ['chan', 'logChannel', 'قناة السجلات', ''],
    ]},
    { id: 'messageScanner', icon: 'search', grad: 'linear-gradient(135deg,#1f8fff,#2dd4a7)', name: 'Message Scanner', desc: 'فحص الفيروسات بالروابط والملفات', fields: [
      ['switch', 'scanLinks', 'فحص الروابط', true],
      ['switch', 'scanAttachments', 'فحص الملفات', true],
      ['sel', 'action', 'الإجراء', [['delete', 'حذف'], ['warn', 'تحذير'], ['mute', 'كتم'], ['ban', 'حظر']], 'delete'],
      ['list', 'whitelistDomains', 'دومينات موثوقة', 'youtube.com'],
      ['chan', 'logChannel', 'قناة السجلات', ''],
    ]},
    { id: 'scamFilter', icon: 'bug', grad: 'linear-gradient(135deg,#ff5c7a,#ff6ac1)', name: 'Scam Filter', desc: 'ضد روابط الاحتيال والتوثيق المزيف', fields: [] },
    { id: 'autoBackup', icon: 'cloud-arrow-up', grad: 'linear-gradient(135deg,#9b7cff,#35d0f0)', name: 'Auto-Backup', desc: 'نسخ احتياطية دورية للسيرفر', fields: [
      ['num', 'interval', 'كل كم ساعة', 24, 1, 168],
      ['num', 'keep', 'عدد النسخ المحفوظة', 12, 1, 50],
    ]},
    { id: 'autoScan', icon: 'search', grad: 'linear-gradient(135deg,#ffb020,#2dd4a7)', name: 'Auto-Scan', desc: 'فحص دوري يستعيد المفقود', fields: [
