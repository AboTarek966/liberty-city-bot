%>

<% FE.forEach(f => { const mod = P[f.id] || {}; const enabled = !!mod.enabled; %>
<div class="card mb-3" id="card-<%= f.id %>">
  <div class="card-head">
    <div class="f-ico" style="width:40px;height:40px;border-radius:11px;background:<%= f.grad %>;display:grid;place-items:center;color:#fff;font-size:17px;"><i class="bi bi-<%= f.icon %>"></i></div>
    <div style="flex:1;min-width:0;">
      <div class="fw800" style="font-size:14px;"><%= f.name %>
        <span class="chip <%= enabled ? 'green' : '' %>" style="margin-inline-start:6px;"><%= enabled ? 'مفعّل' : 'معطّل' %></span>
      </div>
      <div class="text-dim" style="font-size:11.5px;"><%= f.desc %></div>
    </div>
    <label class="switch lg"><input type="checkbox" data-toggle="protection.<%= f.id %>.enabled" <%= enabled ? 'checked' : '' %>><span class="track"></span></label>
  </div>
  <% if (f.fields.length) { %>
  <div class="card-body" style="opacity:<%= enabled ? '1' : '.7' %>;" data-modbody="<%= f.id %>">
    <div class="form-row-3" style="align-items:end;">
      <% f.fields.forEach(fd => {
        const [type, key, lb, def, min, max] = fd;
        const v = modVal(f.id, key, type === 'sel' ? min : def);
        const path = `protection.${f.id}.${key}`;
        if (type === 'switch') { %>
          <label class="field-check" style="grid-column:span 3;"><input type="checkbox" data-toggle="<%= path %>" <%= v ? 'checked' : '' %>><span><%= lb %></span></label>
        <% } else if (type === 'num') { %>
          <div class="field"><label><%= lb %></label><input type="number" class="inp num" data-num="<%= path %>" value="<%= v %>" min="<%= min %>" max="<%= max %>"></div>
        <% } else if (type === 'sel') { %>
          <div class="field"><label><%= lb %></label><select class="inp" data-text="<%= path %>"><%- selOpt(def, v) %></select></div>
        <% } else if (type === 'chan') { %>
          <div class="field"><label><%= lb %></label><select class="inp chan-sel" data-text="<%= path %>" data-types="0,5" data-value="<%= v || '' %>" data-placeholder="<%= lb %>"></select></div>
        <% } else if (type === 'role') { %>
          <div class="field"><label><%= lb %></label><select class="inp role-sel" data-text="<%= path %>" data-value="<%= v || '' %>"></select></div>
        <% } else if (type === 'list') { %>
          <div class="field" style="grid-column:span 3;"><label><%= lb %> <span class="hint">فصل بفاصلة</span></label><input class="inp" data-live="<%= path %>" value="<%= (Array.isArray(v) ? v : []).join(',') %>" placeholder="<%= def %>"></div>
        <% } else if (type === 'roles') { %>
          <div class="field" style="grid-column:span 3;">
            <div class="spread"><label><%= lb %> <span class="hint">اختر من بوت السيرفر</span></label><button class="btn sm" data-addfor="<%= f.id %>_<%= key %>"><i class="bi bi-plus-lg"></i> اختر</button></div>
            <div id="chips_<%= f.id %>_<%= key %>" style="display:flex;flex-wrap:wrap;gap:4px;"></div>
            <input type="hidden" id="<%= f.id %>_<%= key %>" value="<%= (Array.isArray(v) ? v : []).join(',') %>">
          </div>
        <% }
      }) %>
    </div>
  </div>
  <% } else { %>
  <div class="card-body" style="padding:13px 18px;opacity:<%= enabled ? '1' : '.7' %>;"><span class="text-dim" style="font-size:12.5px;">هذه الوحدة تعمل بمفتاح واحد فقط — <span class="chip <%= enabled ? 'green' : '' %>"><%= enabled ? 'تعمل الآن' : 'معطّلة' %></span></span></div>
  <% } %>
</div>
<% }) %>

<!-- الإعلانات الجماعية -->
<% const HIST = (P.announcements?.history || []).slice(-4).reverse(); %>
<div class="card mb-3" id="card-announcements">
  <div class="card-head">
    <div class="f-ico" style="width:40px;height:40px;border-radius:11px;background:linear-gradient(135deg,var(--amber),var(--pink));display:grid;place-items:center;color:#fff;font-size:17px;"><i class="bi bi-megaphone"></i></div>
    <div style="flex:1;min-width:0;">
      <div class="fw800" style="font-size:14px;">الإعلانات الجماعية (Broadcast)</div>
      <div class="text-dim" style="font-size:11.5px;">رسالة للجميع في الخاص أو في كل قنوات النص — تنفذها طوابير البوت</div>
    </div>
    <button class="btn primary sm" onclick="broadcastModal()"><i class="bi bi-send-fill"></i> إعلان جديد</button>
  </div>
  <div class="card-body tight">
    <% if (!HIST.length) { %><div class="empty" style="padding:22px;"><i class="bi bi-megaphone"></i><h4>لا سجل إعلانات</h4><p>كل إعلان ترسله يُحفظ هنا مع الوقت والمُرسِل</p></div><% } %>
    <% HIST.forEach(h => { %>
    <div class="feat">
      <div class="f-ico" style="background:<%= h.type === 'dm' ? 'var(--blue-soft)' : 'var(--purple-soft)' %>;color:<%= h.type === 'dm' ? 'var(--blue)' : 'var(--primary-2)' %>;"><i class="bi bi-<%= h.type === 'dm' ? 'mailbox' : 'layout-text-sidebar-reverse' %>"></i></div>
      <div class="f-info">
        <div class="f-name"><%= h.type === 'dm' ? 'خاص لكل الأعضاء' : 'كل قنوات النص' %> <span class="chip <%= h.sent ? 'green' : 'red' %>"><%= h.sent ? 'أُرسل' : 'تعذّر' %></span></div>
        <div class="f-desc"><%= (h.content || '').slice(0, 70) %></div>
      </div>
      <small class="text-dim" style="font-size:10.5px;"><%= h.at ? new Date(h.at).toLocaleString('ar-EG', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '' %> · <%= h.sentBy || '' %></small>
    </div>
    <% }) %>
  </div>
</div>

<script>
  const GID = '<%= GID %>';
  function broadcastModal() {
    LC.modal({
      title: 'إعلان جماعي جديد',
      body: `
        <div class="field mb-3"><label>وجهة الإرسال</label>
          <select id="bc_type" class="inp">
            <option value="dm">رسائل خاصة لكل الأعضاء (بدون بوتات)</option>
            <option value="channel">رسالة في كل قنوات النص</option>
          </select>
        </div>
        <div class="field"><label>نص الإعلان <span class="hint">يمكن استخدام @everyone</span></label>
          <textarea id="bc_content" class="inp" style="min-height:110px;" placeholder="نص الإعلان هنا…"></textarea>
        </div>
        <div class="banner warn mt-3" style="margin-bottom:0;"><i class="bi bi-exclamation-triangle"></i> سيُرسل فعلياً لكل الأعضاء/القنوات — تأكد من النص.</div>`,
      actions: [
        { label: 'إرسال الآن', cls: 'danger', icon: 'send-fill', onclick: async (m) => {
          const type = document.getElementById('bc_type').value;
          const content = document.getElementById('bc_content').value.trim();
          if (!content) { LC.toast('اكتب نص الإعلان', 'warn'); throw new Error('skip'); }
          const r = await LC.api(`/api/guilds/${GID}/command`, { method: 'POST', body: { command: 'broadcast', payload: { type, content } } });
          LC.toast(`انطلق الإعلان${r?.sent != null ? ` — أُرسل ${r.sent} ${type === 'dm' ? 'رسالة خاصة' : 'قناة'}${r?.failed ? ` · فشل ${r.failed}` : ''}` : ' — البوت يعمل عليه'} ✅`, 'success', 6000);
          setTimeout(() => location.reload(), 1200);
        }},
        { label: 'إلغاء', cls: 'ghost' },
      ],
    });
  }

  document.addEventListener('DOMContentLoaded', async () => {
    const okChan = await LC.loadChannels(GID, $$('.chan-sel'));
    if (!okChan) LC.toast('تعذر جلب القنوات من البوت حالياً — عدّل لاحقاً', 'warn', 5500);
    await LC.loadRoles(GID, $$('.role-sel'));

    $$('.inp[data-live]').forEach(el => {
      el.addEventListener('change', async () => {
        const path = el.dataset.live;
        const arr = el.value.split(',').map(s => s.trim()).filter(Boolean);
        const payload = {}; let node = payload;
        const ks = path.split('.');
        ks.slice(0, -1).forEach(k => { node[k] = node[k] || {}; node = node[k]; });
        node[ks[ks.length - 1]] = arr;
        await LC.saveSetting(GID, payload, null);
      });
    });

    [['antiLink_ignoreRoles'], ['antiInvite_ignoreRoles']].forEach(([key]) => {
      LC.multiEditor({ inputId: key, listEl: 'chips_' + key, guildId: GID, kind: 'roles', path: 'protection.' + key.replace('_ignoreRoles', '.ignoreRoles') });
    });
    $$('[data-toggle^="protection."][data-toggle$=".enabled"]').forEach(sw => {
      sw.addEventListener('change', () => {
        const mid = sw.dataset.toggle.split('.')[1];
        const body = document.querySelector(`[data-modbody="${mid}"]`);
        if (body) body.style.opacity = sw.checked ? '1' : '.7';
        const badge = document.querySelector('#card-' + mid + ' .chip');
        if (badge) { badge.classList.toggle('green', sw.checked); badge.textContent = sw.checked ? 'مفعّل' : 'معطّل'; }
      });
    });
  });
</script>

<%- include('layout-bottom') %>
