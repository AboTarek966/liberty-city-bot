<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Liberty City</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/dashboard.css?v=21">
</head>
<body>
<% const __guild = locals.guild || null; const __user = locals.user || null; const __stats = locals.stats || null; const __members = locals.members || null; const __ticketsArr = locals.tickets || null; %>
<div class="app">

  <aside class="sidebar" id="sidebar">
    <div class="brand">
      <div class="brand-logo"><i class="bi bi-shield-lock-fill"></i></div>
      <div>
        <div class="brand-text">Liberty City</div>
        <div class="brand-sub">لوحة تحكّم متقدّمة</div>
      </div>
    </div>

    <% if (__guild) { %>
    <div class="side-guild" data-dd>
      <% if (__guild.icon) { %>
        <img src="https://cdn.discordapp.com/icons/<%= __guild.id %>/<%= __guild.icon %>.png?size=128" alt="">
      <% } else { %>
        <div class="g-letter"><%= (__guild.name || '?').charAt(0) %></div>
      <% } %>
      <div>
        <div class="g-name"><%= __guild.name %></div>
        <div class="g-members"><i class="bi bi-people-fill"></i> <span class="num"><%= (__stats?.memberCount != null) ? __stats.memberCount.toLocaleString('en-US') : '...' %></span> عضو</div>
      </div>
      <i class="bi bi-chevron-down" style="margin-inline-start:auto;color:var(--text-3);font-size:12px;"></i>
      <div class="guild-switcher dd-menu" id="guildSwitcher">
        <% (req.session.guilds || []).forEach(g => { %>
          <a href="/dashboard/<%= g.id %>" class="<%= g.id === __guild.id ? 'active' : '' %>">
            <% if (g.icon) { %><img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=64"><% } %>
            <span><%= g.name %></span>
          </a>
        <% }) %>
      </div>
    </div>

    <div class="conn" id="connPill" title="اتصال لوحة التحكم مع البوت">
      <span class="dot"></span> <span id="connText">جاري التحقق…</span>
    </div>

    <nav class="nav">
      <div class="nav-label">الرئيسية</div>
      <a href="/dashboard/<%= __guild.id %>" class="<%= activePage === 'guild' ? 'active' : '' %>"><i class="bi bi-house-door"></i><span> نظرة عامة</span></a>
      <a href="/dashboard/<%= __guild.id %>/protection" class="<%= activePage === 'protection' ? 'active' : '' %>"><i class="bi bi-shield-check"></i><span> الحماية</span><span class="pill <%= settings?.protection?.antiRaid?.enabled || settings?.protection?.antiSpam?.enabled ? 'on' : '' %>"><%= settings?.protection?.antiRaid?.enabled || settings?.protection?.antiSpam?.enabled ? 'ON' : 'OFF' %></span></a>
      <a href="/dashboard/<%= __guild.id %>/ai" class="<%= activePage === 'ai' ? 'active' : '' %>"><i class="bi bi-stars"></i><span> الذكاء الاصطناعي</span></a>

      <div class="nav-label">الإدارة</div>
      <a href="/dashboard/<%= __guild.id %>/members" class="<%= activePage === 'members' ? 'active' : '' %>"><i class="bi bi-people"></i><span> الأعضاء</span><span class="pill on"><%= __members?.total ?? '' %></span></a>
      <a href="/dashboard/<%= __guild.id %>/tickets" class="<%= activePage === 'tickets' ? 'active' : '' %>"><i class="bi bi-lifebuoy"></i><span> التذاكر</span><span class="pill <%= (Array.isArray(__ticketsArr) ? __ticketsArr.filter(t => t.status === 'open').length : 0) ? 'on' : '' %>"><%= Array.isArray(__ticketsArr) ? __ticketsArr.filter(t => t.status === 'open').length : '' %></span></a>
      <a href="/dashboard/<%= __guild.id %>/logs" class="<%= activePage === 'logs' ? 'active' : '' %>"><i class="bi bi-journal-text"></i><span> السجلات</span></a>

      <div class="nav-label">الأنظمة والتخصيص</div>
      <a href="/dashboard/<%= __guild.id %>/welcome" class="<%= activePage === 'welcome' ? 'active' : '' %>"><i class="bi bi-door-open"></i><span> الترحيب والمغادرة</span><span class="pill <%= settings?.welcome?.enabled ? 'on' : '' %>"><%= settings?.welcome?.enabled ? 'ON' : 'OFF' %></span></a>
      <a href="/dashboard/<%= __guild.id %>/economy" class="<%= activePage === 'economy' ? 'active' : '' %>"><i class="bi bi-coin"></i><span> الاقتصاد والمستويات</span></a>
      <a href="/dashboard/<%= __guild.id %>/settings" class="<%= activePage === 'settings' ? 'active' : '' %>"><i class="bi bi-sliders"></i><span> الإعدادات العامة</span></a>
    </nav>
    <% } else { %>
    <div class="conn" id="connPill" title="اتصال لوحة التحكم مع البوت">
      <span class="dot"></span> <span id="connText">جاري التحقق…</span>
    </div>
    <nav class="nav">
      <div class="nav-label">القوائم</div>
      <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>"><i class="bi bi-collection"></i><span> سيرفراتي</span></a>
    </nav>
    <% } %>

    <div class="side-foot">
      <% if (__user && __user.avatar) { %>
        <img src="https://cdn.discordapp.com/avatars/<%= __user.id %>/<%= __user.avatar %>.png?size=64" alt="">
      <% } else { %>
        <div class="u-letter"><%= (__user?.username || '؟').charAt(0) %></div>
      <% } %>
      <div>
        <div class="u-name"><%= __user?.username || 'مستخدم' %></div>
        <div class="u-sub">دخول عبر Discord</div>
      </div>
      <a href="/logout" class="exit" title="تسجيل الخروج"><i class="bi bi-box-arrow-left"></i></a>
    </div>
  </aside>

  <div class="main">
    <header class="topbar">
      <button class="icon-btn mobile-btn" onclick="document.getElementById('sidebar').classList.toggle('open')"><i class="bi bi-list"></i></button>
      <div>
        <h1><%= title %></h1>
        <div class="sub">Liberty City Bot — لوحة تحكم القنصل</div>
      </div>
      <div class="spacer"></div>
      <% if (locals.guild) { %>
        <a class="icon-btn" href="https://discord.com/channels/<%= guild.id %>" target="_blank" title="فتح في Discord"><i class="bi bi-discord"></i></a>
        <button class="icon-btn" onclick="location.reload()" title="تحديث الصفحة"><i class="bi bi-arrow-clockwise"></i></button>
      <% } %>
    </header>

    <main class="content">
