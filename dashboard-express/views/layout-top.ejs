<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Liberty City</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css?v=<%= Date.now() %>">
  <style>
    /* Dynamic sidebar state */
    .sidebar.collapsed { width: 72px; }
    .sidebar.collapsed .sidebar-brand .brand-text,
    .sidebar.collapsed .sidebar-brand .brand-sub,
    .sidebar.collapsed .sidebar-nav a span,
    .sidebar.collapsed .sidebar-nav .nav-section,
    .sidebar.collapsed .sidebar-guild .guild-info,
    .sidebar.collapsed .sidebar-footer .user-info { display: none; }
    .sidebar.collapsed .sidebar-nav a { justify-content: center; padding: 10px; }
    .sidebar.collapsed .sidebar-nav a.active::before { display: none; }
    .sidebar.collapsed .sidebar-guild { justify-content: center; }
    .sidebar.collapsed .sidebar-footer { justify-content: center; }
    .sidebar.collapsed ~ .main { margin-right: 72px; }
    
    /* Toast animation */
    .toast { animation: slideIn 0.3s ease; }
    @keyframes slideIn { from { opacity: 0; transform: translateX(100px); } to { opacity: 1; transform: translateX(0); } }
    
    /* Loading overlay */
    .loading-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(10, 14, 26, 0.8); backdrop-filter: blur(4px); z-index: 9999; display: flex; align-items: center; justify-content: center; }
    .loading-overlay .spinner { width: 48px; height: 48px; border: 4px solid var(--border); border-top-color: var(--accent); border-radius: 50%; animation: spin 1s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</head>
<body>
<% const __guild = locals.guild || null; const __user = locals.user || null; const __stats = locals.stats || null; const __members = locals.members || null; const __ticketsArr = locals.tickets || null; %>
<div class="loading-overlay" id="globalLoader" style="display: none;">
  <div class="spinner"></div>
</div>

<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon"><i class="bi bi-shield-lock"></i></div>
    <div>
      <div class="brand-text">Liberty City</div>
      <div class="brand-sub">لوحة التحكم</div>
    </div>
  </div>

  <% if (__guild) { %>
  <div class="sidebar-guild">
    <% if (__guild.icon) { %>
      <img src="https://cdn.discordapp.com/icons/<%= __guild.id %>/<%= __guild.icon %>.png?size=64" alt="">
    <% } else { %>
      <div class="avatar" style="background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;"><%= __guild.name?.charAt(0) || '?' %></div>
    <% } %>
    <div class="guild-info">
      <div class="guild-name"><%= __guild.name %></div>
      <div class="guild-members"><i class="bi bi-people-fill"></i> <%= __guild.memberCount || __stats?.memberCount || '?' %> عضو</div>
    </div>
  </div>
  
  <nav class="sidebar-nav">
    <div class="nav-section"><i class="bi bi-circle-fill"></i> الرئيسية</div>
    <a href="/dashboard/<%= __guild.id %>" class="<%= activePage === 'guild' ? 'active' : '' %>"><i class="bi bi-grid-1x2"></i><span> نظرة عامة</span></a>
    <a href="/dashboard/<%= __guild.id %>/protection" class="<%= activePage === 'protection' ? 'active' : '' %>"><i class="bi bi-shield-check"></i><span> الحماية</span></a>
    <a href="/dashboard/<%= __guild.id %>/ai" class="<%= activePage === 'ai' ? 'active' : '' %>"><i class="bi bi-robot"></i><span> الذكاء الاصطناعي</span></a>

    <div class="nav-section"><i class="bi bi-circle-fill"></i> الإدارة</div>
    <a href="/dashboard/<%= __guild.id %>/members" class="<%= activePage === 'members' ? 'active' : '' %>"><i class="bi bi-people"></i><span> الأعضاء</span><span class="badge-pill"><%= (__members?.total ? __members.total : '') %></span></a>
    <a href="/dashboard/<%= __guild.id %>/tickets" class="<%= activePage === 'tickets' ? 'active' : '' %>"><i class="bi bi-ticket-perforated"></i><span> التذاكر</span><span class="badge-pill"><%= (Array.isArray(__ticketsArr) ? __ticketsArr.filter(t=>t.status==='open').length : '') %></span></a>
    <a href="/dashboard/<%= __guild.id %>/logs" class="<%= activePage === 'logs' ? 'active' : '' %>"><i class="bi bi-journal-text"></i><span> السجلات</span></a>

    <div class="nav-section"><i class="bi bi-circle-fill"></i> التخصيص</div>
    <a href="/dashboard/<%= __guild.id %>/welcome" class="<%= activePage === 'welcome' ? 'active' : '' %>"><i class="bi bi-door-open"></i><span> الترحيب</span></a>
    <a href="/dashboard/<%= __guild.id %>/economy" class="<%= activePage === 'economy' ? 'active' : '' %>"><i class="bi bi-coin"></i><span> الاقتصاد</span></a>
    <a href="/dashboard/<%= __guild.id %>/settings" class="<%= activePage === 'settings' ? 'active' : '' %>"><i class="bi bi-gear"></i><span> الإعدادات</span></a>
  </nav>
  <% } else { %>
  <nav class="sidebar-nav">
    <div class="nav-section"><i class="bi bi-circle-fill"></i> القوائم</div>
    <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>"><i class="bi bi-server"></i><span> سيرفراتي</span></a>
  </nav>
  <% } %>

  <div class="sidebar-footer">
    <% if (__user && __user.avatar) { %>
      <img src="https://cdn.discordapp.com/avatars/<%= __user.id %>/<%= __user.avatar %>.png?size=64" alt="">
    <% } else { %>
      <div class="avatar" style="background:linear-gradient(135deg,var(--success),var(--info));color:#fff;"><i class="bi bi-person"></i></div>
    <% } %>
    <div class="user-info">
      <div class="user-name"><%= __user?.username || 'مستخدم' %></div>
      <div class="user-tag">#<%= __user?.discriminator || '0000' %></div>
    </div>
    <a href="/logout" class="topbar-btn" title="تسجيل الخروج"><i class="bi bi-box-arrow-left"></i></a>
  </div>
</aside>

<div class="main">
  <header class="topbar">
    <div style="display:flex;align-items:center;gap:12px;">
      <button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('show')">
        <i class="bi bi-list"></i>
      </button>
      <button class="sidebar-toggle d-none d-md-flex" onclick="document.getElementById('sidebar').classList.toggle('collapsed')" title="طي الشريط">
        <i class="bi bi-chevron-double-left" id="collapseIcon"></i>
      </button>
      <div class="topbar-title">
        <div class="title-icon"><i class="bi bi-speedometer2"></i></div>
        <%= title %>
      </div>
    </div>
    <div class="topbar-actions">
      <div class="dropdown">
        <button class="topbar-btn dropdown-toggle" data-bs-toggle="dropdown" title="إجراءات سريعة"><i class="bi bi-three-dots-vertical"></i></button>
        <ul class="dropdown-menu dropdown-menu-end">
          <li><a class="dropdown-item" href="/dashboard"><i class="bi bi-grid-3x3-gap me-2"></i> كل السيرفرات</a></li>
          <% if (__guild) { %>
          <li><a class="dropdown-item" href="/dashboard/<%= __guild.id %>/settings" target="_blank"><i class="bi bi-gear me-2"></i> إعدادات هذا السيرفر</a></li>
          <% } %>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item text-danger" href="/logout"><i class="bi bi-box-arrow-left me-2"></i> تسجيل الخروج</a></li>
        </ul>
      </div>
      <button class="topbar-btn" title="تحديث" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i></button>
      <a href="/dashboard" class="topbar-btn" title="السيرفرات"><i class="bi bi-grid-3x3-gap"></i></a>
    </div>
  </header>

  <main class="content">
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger mb-4" role="alert">
      <i class="bi bi-exclamation-triangle me-2"></i> <%= error %>
    </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success mb-4" role="alert">
      <i class="bi bi-check-circle me-2"></i> <%= success %>
    </div>
    <% } %>