<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Liberty City</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
</head>
<body>
<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <div class="brand-icon"><i class="bi bi-shield-lock"></i></div>
    <div>
      <div class="brand-text">Liberty City</div>
      <div class="brand-sub">لوحة التحكم</div>
    </div>
  </div>

  <% if (typeof guild !== 'undefined' && guild) { %>
  <div class="sidebar-guild">
    <% if (guild.icon) { %>
      <img src="https://cdn.discordapp.com/icons/<%= guild.id %>/<%= guild.icon %>.png?size=64" alt="">
    <% } else { %>
      <div class="avatar" style="background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;"><%= guild.name?.charAt(0) || '?' %></div>
    <% } %>
    <div class="guild-info">
      <div class="guild-name"><%= guild.name %></div>
      <div class="guild-members"><i class="bi bi-people-fill"></i> <%= guild.memberCount || stats?.memberCount || '?' %> عضو</div>
    </div>
  </div>
  <nav class="sidebar-nav">
    <div class="nav-section"><i class="bi bi-circle-fill"></i> الرئيسية</div>
    <a href="/dashboard/<%= guild.id %>" class="<%= activePage === 'guild' ? 'active' : '' %>"><i class="bi bi-grid-1x2"></i> نظرة عامة</a>
    <a href="/dashboard/<%= guild.id %>/protection" class="<%= activePage === 'protection' ? 'active' : '' %>"><i class="bi bi-shield-check"></i> الحماية</a>
    <a href="/dashboard/<%= guild.id %>/ai" class="<%= activePage === 'ai' ? 'active' : '' %>"><i class="bi bi-robot"></i> الذكاء الاصطناعي</a>

    <div class="nav-section"><i class="bi bi-circle-fill"></i> الإدارة</div>
    <a href="/dashboard/<%= guild.id %>/members" class="<%= activePage === 'members' ? 'active' : '' %>"><i class="bi bi-people"></i> الأعضاء</a>
    <a href="/dashboard/<%= guild.id %>/tickets" class="<%= activePage === 'tickets' ? 'active' : '' %>"><i class="bi bi-ticket-perforated"></i> التذاكر<span class="badge-pill"><%= (typeof tickets !== 'undefined' && Array.isArray(tickets) ? tickets.filter(t=>t.status==='open').length : 0) %></span></a>
    <a href="/dashboard/<%= guild.id %>/logs" class="<%= activePage === 'logs' ? 'active' : '' %>"><i class="bi bi-journal-text"></i> السجلات</a>

    <div class="nav-section"><i class="bi bi-circle-fill"></i> التخصيص</div>
    <a href="/dashboard/<%= guild.id %>/welcome" class="<%= activePage === 'welcome' ? 'active' : '' %>"><i class="bi bi-door-open"></i> الترحيب</a>
    <a href="/dashboard/<%= guild.id %>/economy" class="<%= activePage === 'economy' ? 'active' : '' %>"><i class="bi bi-coin"></i> الاقتصاد</a>
    <a href="/dashboard/<%= guild.id %>/settings" class="<%= activePage === 'settings' ? 'active' : '' %>"><i class="bi bi-gear"></i> الإعدادات</a>
  </nav>
  <% } else { %>
  <nav class="sidebar-nav">
    <div class="nav-section"><i class="bi bi-circle-fill"></i> القوائم</div>
    <a href="/dashboard" class="<%= activePage === 'dashboard' ? 'active' : '' %>"><i class="bi bi-server"></i> سيرفراتي</a>
  </nav>
  <% } %>

  <div class="sidebar-footer">
    <% if (user && user.avatar) { %>
      <img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="">
    <% } else { %>
      <div class="avatar" style="background:linear-gradient(135deg,var(--success),var(--info));color:#fff;"><i class="bi bi-person"></i></div>
    <% } %>
    <div class="user-info">
      <div class="user-name"><%= user?.username || 'مستخدم' %></div>
      <div class="user-tag">#<%= user?.discriminator || '0000' %></div>
    </div>
    <a href="/logout" class="topbar-btn" title="تسجيل الخروج"><i class="bi bi-box-arrow-left"></i></a>
  </div>
</aside>

<div class="main">
  <header class="topbar">
    <div style="display:flex;align-items:center;gap:12px;">
      <button class="sidebar-toggle" onclick="document.getElementById('sidebar').classList.toggle('show')">
        <i class="bi bi-list"></i>
      </button>
      <div class="topbar-title">
        <div class="title-icon"><i class="bi bi-speedometer2"></i></div>
        <%= title %>
      </div>
    </div>
    <div class="topbar-actions">
      <button class="topbar-btn" title="تحديث" onclick="location.reload()"><i class="bi bi-arrow-clockwise"></i></button>
      <a href="/dashboard" class="topbar-btn" title="السيرفرات"><i class="bi bi-grid-3x3-gap"></i></a>
    </div>
  </header>

  <main class="content">
