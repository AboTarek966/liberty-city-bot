<%- include('layout-top', { title: 'الرد التلقائي', activePage: 'autoreply' }) %>

<% const A = settings?.autoReply || {}; const GID = guild.id;
   const deviceDataUrl = A.imageData ? `data:${A.imageMimeType || 'image/jpeg'};base64,${A.imageData}` : '';
   const previewSrc = deviceDataUrl || A.imageUrl || '';
   const deviceKb = A.imageData ? Math.round((A.imageData.length * 3 / 4) / 1024) : 0;
%>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,#1abc9c,#00d4ff);display:grid;place-items:center;font-size:26px;"><i class="bi bi-chat-dots-fill"></i></div>
  <div>
    <div class="h-title">الرد التلقائي
      <span class="chip <%= A.enabled ? 'green' : '' %>"><%= A.enabled ? 'مفعّل' : 'معطّل' %></span>
    </div>
    <div class="h-desc">أي رسالة في القنوات المختارة ← البوت يرد بكلمة و/أو صورة محددة. كل تعديل يُحفظ لحظياً.</div>
    <div class="h-chips">
      <span class="chip cyan"><i class="bi bi-hash"></i> القنوات: <%= (A.channelIds || []).length %></span>
      <span class="chip purple"><i class="bi bi-hourglass-split"></i> الفاصل: <%= A.cooldownSeconds ?? 30 %> ثانية</span>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-head">
    <h3><i class="bi bi-power"></i> التشغيل والسلوك</h3>
    <div class="head-side">
      <label class="switch lg"><input type="checkbox" data-toggle="autoReply.enabled" <%= A.enabled ? 'checked' : '' %>><span class="track"></span></label>
    </div>
  </div>
  <div class="card-body">
    <div class="form-row-3">
      <label class="field-check"><input type="checkbox" data-toggle="autoReply.deleteTrigger" <%= A.deleteTrigger ? 'checked' : '' %>><span>🗑️ حذف رسالة العضو بعد الرد</span></label>
      <label class="field-check"><input type="checkbox" data-toggle="autoReply.replyToMessage" <%= A.replyToMessage !== false ? 'checked' : '' %>><span>↩️ الرد كـ Reply على رسالة العضو</span></label>
      <label class="field-check"><input type="checkbox" data-toggle="autoReply.ignoreStaff" <%= A.ignoreStaff !== false ? 'checked' : '' %>><span>🛡️ تجاهل رسائل الإداريين</span></label>
    </div>
    <div class="form-row mt-3">
      <div class="field" style="max-width:260px;">
        <label>⏱️ الفاصل الزمني بالثواني <span class="hint">لكل عضو في نفس القناة</span></label>
        <input type="number" class="inp num" data-num="autoReply.cooldownSeconds" value="<%= A.cooldownSeconds ?? 30 %>" min="0" max="3600">
      </div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-head"><h3><i class="bi bi-hash"></i> قنوات الرد التلقائي</h3></div>
  <div class="card-body">
    <div class="field">
      <div class="spread">
        <label>📍 القنوات المفعّلة <span class="hint">أي رسالة فيها يرد البوت — حتى 10 قنوات</span></label>
        <button class="btn sm" data-addfor="ar_channels"><i class="bi bi-plus-lg"></i> اختر قنوات</button>
      </div>
      <div id="chips_ar_channels" style="display:flex;flex-wrap:wrap;gap:4px;margin-top:8px;"></div>
      <input type="hidden" id="ar_channels" value="<%= (A.channelIds || []).join(',') %>">
      <div class="text-dim" style="font-size:11px;margin-top:6px;">اتركها فارغة وراح يتوقف الرد التلقائي حتى تختار قناة.</div>
    </div>
  </div>
</div>

<div class="card mb-4">
  <div class="card-head"><h3><i class="bi bi-chat-square-text"></i> النص والصورة</h3></div>
  <div class="card-body">
    <div class="field">
      <label>💬 النص أو الكلمة</label>
      <textarea class="inp" data-text="autoReply.text" rows="4" maxlength="2000" placeholder="مثال: أهلاً بك! اكتب سؤالك وفريق الدعم هيساعدك 💙"><%= A.text || '' %></textarea>
    </div>
    <div class="field mt-3">
      <label>🖼️ صورة من جهازك <span class="hint">اختر صورة — تُضغط تلقائياً وتُحفظ داخل قاعدة البيانات</span></label>
      <div class="btn-group" style="align-items:center;flex-wrap:wrap;gap:8px;">
        <input type="file" id="arImageFile" accept="image/png,image/jpeg,image/webp,image/gif" style="display:none;">
        <button class="btn primary sm" id="arPickImage" type="button"><i class="bi bi-upload"></i> اختيار صورة من الجهاز</button>
        <button class="btn danger sm" id="arRemoveImage" type="button" <%= (A.imageData || A.imageUrl) ? '' : 'disabled' %>><i class="bi bi-trash"></i> إزالة الصورة</button>
        <span id="arImageInfo" class="text-dim" style="font-size:11px;"><%= A.imageData ? `✅ ${A.imageName || 'صورة محفوظة'} — ${deviceKb} KB` : (A.imageUrl ? 'صورة من رابط خارجي' : 'لا توجد صورة') %></span>
      </div>
      <div class="text-dim" style="font-size:11px;margin-top:6px;">JPG / PNG / WebP / GIF — الحد الأقصى 12MB قبل الضغط، وتُحفظ نسخة مضغوطة صغيرة.</div>
    </div>
    <div class="field mt-3">
      <label>🔗 أو رابط صورة خارجي <span class="hint">اختياري — يُستخدم لو ما في صورة من الجهاز</span></label>
      <input class="inp" id="arImageUrl" value="<%= A.imageUrl || '' %>" maxlength="500" placeholder="https://example.com/image.png">
    </div>
    <div class="sec-title"><i class="bi bi-eye"></i> معاينة الرد</div>
    <div id="arPreview" style="background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:14px 16px;min-height:64px;">
      <div id="arPreviewText" style="font-size:13px;font-weight:700;margin-bottom:8px;<%= A.text ? '' : 'display:none;' %>"><%= A.text || '' %></div>
      <img id="arPreviewImg" src="<%= previewSrc || 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7' %>" data-device="<%= deviceDataUrl ? '1' : '0' %>" alt="preview" style="<%= previewSrc ? '' : 'display:none;' %>max-width:100%;max-height:260px;border-radius:10px;" onerror="this.style.display='none'">
      <span id="arPreviewEmpty" class="text-dim" style="font-size:12px;<%= (A.text || previewSrc) ? 'display:none;' : '' %>">لا يوجد نص أو صورة بعد — أضف ما تريده أعلاه.</span>
    </div>
  </div>
</div>

<script>
  const AR_GID = '<%= GID %>';
  document.addEventListener('DOMContentLoaded', () => {
    LC.multiEditor({
      inputId: 'ar_channels',
      listEl: 'chips_ar_channels',
      guildId: AR_GID,
      kind: 'channels',
      path: 'autoReply.channelIds',
      placeholder: 'لا قنوات — اضغط ＋',
    });

    const textEl = document.querySelector('[data-text="autoReply.text"]');
    const urlEl = document.getElementById('arImageUrl');
    const fileEl = document.getElementById('arImageFile');
    const pickBtn = document.getElementById('arPickImage');
    const removeBtn = document.getElementById('arRemoveImage');
    const infoEl = document.getElementById('arImageInfo');
    const previewText = document.getElementById('arPreviewText');
    const previewImg = document.getElementById('arPreviewImg');
    const previewEmpty = document.getElementById('arPreviewEmpty');

    // 🖼️ الصورة المرفوعة من الجهاز لها أولوية، ثم الرابط الخارجي
    const EMPTY_IMG = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';
    let deviceSrc = previewImg.dataset.device === '1' ? (previewImg.getAttribute('src') || '') : '';

    const renderPreview = () => {
      const text = (textEl?.value || '').trim();
      const url = (urlEl?.value || '').trim();
      const img = deviceSrc || url;
      previewText.textContent = text;
      previewText.style.display = text ? '' : 'none';
      if (img) {
        previewImg.src = img;
        previewImg.style.display = '';
      } else {
        previewImg.src = EMPTY_IMG;
        previewImg.style.display = 'none';
      }
      previewEmpty.style.display = text || img ? 'none' : '';
    };
    textEl?.addEventListener('input', renderPreview);
    urlEl?.addEventListener('input', renderPreview);

    const loadImageFile = (file) => new Promise((resolve, reject) => {
      const img = new Image();
      const objectUrl = URL.createObjectURL(file);
      img.onload = () => { URL.revokeObjectURL(objectUrl); resolve(img); };
      img.onerror = () => { URL.revokeObjectURL(objectUrl); reject(new Error('تعذّر قراءة الصورة')); };
      img.src = objectUrl;
    });

    // ضغط داخل المتصفح — يقلل الحجم قبل إرساله للبوت/قاعدة البيانات
    const compressImage = async (file) => {
      if (!(file.type && file.type.startsWith('image/')) && !/\.(png|jpe?g|webp|gif)$/i.test(file.name || '')) {
        throw new Error('اختر ملف صورة صالح (JPG/PNG/WebP/GIF)');
      }
      if (file.size > 12 * 1024 * 1024) throw new Error('حجم الصورة أكبر من 12MB');

      // GIF الصغير يُحفظ كما هو حتى لا تضيع الحركة
      const isGif = (file.type === 'image/gif') || /\.gif$/i.test(file.name || '');
      if (isGif && file.size <= 1_400_000) {
        const dataUrl = await new Promise((resolve, reject) => {
          const reader = new FileReader();
          reader.onload = () => resolve(String(reader.result || ''));
          reader.onerror = () => reject(new Error('تعذّر قراءة الصورة'));
          reader.readAsDataURL(file);
        });
        return { base64: dataUrl.split(',')[1] || '', dataUrl, bytes: file.size, mimeType: 'image/gif', ext: 'gif' };
      }

      const img = await loadImageFile(file);
      const natW = img.naturalWidth;
      const natH = img.naturalHeight;

      // ارسم بالحجم الأصلي لتحليل المحتوى
      const nat = document.createElement('canvas');
      nat.width = natW;
      nat.height = natH;
      const nctx = nat.getContext('2d', { willReadFrequently: true });
      nctx.drawImage(img, 0, 0);
      const { data } = nctx.getImageData(0, 0, natW, natH);

      let hasTransparency = false;
      for (let i = 3; i < data.length; i += 4) {
        if (data[i] < 250) { hasTransparency = true; break; }
      }
      const cornerIdx = [0, (natW - 1) * 4, (natH - 1) * natW * 4, ((natH - 1) * natW + (natW - 1)) * 4];
      const bg = [0, 0, 0].map((_, ch) => Math.round(cornerIdx.reduce((s, i) => s + data[i + ch], 0) / 4));
      const dist = (i) => Math.max(
        Math.abs(data[i] - bg[0]),
        Math.abs(data[i + 1] - bg[1]),
        Math.abs(data[i + 2] - bg[2])
      );
      const cornersClose = cornerIdx.every((i) => dist(i) <= 48);

      // حدود المحتوى الفعلي (بدون هوامش شفافة/موحدة)
      let minX = natW, minY = natH, maxX = -1, maxY = -1;
      const step = natW * natH > 3_000_000 ? 2 : 1;
      for (let y = 0; y < natH; y += step) {
        for (let x = 0; x < natW; x += step) {
          const i = (y * natW + x) * 4;
          let content;
          if (hasTransparency) content = data[i + 3] > 24;
          else if (cornersClose) content = dist(i) > 32;
          else content = true; // صورة صاخبة — بلا قص
          if (content) {
            if (x < minX) minX = x;
            if (y < minY) minY = y;
            if (x > maxX) maxX = x;
            if (y > maxY) maxY = y;
          }
        }
      }
      let box = { x: 0, y: 0, w: natW, h: natH };
      if (maxX >= 0) {
        const tw = maxX - minX + 1, th = maxY - minY + 1;
        if (!(tw >= natW - 2 && th >= natH - 2) && tw >= 8 && th >= 8) {
          box = { x: minX, y: minY, w: tw, h: th };
        }
      }

      const attempts = hasTransparency
        ? [[1600, 'image/webp', 0.95], [1600, 'image/webp', 0.9], [1200, 'image/webp', 0.9], [1600, 'image/png', 1], [1000, 'image/webp', 0.85]]
        : [[1600, 'image/jpeg', 0.92], [1600, 'image/jpeg', 0.85], [1600, 'image/jpeg', 0.75], [1200, 'image/jpeg', 0.85], [1000, 'image/jpeg', 0.72]];

      let best = null;
      let bestType = null;
      for (const [maxDim, type, quality] of attempts) {
        const scale = Math.min(1, maxDim / Math.max(box.w, box.h));
        const w = Math.max(1, Math.round(box.w * scale));
        const h = Math.max(1, Math.round(box.h * scale));
        const canvas = document.createElement('canvas');
        canvas.width = w;
        canvas.height = h;
        const ctx = canvas.getContext('2d');
        if (type === 'image/jpeg') { ctx.fillStyle = '#fff'; ctx.fillRect(0, 0, w, h); }
        ctx.imageSmoothingEnabled = true;
        ctx.imageSmoothingQuality = 'high';
        ctx.drawImage(img, box.x, box.y, box.w, box.h, 0, 0, w, h);
        const blob = await new Promise((resolve) => canvas.toBlob(resolve, type, quality));
        if (!blob) continue;
        best = blob;
        bestType = type;
        if (blob.size <= 1_400_000) break;
      }
      if (!best) throw new Error('تعذّر ضغط الصورة');

      const dataUrl = await new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = () => resolve(String(reader.result || ''));
        reader.onerror = () => reject(new Error('تعذّر قراءة الصورة'));
        reader.readAsDataURL(best);
      });
      const ext = bestType === 'image/png' ? 'png' : bestType === 'image/webp' ? 'webp' : 'jpg';
      return { base64: dataUrl.split(',')[1] || '', dataUrl, bytes: best.size, mimeType: bestType, ext };
    };

    pickBtn?.addEventListener('click', () => fileEl?.click());

    fileEl?.addEventListener('change', async () => {
      const file = fileEl.files?.[0];
      if (!file) return;
      const oldHtml = pickBtn?.innerHTML || 'اختيار صورة من الجهاز';
      if (pickBtn) {
        pickBtn.disabled = true;
        pickBtn.innerHTML = '<span class="spinner"></span> جاري الضغط...';
      }
      infoEl.textContent = '⏳ جاري ضغط الصورة ورفعها...';
      try {
        const out = await compressImage(file);
        if (!out.base64) throw new Error('تعذّر تجهيز الصورة');
        const displayName = (file.name || 'auto-reply').slice(0, 120);
        const ok = await LC.saveSetting(AR_GID, {
          autoReply: {
            imageData: out.base64,
            imageMimeType: out.mimeType,
            imageName: displayName.replace(/\.[^.]+$/, '') + '.' + (out.ext || 'jpg'),
            imageUrl: '',
          },
        }, null);
        if (!ok) throw new Error('فشل الحفظ');
        deviceSrc = out.dataUrl;
        urlEl.value = '';
        infoEl.textContent = `✅ ${displayName} — ${Math.round(out.bytes / 1024)} KB`;
        removeBtn.disabled = false;
        renderPreview();
      } catch (err) {
        infoEl.textContent = '❌ ' + (err?.message || 'فشل رفع الصورة');
        LC.toast('فشل رفع الصورة: ' + (err?.message || ''), 'error');
      } finally {
        if (pickBtn) {
          pickBtn.disabled = false;
          pickBtn.innerHTML = oldHtml;
        }
        fileEl.value = '';
      }
    });

    urlEl?.addEventListener('change', async () => {
      const value = urlEl.value.trim();
      if (value && !/^https?:\/\/\S+$/i.test(value)) {
        LC.toast('الرابط يجب أن يبدأ بـ http:// أو https://', 'error');
        return;
      }
      const ok = await LC.saveSetting(AR_GID, {
        autoReply: { imageUrl: value, imageData: '', imageMimeType: '', imageName: '' },
      }, null);
      if (!ok) return;
      deviceSrc = '';
      infoEl.textContent = value ? 'صورة من رابط خارجي' : 'لا توجد صورة';
      removeBtn.disabled = !value;
      renderPreview();
    });

    removeBtn?.addEventListener('click', async () => {
      removeBtn.disabled = true;
      const ok = await LC.saveSetting(AR_GID, {
        autoReply: { imageUrl: '', imageData: '', imageMimeType: '', imageName: '' },
      }, null);
      if (!ok) {
        removeBtn.disabled = false;
        return;
      }
      deviceSrc = '';
      urlEl.value = '';
      infoEl.textContent = 'لا توجد صورة';
      renderPreview();
    });
  });
</script>

<%- include('layout-bottom') %>
