<%- include('layout-top', { title: 'سيرفراتي', activePage: 'dashboard' }) %>

<div class="page-header">
  <h1><i class="bi bi-server"></i> سيرفراتي</h1>
  <p>اختر السيرفر الذي تريد إدارته — <%= guilds.length %> سيرفر متاح</p>
</div>

<% if (!botStats || !botStats.totalGuilds) { %>
<div class="alert alert-warning mb-4">
  <i class="bi bi-exclamation-triangle me-1"></i>
  <strong>ملاحظة:</strong> البوت غير متصل حالياً — قد لا تُعرض بعض البيانات الحيّة. الإعدادات المحفوظة ستظل متاحة.
</div>
<% } %>

<!-- Bot status cards -->
<div class="grid-3 mb-4">
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--info-bg);color:var(--info);"><i class="bi bi-hdd-rack"></i></div>
    <div class="stat-info">
      <div class="stat-label">سيرفرات البوت</div>
      <div class="stat-value"><%= botStats?.totalGuilds || guilds.length %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--success-bg);color:var(--success);"><i class="bi bi-people"></i></div>
    <div class="stat-info">
      <div class="stat-label">إجمالي الأعضاء</div>
      <div class="stat-value"><%= (botStats?.totalUsers || 0).toLocaleString('en-US') %></div>
    </div>
  </div>
  <div class="stat-card">
    <div class="stat-icon" style="background:var(--purple-bg);color:var(--purple);"><i class="bi bi-activity"></i></div>
    <div class="stat-info">
      <div class="stat-label">حالة الاتصال</div>
      <div class="stat-value" style="font-size:18px;color:<%= botStats?.totalGuilds ? 'var(--success)' : 'var(--warning)' %>;">
        <%= botStats?.totalGuilds ? 'متصل ●' : 'غير متصل ○' %>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h5><i class="bi bi-grid-3x3-gap"></i> السيرفرات التي تملك فيها صلاحية الإدارة</h5>
    <a href="/auth/discord" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-repeat"></i> تحديث القائمة</a>
  </div>
  <div class="card-body">
    <% if (guilds.length === 0) { %>
      <div class="empty-state">
        <i class="bi bi-emoji-frown"></i>
        <h5>لا توجد سيرفرات</h5>
        <p>لم نعثر على أي سيرفر تملك فيه صلاحية الإدارة. تأكد أنك مدير في السيرفر.</p>
      </div>
    <% } else { %>
      <div class="grid-3">
        <% guilds.forEach(g => { %>
        <div class="guild-card">
          <% if (g.icon) { %>
            <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt="" onerror="this.style.display='none'">
          <% } else { %>
            <div class="avatar avatar-lg" style="background:linear-gradient(135deg,var(--accent),var(--purple));color:#fff;font-size:26px;"><%= g.name.charAt(0) %></div>
          <% } %>
          <div>
            <div class="guild-title"><%= g.name %></div>
            <div class="guild-meta">
              <% if (g.owner) { %><span class="badge bg-warning me-1">👑 مالك</span><% } %>
              <code style="font-size:11px;"><%= g.id %></code>
            </div>
          </div>
          <div class="guild-actions">
            <a href="/dashboard/<%= g.id %>" class="manage-btn text-decoration-none">إدارة</a>
            <button class="leave-btn" onclick="leaveGuild('<%= g.id %>', '<%= g.name %>')">مغادرة</button>
          </div>
        </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<script>
async function leaveGuild(id, name) {
  if (!confirm(`هل أنت متأكد من إخراج البوت من "${name}"؟`)) return;
  try {
    const res = await fetch('/api/guilds/' + id + '/leave', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({}) });
    if (res.ok) { showToast('تمت المغادرة ✅', 'success'); setTimeout(() => location.reload(), 1200); }
    else { const d = await res.json().catch(()=>({})); showToast(d.error || 'فشلت العملية — تأكد أن البوت متصل', 'danger'); }
  } catch (e) { showToast('البوت غير متصل حالياً', 'danger'); }
}
</script>

<%- include('layout-bottom') %>
