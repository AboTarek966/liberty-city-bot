<%- include('layout-top', { title: 'سيرفراتي', activePage: 'dashboard' }) %>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--primary),var(--cyan));display:grid;place-items:center;font-size:28px;"><i class="bi bi-collection"></i></div>
  <div>
    <div class="h-title">سيرفراتي</div>
    <div class="h-desc">إختر سيرفراً لإدارة الحماية والأنظمة والأعضاء — عائلك الإداري في مكان واحد</div>
    <div class="h-chips">
      <span class="chip purple"><i class="bi bi-collection"></i> <%= guilds.length %> سيرفر</span>
      <span class="chip blue"><i class="bi bi-robot"></i> البوت يعمل</span>
    </div>
  </div>
</div>

<% if (guilds.length === 0) { %>
<div class="card"><div class="card-body">
  <div class="empty">
    <i class="bi bi-emoji-frown"></i>
    <h4>لا توجد سيرفرات بصلاحية إدارة</h4>
    <p>تحتاج صلاحية "Manage Server" أو تملك السيرفر لظهوره هنا. أضف البوت لسيرفرك ثم أعد الدخول.</p>
    <a class="btn primary mt-3" href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=1395867970447&scope=bot%20applications.commands" target="_blank"><i class="bi bi-plus-lg"></i> أضف البوت لسيرفر جديد</a>
  </div>
</div></div>
<% } else { %>
<div class="grid-guild">
  <% guilds.forEach(g => { %>
    <a class="gcard" href="/dashboard/<%= g.id %>">
      <% if (g.icon) { %>
        <img src="https://cdn.discordapp.com/icons/<%= g.id %>/<%= g.icon %>.png?size=128" alt="">
      <% } else { %>
        <div class="g-letter"><%= (g.name || '?').charAt(0) %></div>
      <% } %>
      <div>
        <div class="g-name"><%= g.name %></div>
        <div style="font-size:11px;color:var(--text-3);font-weight:700;margin-top:3px;"><code class="code-cell" style="color:var(--text-3);"><%= g.id %></code></div>
      </div>
      <div class="g-meta">
        <% if (g.owner) { %><span class="chip green"><i class="bi bi-person-fill-gear"></i> مالك</span><% } %>
        <span class="chip blue"><i class="bi bi-shield-check"></i> بوت موجود</span>
      </div>
      <div class="enter"><i class="bi bi-arrow-left"></i> إدارة السيرفر</div>
    </a>
  <% }) %>
</div>
<% } %>
<% if (guilds.length > 0 && !guilds.some(g => g.owner)) { %>
<div class="banner blue mt-4"><i class="bi bi-info-circle"></i> يعمل لديك صلاحية إدارة على السيرفرات أدناه — تفعيل الحماية يتطلب صلاحيات البوت كاملة في سيرفرك.</div>
<% } %>

<%- include('layout-bottom') %>
