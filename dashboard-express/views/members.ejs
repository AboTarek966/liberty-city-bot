<%- include('layout-top', { title: 'الأعضاء', activePage: 'members' }) %>

<% const GID = guild.id; %>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--blue),var(--cyan));display:grid;place-items:center;font-size:26px;"><i class="bi bi-people"></i></div>
  <div>
    <div class="h-title">إدارة الأعضاء
      <span class="chip blue"><span class="num"><%= members?.total ?? '—' %></span> عضو</span>
    </div>
    <div class="h-desc">قائمة حية من البوت + إجراءات فورية: تحذير · كتم · طرد · حظر · رولات</div>
  </div>
  <div class="h-actions btn-group">
    <button class="btn primary" id="refreshBtn" onclick="loadMembers()"><i class="bi bi-arrow-repeat"></i> تحديث حي من البوت</button>
  </div>
</div>

<% if (botOnline !== true) { %>
<div class="banner warn"><i class="bi bi-wifi-off"></i> البيانات الحية تأتي من طوابير الأوامر — لو حملت القائمة فاضية اضغط «تحديث حي» أو تأكد أن البوت متصل.</div>
<% } %>

<div class="card">
  <div class="card-body" style="display:flex;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--line);">
    <input id="mSearch" class="inp" style="max-width:320px;" placeholder="🔎 بحث باسم العضو…">
    <select id="mFilter" class="inp" style="max-width:190px;">
      <option value="">الكل</option>
      <option value="human">أعضاء (بدون بوتات)</option>
      <option value="bot">بوتات</option>
      <option value="online">متصلون</option>
    </select>
    <span class="chip cyan" id="mCount" style="margin-inline-start:auto;">—</span>
  </div>
  <div class="card-body tight" id="mList">
    <% (members?.list || []).slice(0, 60).forEach(m => { %>
      <div class="member-row skeleton-row skel"><div class="avatar-wrap"></div><div class="m-info"><div class="m-name">تحميل…</div></div></div>
    <% }) %>
    <% if (!(members?.list || []).length) { %>
      <div class="empty"><i class="bi bi-people"></i><h4>قائمة فارغة</h4><p>اضغط «تحديث حي من البوت» لطلب قائمة الأعضاء عبر طابور الأوامر</p></div>
    <% } %>
  </div>
  <div style="padding:14px 18px;border-top:1px solid var(--line);display:flex;gap:10px;align-items:center;">
    <button class="btn" id="moreBtn">عرض المزيد</button>
    <span class="text-dim" style="font-size:11.5px;">يُعرض 60 عضواً لكل مجموعة ثم «عرض المزيد»</span>
  </div>
</div>

<script>
  const GID = '<%= GID %>';
  let all = [];
  let shown = 0;
  const PAGE = 60;

  function avatarUrl(m) { return m.avatar ? `https://cdn.discordapp.com/avatars/${m.id}/${m.avatar}.png?size=64` : null; }
  function presenceClass(p) { return ['online', 'idle', 'dnd'].includes(p) ? p : 'offline'; }
  function presenceText(p) { return { online: 'متصل', idle: 'خامل', dnd: 'مشغول', offline: 'غير متصل' }[p] || 'غير معروف'; }
  function timeAgo(d) {
    if (!d) return '—';
    const s = Math.floor((Date.now() - new Date(d)) / 1000);
    const u = [['سنة', 31536000], ['شهر', 2592000], ['يوم', 86400], ['ساعة', 3600], ['دقيقة', 60]];
    for (const [lbl, sec] of u) { if (s >= sec) return `منذ ${Math.floor(s / sec)} ${lbl}`; }
    return 'الآن';
  }

  function row(m) {
    const roll = (m.roles || []);
    const rolesHtml = roll.slice(0, 4).map(r => `<span class="mini-role" style="${r.color && r.color !== '#000000' ? `color:${r.color}` : ''}">${LC.esc(r.name)}</span>`).join('') +
      (roll.length > 4 ? `<span class="mini-role more">+${roll.length - 4}</span>` : '');
    return `
    <div class="member-row" data-id="${m.id}">
      <div class="avatar-wrap">
        ${m.avatar ? `<img src="${avatarUrl(m)}" loading="lazy">` : `<div class="m-letter">${LC.esc((m.username || '?').charAt(0).toUpperCase())}</div>`}
        <span class="presence ${presenceClass(m.presence)}"></span>
      </div>
      <div class="m-info">
        <div class="m-name">${LC.esc(m.nickname || m.username || m.id)} ${m.bot ? '<span class="bot-tag">BOT</span>' : ''} <span class="code-cell" style="color:var(--text-3);font-size:10.5px;">${m.id}</span></div>
        <div class="m-sub"><i class="bi bi-circle-fill" style="color:${m.presence === 'online' ? 'var(--green)' : 'var(--text-3)'};font-size:6px;"></i> ${presenceText(m.presence)} · انضم ${timeAgo(m.joinedAt)}${m.dbProfile ? ' · من القاعدة' : ''}</div>
        <div class="m-roles">${rolesHtml}</div>
      </div>
      <button class="btn sm" onclick="openMember('${m.id}')"><i class="bi bi-eye"></i> بروفايل</button>
    </div>`;
  }

  function render(reset = true) {
    const q = document.getElementById('mSearch').value.trim().toLowerCase();
    const f = document.getElementById('mFilter').value;
    let list = all;
    if (f === 'bot') list = list.filter(m => m.bot);
    if (f === 'human') list = list.filter(m => !m.bot);
    if (f === 'online') list = list.filter(m => ['online', 'idle', 'dnd'].includes(m.presence));
    if (q) list = list.filter(m => (m.username || '').toLowerCase().includes(q) || String(m.id).includes(q));
    const slice = reset ? list.slice(0, PAGE) : list.slice(0, shown + PAGE);
    shown = slice.length;
    document.getElementById('mList').innerHTML = slice.length ? slice.map(row).join('') :
      `<div class="empty"><i class="bi bi-search"></i><h4>لا نتائج</h4><p>جرّب بحثاً آخر أو أزل الفلاتر</p></div>`;
    document.getElementById('mCount').textContent = `${list.length} نتيجة · معروض ${slice.length}`;
    document.getElementById('moreBtn').style.display = shown < list.length ? 'inline-flex' : 'none';
  }

  // initial DB profile render (offline quick load)
  const initial = <%= JSON.stringify((members?.list || []).slice(0, 60).map(m => ({ id: m.id, username: m.username, avatar: m.avatar, presence: m.presence, roles: m.roles, joinedAt: m.joinedAt, bot: m.bot, dbProfile: m.dbProfile }))) %>;
  if (initial.length) { all = initial; render(); }

  async function loadMembers() {
    const btn = document.getElementById('refreshBtn');
    btn.disabled = true; btn.innerHTML = '<span class="spinner"></span> جاري الحصول على الأعضاء…';
    try {
      const data = await LC.api(`/api/guilds/${GID}/members`);
      all = data.list || [];
      LC.toast(`تم تحميل ${all.length} عضو مباشرة من البوت ✅`);
      render();
    } catch (e) {
      LC.toast('تعذر الحصول من البوت: ' + e.message, 'error', 6000);
    } finally {
      btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-repeat"></i> تحديث حي من البوت';
    }
  }

  document.getElementById('mSearch').addEventListener('input', () => render());
  document.getElementById('mFilter').addEventListener('change', () => render());
  document.getElementById('moreBtn').addEventListener('click', () => render(false));

  async function openMember(id) {
    const m = LC.modal({
      title: 'بروفايل العضو',
      body: `<div style="display:flex;gap:14px;align-items:center;margin-bottom:14px;">
        <div class="spinner"></div><span class="text-dim" style="font-weight:700;">جاري الجلب من البوت…</span></div>`,
      actions: [],
    });
    try {
      const p = await LC.api(`/api/guilds/${GID}/members/${id}`);
      const warn = p.warnings || [];
      const roles = p.roles || [];
      m.querySelector('.modal-body').innerHTML = `
        <div style="display:flex;gap:14px;align-items:center;margin-bottom:16px;">
          ${p.avatar ? `<img src="https://cdn.discordapp.com/avatars/${p.id}/${p.avatar}.png?size=80" style="width:64px;height:64px;border-radius:50%;">` : `<div class="m-letter" style="width:64px;height:64px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--cyan));display:grid;place-items:center;font-size:24px;font-weight:900;">${LC.esc((p.username || '?').charAt(0))}</div>`}
          <div>
            <div class="fw800" style="font-size:16px;">${LC.esc(p.username || id)} ${p.bot ? '<span class="bot-tag">BOT</span>' : ''}</div>
            <div class="text-dim" style="font-size:11.5px;">انضم ${timeAgo(p.joinedAt)} · أنشأ الحساب ${timeAgo(p.createdAt)} · الحالة: ${presenceText(p.presence)}</div>
            <div class="code-cell" style="font-size:10.5px;color:var(--text-3);">${p.id}</div>
          </div>
        </div>
        ${roles.length ? `<div class="mb-3"><div class="text-mid fw800" style="font-size:12px;margin-bottom:6px;">الرولات (${roles.length})</div><div class="flex flex-wrap">${roles.map(r => `<span class="mini-role" style="${r.color && r.color !== '#000000' ? `color:${r.color}` : ''}">${LC.esc(r.name)}</span>`).join('')}</div></div>` : ''}
        <div class="mb-3">
          <div class="text-mid fw800" style="font-size:12px;margin-bottom:6px;">التحذيرات (${warn.length})</div>
          ${warn.length ? warn.slice(0, 4).map(w => `<div style="font-size:11.5px;color:var(--text-2);border-inline-start:2px solid var(--amber);padding-inline-start:9px;margin-bottom:5px;">⚠️ ${LC.esc(w.reason || 'بدون سبب')} <small class="text-dim">— ${timeAgo(w.createdAt)}</small></div>`).join('') : '<div class="text-dim" style="font-size:11.5px;">نظيف بدون تحذيرات ✨</div>'}
        </div>
        <div class="sec-title"><i class="bi bi-plus-slash-minus"></i> إدارة الرولات</div>
        <div class="flex" style="gap:8px;">
          <select id="r_sel" class="inp" style="max-width:220px;" placeholder="اختر رول"></select>
          <button class="btn sm green" onclick="giveRole('${id}')"><i class="bi bi-plus-lg"></i> إضافة</button>
          <button class="btn sm danger" onclick="takeRole('${id}')"><i class="bi bi-dash-lg"></i> إزالة</button>
        </div>
        <div class="sec-title"><i class="bi bi-hammer"></i> إجراءات الإشراف</div>
        <div class="flex flex-wrap" style="gap:8px;">
          <button class="btn sm warn" onclick="warnUser('${id}')"><i class="bi bi-exclamation-square"></i> تحذير</button>
          <button class="btn sm" onclick="timeoutUser('${id}')"><i class="bi bi-hourglass-split"></i> توقيت</button>
          <button class="btn sm danger" onclick="kickUser('${id}')"><i class="bi bi-door-open"></i> طرد</button>
          <button class="btn sm danger" onclick="banUser('${id}')"><i class="bi bi-hammer"></i> حظر</button>
        </div>`;
      LC.loadRoles(GID, ['r_sel']);
    } catch (e) {
      m.querySelector('.modal-body').innerHTML = `<div class="empty"><i class="bi bi-slash-circle"></i><h4>تعذر الجلب</h4><p>${LC.esc(e.message)} — تأكد أن البوت متصل</p></div>`;
    }
  }

  async function giveRole(id) {
    const roleId = document.getElementById('r_sel').value;
    if (!roleId) return LC.toast('اختر رولاً أولاً', 'warn');
    try { await LC.api(`/api/guilds/${GID}/members/${id}/roles`, { method: 'POST', body: { roleId } }); LC.toast('أُضيف الرول ✅'); openMemberRefresh(id); }
    catch (e) { LC.toast(e.message, 'error'); }
  }
  async function takeRole(id) {
    const roleId = document.getElementById('r_sel').value;
    if (!roleId) return LC.toast('اختر رولاً أولاً', 'warn');
    try { await LC.api(`/api/guilds/${GID}/members/${id}/roles`, { method: 'DELETE', body: { roleId } }); LC.toast('أزيل الرول ✅'); openMemberRefresh(id); }
    catch (e) { LC.toast(e.message, 'error'); }
  }
  function openMemberRefresh(id) { LC.close(); setTimeout(() => openMember(id), 350); }

  async function warnUser(id) {
    const reason = prompt('سبب التحذير:', '');
    if (reason === null) return;
    try { await LC.api(`/api/guilds/${GID}/members/${id}/warn`, { method: 'POST', body: { reason } }); LC.toast('أُرسل التحذير ✅'); openMemberRefresh(id); }
    catch (e) { LC.toast(e.message, 'error'); }
  }
  async function timeoutUser(id) {
    const mins = prompt('مدة التوقيت بالدقائق (0 = إلغاء):', '60');
    if (mins === null) return;
    try { await LC.api(`/api/guilds/${GID}/members/${id}/timeout`, { method: 'POST', body: { duration: Number(mins) * 60000 } }); LC.toast('تم ⏱'); openMemberRefresh(id); }
    catch (e) { LC.toast(e.message, 'error'); }
  }
  async function kickUser(id) {
    if (!await LC.confirmBox('طرد عضو', 'سيفقد هذا العضو دخوله للسيرفر — تأكيد؟')) return;
    try { await LC.api(`/api/guilds/${GID}/members/${id}/kick`, { method: 'POST', body: { reason: 'طرد من لوحة التحكم' } }); LC.toast('تم الطرد'); LC.close(); }
    catch (e) { LC.toast(e.message, 'error'); }
  }
  async function banUser(id) {
    if (!await LC.confirmBox('حظر عضو', 'الحظر يمنعه نهائياً من السيرفر — تأكيد؟')) return;
    try { await LC.api(`/api/guilds/${GID}/members/${id}/ban`, { method: 'POST', body: { reason: 'حظر من لوحة التحكم' } }); LC.toast('تم الحظر'); LC.close(); }
    catch (e) { LC.toast(e.message, 'error'); }
  }
</script>

<%- include('layout-bottom') %>
