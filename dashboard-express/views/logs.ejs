<%- include('layout-top', { title: 'السجلات الإشرافية', activePage: 'logs' }) %>

<% const GID = guild.id; const allCases = (logs && logs.logs) ? logs.logs : []; %>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--red),var(--blue));display:grid;place-items:center;font-size:26px;"><i class="bi bi-journal-text"></i></div>
  <div>
    <div class="h-title">السجلات الإشرافية
      <span class="chip purple"><%= allCases.length %> إجراء مسجل</span>
    </div>
    <div class="h-desc">كل تحذير/طرد/حظر/كتم مسجل مع الكيس والسبب — من أي مكان نُفذ (بوت/لوحة)</div>
  </div>
</div>

<div class="card">
  <div class="card-body" style="display:flex;gap:10px;flex-wrap:wrap;border-bottom:1px solid var(--line);">
    <input id="lSearch" class="inp" style="max-width:300px;" placeholder="🔎 بحث بمعرف المستخدم/السبب…">
    <select id="lType" class="inp" style="max-width:170px;">
      <option value="">كل الأنواع</option>
      <% [['warn', 'تحذير'], ['kick', 'طرد'], ['ban', 'حظر'], ['softban', 'ناعم'], ['mute', 'كتم'], ['timeout', 'توقيت'], ['note', 'ملاحظة'], ['role_add', 'إضافة رول'], ['role_remove', 'إزالة رول']].forEach(t => { %><option value="<%= t[0] %>"><%= t[1] %></option><% }) %>
    </select>
    <span class="chip cyan" style="margin-inline-start:auto;" id="lCount"><%= allCases.length %></span>
  </div>
  <div style="overflow:auto;">
    <% if (!allCases.length) { %>
      <div class="empty"><i class="bi bi-journal"></i><h4>لا سجلات بعد</h4><p>سيُسجل البوت كل إجراء إشرافي هنا تلقائياً</p></div>
    <% } else { %>
      <table class="tbl" id="logTable">
        <thead><tr>
          <th>الكيس</th><th>النوع</th><th>الهدف</th><th>المراقب</th><th>السبب</th><th>التاريخ</th><th>الحالة</th>
        </thead>
        <tbody>
          <% const T = { warn: ['exclamation-triangle', 'amber'], kick: ['door-open', 'amber'], ban: ['hammer', 'red'], softban: ['brush', 'amber'], mute: ['mic-mute', 'blue'], unmute: ['mic', 'green'], timeout: ['hourglass-split', 'amber'], untimeout: ['arrow-counterclockwise', 'green'], note: ['sticky', 'cyan'], role_add: ['person-plus', 'green'], role_remove: ['person-dash', 'red'] }; %>
          <% allCases.slice(0, 300).forEach(c => { const tg = T[c.type] || ['shield', 'cyan']; %>
          <tr data-search="<%= ((c.targetId || '') + ' ' + (c.reason || '')).toLowerCase() %>" data-type="<%= c.type || '' %>">
            <td class="num text-dim">#<%= c.caseId ?? '—' %></td>
            <td><span class="chip <%= tg[1] %>"><i class="bi bi-<%= tg[0] %>"></i> <%= c.type %></span></td>
            <td><span class="u-cell"><code class="code-cell"><%= c.targetId || '—' %></code></span></td>
            <td class="code-cell"><%= c.moderatorId || '—' %></td>
            <td style="max-width:250px;"><%= (c.reason || 'بدون سبب') %></td>
            <td class="text-dim" style="white-space:nowrap;"><%= c.createdAt ? new Date(c.createdAt).toLocaleString('ar-EG', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : '—' %></td>
            <td><span class="chip <%= c.active ? 'green' : '' %>"><%= c.active ? 'نشط' : 'انتهى' %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<script>
  document.getElementById('lSearch').addEventListener('input', apply);
  document.getElementById('lType').addEventListener('change', apply);
  function apply() {
    const q = document.getElementById('lSearch').value.trim().toLowerCase();
    const t = document.getElementById('lType').value;
    let vis = 0;
    $$('#logTable tbody tr').forEach(tr => {
      const ok = (!q || tr.dataset.search.includes(q)) && (!t || tr.dataset.type === t);
      tr.style.display = ok ? '' : 'none';
      if (ok) vis++;
    });
    document.getElementById('lCount').textContent = vis;
  }
</script>

<%- include('layout-bottom') %>
