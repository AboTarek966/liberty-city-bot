<%- include('layout-top', { title: 'السجلات', activePage: 'logs' }) %>

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
  <div>
    <h1 class="h3 fw-bold mb-1">
      <i class="bi bi-file-text me-2 text-primary"></i>
      سجل الإشراف
    </h1>
    <p class="text-muted mb-0">سجل جميع إجراءات الإشراف: تحذيرات، طرود، حظر، إلخ</p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <select class="form-select form-select-sm" style="width: auto;" id="logTypeFilter" onchange="filterLogs()">
      <option value="">جميع الأنواع</option>
      <option value="warn">تحذير ⚠️</option>
      <option value="kick">طرد 🚪</option>
      <option value="ban">حظر 🚫</option>
      <option value="unban">فك الحظر ✅</option>
      <option value="mute">كتم 🔇</option>
      <option value="unmute">فك الكتم 🔊</option>
      <option value="timeout">مهلة ⏱️</option>
      <option value="softban">حظر مؤقت 🔄</option>
      <option value="note">ملاحظة 📝</option>
    </select>
    <input type="text" class="form-control form-control-sm" style="width: 200px;" id="logSearch" placeholder="بحث بالمستخدم..." oninput="filterLogs()">
    <button class="btn btn-primary btn-sm" onclick="refreshLogs()">
      <i class="bi bi-arrow-clockwise me-1"></i> تحديث
    </button>
  </div>
</div>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
  <% const stats = { warn: 0, kick: 0, ban: 0 }; (logs?.logs || []).forEach(l => { if (stats[l.type] !== undefined) stats[l.type]++; }); %>
  <div class="col-12 col-md-4">
    <div class="card stat-card">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-icon bg-warning bg-opacity-20 text-warning" style="width: 50px; height: 50px; border-radius: 12px;">
          <i class="bi bi-exclamation-triangle fs-3"></i>
        </div>
        <div>
          <div class="text-muted small">تحذيرات</div>
          <div class="fw-bold fs-4"><%= stats.warn %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="card stat-card">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-icon bg-danger bg-opacity-20 text-danger" style="width: 50px; height: 50px; border-radius: 12px;">
          <i class="bi bi-door-open fs-3"></i>
        </div>
        <div>
          <div class="text-muted small">طرود</div>
          <div class="fw-bold fs-4"><%= stats.kick %></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-12 col-md-4">
    <div class="card stat-card">
      <div class="card-body d-flex align-items-center gap-3">
        <div class="stat-icon bg-dark bg-opacity-20 text-dark" style="width: 50px; height: 50px; border-radius: 12px;">
          <i class="bi bi-x-circle fs-3"></i>
        </div>
        <div>
          <div class="text-muted small">حظر</div>
          <div class="fw-bold fs-4"><%= stats.ban %></div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0" id="logsTable">
        <thead>
          <tr>
            <th style="width: 70px;">الرقم</th>
            <th style="width: 90px;">النوع</th>
            <th>الهدف</th>
            <th>المشرف</th>
            <th>السبب</th>
            <th style="width: 160px;">التاريخ</th>
          </tr>
        </thead>
        <tbody>
          <% const logsList = logs?.logs || logs || []; const typeIcons = { warn: 'exclamation-triangle text-warning', kick: 'door-open text-danger', ban: 'x-circle text-dark', unban: 'check-circle text-success', mute: 'volume-mute text-info', unmute: 'volume-up text-success', timeout: 'clock text-warning', softban: 'arrow-repeat text-secondary', note: 'sticky text-primary', role_add: 'person-plus text-success', role_remove: 'person-dash text-danger' }; const typeLabels = { warn: 'تحذير', kick: 'طرد', ban: 'حظر', unban: 'فك حظر', mute: 'كتم', unmute: 'فك كتم', timeout: 'مهلة', softban: 'حظر مؤقت', note: 'ملاحظة', role_add: 'إضافة رول', role_remove: 'حذف رول' }; %>
          <% if (logsList.length > 0) { logsList.forEach((l, i) => { %>
          <tr data-type="<%= l.type %>" data-target="<%= l.targetId %>">
            <td class="fw-bold">#<%= l.caseId || i + 1 %></td>
            <td>
              <span class="badge bg-transparent border">
                <i class="bi bi-<%= (typeIcons[l.type] || 'circle').split(' ')[0] %> <%= (typeIcons[l.type] || '').split(' ')[1] %> me-1"></i>
                <%= typeLabels[l.type] || l.type %>
              </span>
            </td>
            <td><code class="small"><%= l.targetId %></code></td>
            <td><code class="small"><%= l.moderatorId %></code></td>
            <td class="small"><%= l.reason || '—' %></td>
            <td class="small"><%= l.createdAt ? new Date(l.createdAt).toLocaleString('ar-SA') : '—' %></td>
          </tr>
          <% }) } else { %>
          <tr><td colspan="6" class="text-center py-5 text-muted">
            <i class="bi bi-file-text" style="font-size: 2rem;"></i>
            <p class="mt-2">لا توجد سجلات</p>
          </td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<% if (logs?.pages > 1) { %>
<div class="d-flex justify-content-center mt-4">
  <nav>
    <ul class="pagination">
      <% for (let p = 1; p <= logs.pages; p++) { %>
      <li class="page-item <%= p === logs.page ? 'active' : '' %>">
        <a class="page-link" href="?page=<%= p %>"><%= p %></a>
      </li>
      <% } %>
    </ul>
  </nav>
</div>
<% } %>

<script>
function filterLogs() {
  const type = document.getElementById('logTypeFilter').value;
  const search = document.getElementById('logSearch').value.toLowerCase();
  const rows = document.querySelectorAll('#logsTable tbody tr');
  rows.forEach(row => {
    const rowType = row.dataset.type;
    const rowTarget = (row.dataset.target || '').toLowerCase();
    const matchType = !type || rowType === type;
    const matchSearch = !search || rowTarget.includes(search);
    row.style.display = (matchType && matchSearch) ? '' : 'none';
  });
}
async function refreshLogs() { location.reload(); }
</script>

<%- include('layout-bottom') %>