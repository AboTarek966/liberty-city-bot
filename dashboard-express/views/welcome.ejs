<%- include('layout-top', { title: 'الترحيب والمغادرة', activePage: 'welcome' }) %>

<% const W = settings?.welcome || {}; const LV = settings?.leave || {}; const GID = guild.id; %>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--pink),var(--primary));display:grid;place-items:center;font-size:26px;"><i class="bi bi-door-open"></i></div>
  <div>
    <div class="h-title">الترحيب والمغادرة
      <span class="chip <%= W.enabled ? 'green' : '' %>">ترحيب: <%= W.enabled ? 'ON' : 'OFF' %></span>
      <span class="chip <%= LV.enabled ? 'green' : '' %>">مغادرة: <%= LV.enabled ? 'ON' : 'OFF' %></span>
    </div>
    <div class="h-desc">رسائل دخول وخروج أنيقة مع بطاقة قابلة للتخصيص + رسالة خاصة للعضو</div>
  </div>
  <div class="h-actions btn-group">
    <button class="btn" onclick="testWelcome(this)"><i class="bi bi-send"></i> تجربة الآن</button>
  </div>
</div>

<div class="grid-2 mb-4">
  <!-- الترحيب -->
  <div class="card">
    <div class="card-head">
      <h3><i class="bi bi-person-plus"></i> رسالة الترحيب</h3>
      <div class="head-side">
        <span class="chip <%= W.enabled ? 'green' : '' %>"><%= W.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="welcome.enabled" <%= W.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="field mb-3">
        <label>قناة الترحيب</label>
        <select class="inp chan-sel" data-text="welcome.channelId" data-types="0,5" data-value="<%= W.channelId || '' %>"></select>
      </div>
      <div class="field mb-3">
        <label>نص الرسالة <span class="hint">المتغيرات: {user} الاسم · {server} السيرفر · {count} العدد</span></label>
        <textarea class="inp" style="min-height:80px;" data-text="welcome.message" placeholder="أهلاً بك {user} في {server}! أصبحت عضوناً رقم {count} 🎉"><%= W.message || '' %></textarea>
      </div>
      <div class="form-row mb-3">
        <div class="field"><label>عنوان الإندبيد</label><input class="inp" data-text="welcome.embedTitle" value="<%= W.embedTitle || 'أهلاً وسهلاً' %>"></div>
        <div class="field"><label>لون الإندبيد (HEX)</label><input class="inp code-cell" data-text="welcome.embedColor" value="<%= W.embedColor || '#7c5cff' %>" maxlength="8"></div>
      </div>
      <div class="sec-title"><i class="bi bi-envelope"></i> الرسالة الخاصة (DM)</div>
      <label class="field-check mb-3" style="max-width:380px;"><input type="checkbox" data-toggle="welcome.dmEnabled" <%= W.dmEnabled ? 'checked' : '' %>><span>أرسل رسالة خاصة للعضو الجديد</span></label>
      <div class="field">
        <label>نص DM</label>
        <textarea class="inp" style="min-height:70px;" data-text="welcome.dmMessage" placeholder="مرحباً {user}! هذه تعليمات السيرفر الأساسية…"><%= W.dmMessage || '' %></textarea>
      </div>
      <div class="sec-title"><i class="bi bi-card-image"></i> بطاقة الترحيب (رسم على صورة)</div>
      <label class="field-check mb-3" style="max-width:380px;"><input type="checkbox" data-toggle="welcome.card.enabled" <%= W.card?.enabled ? 'checked' : '' %>><span>توليد بطاقة بالصورة والاسم والرقم</span></label>
      <div class="field">
        <label>رابط خلفية البطاقة <span class="hint">فارغ = خلفية افتراضية أنيقة</span></label>
        <input class="inp code-cell" data-text="welcome.card.backgroundUrl" value="<%= W.card?.backgroundUrl || '' %>" placeholder="https://…png">
      </div>
    </div>
  </div>

  <!-- المغادرة -->
  <div class="card">
    <div class="card-head">
      <h3><i class="bi bi-person-dash"></i> رسالة المغادرة</h3>
      <div class="head-side">
        <span class="chip <%= LV.enabled ? 'green' : '' %>"><%= LV.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="leave.enabled" <%= LV.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="field mb-3">
        <label>قناة المغادرة</label>
        <select class="inp chan-sel" data-text="leave.channelId" data-types="0,5" data-value="<%= LV.channelId || '' %>"></select>
      </div>
      <div class="field mb-3">
        <label>نص المغادرة <span class="hint">المتغيرات: {user} · {server} · {count}</span></label>
        <textarea class="inp" style="min-height:80px;" data-text="leave.message" placeholder="غادرنا {user}… أصبحنا {count} 👋"><%= LV.message || '' %></textarea>
      </div>
      <div class="field"><label>لون إندبيد المغادرة</label><input class="inp code-cell" data-text="leave.embedColor" value="<%= LV.embedColor || '#ff5c7a' %>" maxlength="8"></div>

      <div class="sec-title"><i class="bi bi-eye"></i> معاينة الترجمة</div>
      <div class="card" style="box-shadow:none;background:var(--bg-soft);">
        <div class="card-body" style="padding:14px;font-size:12.5px;">
          <div class="flex">
            <div class="m-letter" style="width:38px;height:38px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--cyan));display:grid;place-items:center;font-weight:900;color:#fff;">م</div>
            <div>
              <div class="fw800">عضو تجريبي</div>
              <div class="text-dim" style="font-size:11px;">سيظهر نص الرسائل هكذا مع الاسم والعدد</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="banner blue"><i class="bi bi-info-circle"></i> البوت يرسل الترحيب تلقائياً عند التفعيل — زر «تجربة الآن» فوق يطلب من البوت إرسال رسالة تجريبية في قناة الترحيب مباشرة.</div>

<script>
  const GID = '<%= GID %>';
  document.addEventListener('DOMContentLoaded', async () => {
    await LC.loadChannels(GID, $$('.chan-sel'));
  });
  async function testWelcome(btn) {
    const ok = await LC.confirmBox('تجربة رسالة الترحيب', 'سيأمر لوحة التحكم البوت بإرسال رسالة تجريبية في قناة الترحيب — متابعة؟', { danger: false, okLabel: 'أرسل' });
    if (!ok) return;
    const msg = document.querySelector('textarea[data-text="welcome.message"]')?.value;
    const chan = document.querySelector('select[data-text="welcome.channelId"]')?.value;
    if (!chan) return LC.toast('حدد قناة الترحيب أولاً', 'warn');
    try {
      await LC.api(`/api/guilds/${GID}/command`, { method: 'POST', body: { command: 'welcome_test', payload: { channelId: chan, message: msg, actor: '<%= user?.username || 'لوحة التحكم' %>' } } });
      LC.toast('أُرسل أمر التجربة للبوت — يصل خلال ثوانٍ ✅', 'success', 5000);
    } catch (e) { LC.toast('فشل: ' + e.message, 'error'); }
  }
</script>

<%- include('layout-bottom') %>
