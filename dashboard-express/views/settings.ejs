<script>
async function saveAllSettings() {
  const data = {};
  // General
  data.prefix = document.getElementById('genPrefix').value;
  data.language = document.getElementById('genLang').value;
  data.timezone = document.getElementById('genTz').value;
  // AutoMod
  data.automod = {
    enabled: document.getElementById('amEnabled').checked,
    badWords: document.getElementById('amBadWords').value.split('\n').map(x=>x.trim()).filter(x=>x),
    badWordsAction: document.getElementById('amBadWordsAction').value,
    badWordsDuration: +document.getElementById('amBadWordsDuration').value,
    zalgoEnabled: document.getElementById('amZalgo').checked,
    zalgoAction: document.getElementById('amZalgoAction').value,
    ignoredRoles: document.getElementById('amIgnoredRoles').value.split(',').map(x=>x.trim()).filter(x=>x),
    ignoredChannels: document.getElementById('amIgnoredChannels').value.split(',').map(x=>x.trim()).filter(x=>x),
  };
  // Leveling
  const rewards = [];
  document.querySelectorAll('#levelRewards .input-group').forEach(el => {
    const level = el.querySelector('[data-field="level"]').value;
    const roleId = el.querySelector('[data-field="roleId"]').value;
    if (level && roleId) rewards.push({ level: +level, roleId });
  });
  data.leveling = {
    enabled: document.getElementById('lvEnabled').checked,
    xpPerMessage: +document.getElementById('lvXpPerMsg').value,
    xpCooldown: +document.getElementById('lvXpCooldown').value,
    xpGainMultiplier: +document.getElementById('lvMultiplier').value,
    voiceXpPerMinute: +document.getElementById('lvVoiceXp').value,
    levelUpChannelId: document.getElementById('lvLevelChannel').value,
    levelUpMessage: document.getElementById('lvLevelMsg').value,
    levelUpStyle: document.getElementById('lvLevelStyle').value,
    levelUpTitle: document.getElementById('lvLevelTitle').value,
    levelUpColor: document.getElementById('lvLevelColor').value,
    levelRewards: rewards,
    ignoredChannels: document.getElementById('lvIgnoredChannels').value.split(',').map(x=>x.trim()).filter(x=>x),
    ignoredRoles: document.getElementById('lvIgnoredRoles').value.split(',').map(x=>x.trim()).filter(x=>x),
  };
  data.autorole = {
    enabled: document.getElementById('arEnabled').checked,
    roleId: document.getElementById('arRoleId').value,
  };
  // Verification
  data.verification = {
    enabled: document.getElementById('verEnabled').checked,
    channelId: document.getElementById('verChannel').value,
    roleId: document.getElementById('verRole').value,
    title: document.getElementById('verTitle').value,
    description: document.getElementById('verDesc').value,
    buttonLabel: document.getElementById('verBtnLabel').value,
    buttonEmoji: document.getElementById('verBtnEmoji').value,
  };
  // Logging
  const logTypes = [];
  document.querySelectorAll('[id^="lg_"]').forEach(el => { if (el.checked) logTypes.push(el.value); });
  data.logging = {
    enabled: document.getElementById('lgEnabled').checked,
    channelId: document.getElementById('lgChannel').value,
    types: logTypes,
    ignoredChannels: document.getElementById('lgIgnoredChannels').value.split(',').map(x=>x.trim()).filter(x=>x),
    ignoredRoles: document.getElementById('lgIgnoredRoles').value.split(',').map(x=>x.trim()).filter(x=>x),
  };
  // Music
  data.music = {
    enabled: document.getElementById('muEnabled').checked,
    defaultVolume: +document.getElementById('muVolume').value,
    maxQueueSize: +document.getElementById('muMaxQueue').value,
    autoplay: document.getElementById('muAutoplay').checked,
    allowDJ: document.getElementById('muAllowDJ').checked,
    djRoleId: document.getElementById('muDjRole').value,
  };
  // Warn Roles
  const memberIds = [];
  document.querySelectorAll('[data-field="memberIds"]').forEach(el => { if (el.value) memberIds.push(el.value); });
  data.warnRoles = {
    memberIds,
    adminSequential: {
      role1Id: document.getElementById('wrRole1').value,
      role2Id: document.getElementById('wrRole2').value,
      role3Id: document.getElementById('wrRole3').value,
    }
  };
  // Tickets
  data.tickets = {
    categoryId: document.getElementById('tkCategory').value,
    logChannelId: document.getElementById('tkLogChannel').value,
    transcriptChannelId: document.getElementById('tkTranscript').value,
    supportRoleIds: document.getElementById('tkSupportRoles').value.split(',').map(x=>x.trim()).filter(x=>x),
    adminRoleIds: document.getElementById('tkAdminRoles').value.split(',').map(x=>x.trim()).filter(x=>x),
    maxPerUser: +document.getElementById('tkMaxPerUser').value,
    autoCloseHours: +document.getElementById('tkAutoClose').value,
    surveyEnabled: document.getElementById('tkSurvey').checked,
    lockUntilClaim: document.getElementById('tkLockClaim').checked,
    welcomeEnabled: document.getElementById('tkWelcome').checked,
    autoMessageEnabled: document.getElementById('tkAutoMsg').checked,
    autoMessage: document.getElementById('tkAutoMsgText').value,
  };
  // AI
  data.ai = {
    enabled: document.getElementById('aiEnabled').checked,
    provider: document.getElementById('aiProvider').value,
    model: document.getElementById('aiModel').value,
    responseLanguage: document.getElementById('aiResponseLang').value,
    cooldown: +document.getElementById('aiCooldown').value,
    temperature: +document.getElementById('aiTemp').value,
    maxTokens: +document.getElementById('aiMaxTokens').value,
    systemPrompt: document.getElementById('aiSystemPrompt').value,
    allowedChannels: document.getElementById('aiAllowedChannels').value.split(',').map(x=>x.trim()).filter(x=>x),
    allowedRoles: document.getElementById('aiAllowedRoles').value.split(',').map(x=>x.trim()).filter(x=>x),
    ignoredChannels: document.getElementById('aiIgnoredChannels').value.split(',').map(x=>x.trim()).filter(x=>x),
    ignoredRoles: document.getElementById('aiIgnoredRoles').value.split(',').map(x=>x.trim()).filter(x=>x),
  };
  try {
    const res = await fetch('/api/guilds/<%= guild.id %>/settings', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    if (res.ok) showToast('تم حفظ جميع الإعدادات ✅', 'success');
    else showToast('فشل الحفظ ❌', 'danger');
  } catch (e) { showToast('خطأ في الاتصال', 'danger'); }
}

function addLevelReward() {
  const div = document.createElement('div');
  div.className = 'input-group mb-2';
  div.innerHTML = `
    <span class="input-group-text">المستوى</span>
    <input type="number" class="form-control" style="width: 80px;" min="1" data-field="level">
    <span class="input-group-text">الرول</span>
    <input type="text" class="form-control" placeholder="Role ID" data-field="roleId">
    <button class="btn btn-outline-danger" onclick="this.closest('.input-group').remove()"><i class="bi bi-trash"></i></button>
  `;
  document.getElementById('levelRewards').appendChild(div);
}

function addWarnRole(field) {
  const container = field === 'memberIds' ? 'memberWarnRoles' : 'adminWarnRoles';
  const div = document.createElement('div');
  div.className = 'input-group mb-2';
  div.innerHTML = `
    <input type="text" class="form-control" placeholder="Role ID" data-field="${field}">
    <button class="btn btn-outline-danger" onclick="this.closest('.input-group').remove()"><i class="bi bi-trash"></i></button>
  `;
  document.getElementById(container)?.appendChild(div);
}

function showAddCmdModal() { new bootstrap.Modal(document.getElementById('addCmdModal')).show(); }
function showAddTagModal() { new bootstrap.Modal(document.getElementById('addTagModal')).show(); }

async function addCmd() {
  const name = document.getElementById('cmdName').value.trim();
  const content = document.getElementById('cmdContent').value.trim();
  const embed = document.getElementById('cmdEmbed').checked;
  if (!name || !content) { showToast('املأ جميع الحقول', 'warning'); return; }
  try {
    const res = await fetch('/api/guilds/<%= guild.id %>/settings', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ _pushCmd: { name, content, embed, createdBy: '<%= user.id %>', createdAt: new Date(), uses: 0 } })
    });
    if (res.ok) { showToast('تمت الإضافة ✅', 'success'); location.reload(); }
    else showToast('فشل الإضافة', 'danger');
  } catch (e) { showToast('خطأ', 'danger'); }
}

async function deleteCmd(name) {
  if (!confirm('حذف الأمر ' + name + '؟')) return;
  try {
    const res = await fetch('/api/guilds/<%= guild.id %>/settings', {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ _pullCmd: name })
    });
    if (res.ok) { showToast('تم الحذف ✅', 'success'); location.reload(); }
    else showToast('فشل الحذف', 'danger');
  } catch (e) { showToast('خطأ', 'danger'); }
}

