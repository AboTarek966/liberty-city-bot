<%- include('layout-top', { title: 'الإعدادات العامة', activePage: 'settings' }) %>

<% const S = settings || {}; const GID = guild.id; %>

<div class="hero">
  <div class="h-logo" style="background:linear-gradient(135deg,var(--amber),var(--primary));display:grid;place-items:center;font-size:26px;"><i class="bi bi-sliders"></i></div>
  <div>
    <div class="h-title">الإعدادات العامة</div>
    <div class="h-desc">هوية البوت والأنظمة الصغيرة — الجيل، السجن، التوثيق، الرول التلقائي، السجلات، الأوامر المخصصة</div>
    <div class="h-chips">
      <span class="chip purple"><i class="bi bi-command"></i> البادئة: <%= S.prefix || 'lb' %></span>
      <span class="chip cyan"><i class="bi bi-person-lock"></i> توثيق: <%= S.verification?.enabled ? 'ON' : 'OFF' %></span>
    </div>
  </div>
</div>

<div class="tabs" data-group="set">
  <button class="tab active" data-target="pane-general"><i class="bi bi-gear"></i> عام</button>
  <button class="tab" data-target="pane-logging"><i class="bi bi-journal-text"></i> السجلات</button>
  <button class="tab" data-target="pane-systems"><i class="bi bi-ui-checks"></i> أنظمة</button>
  <button class="tab" data-target="pane-warn"><i class="bi bi-exclamation-square"></i> التحذيرات</button>
  <button class="tab" data-target="pane-custom"><i class="bi bi-terminal"></i> أوامر ووسوم</button>
</div>

<div>
<!-- ══════ عام ══════ -->
<div class="tabpane active" data-group="set" id="pane-general">
  <div class="card">
    <div class="card-head"><h3><i class="bi bi-sliders2"></i> الهوية العامة</h3></div>
    <div class="card-body">
      <div class="form-row-3">
        <div class="field"><label>بادئة الأوامر</label><input class="inp" data-text="prefix" value="<%= S.prefix || 'lb' %>" maxlength="5"></div>
        <div class="field"><label>لغة البوت</label>
          <select class="inp" data-text="language">
            <% [['ar', 'العربية'], ['en', 'English']].forEach(l => { %><option value="<%= l[0] %>" <%= (S.language || 'ar') === l[0] ? 'selected' : '' %>><%= l[1] %></option><% }) %>
          </select>
        </div>
        <div class="field"><label>المنطقة الزمنية</label>
          <select class="inp" data-text="timezone">
            <% [['Asia/Riyadh', 'الرياض'], ['Africa/Cairo', 'القاهرة'], ['Asia/Dubai', 'دبي'], ['Asia/Baghdad', 'بغداد'], ['UTC', 'UTC']].forEach(t => { %><option value="<%= t[0] %>" <%= (S.timezone || 'Asia/Riyadh') === t[0] ? 'selected' : '' %>><%= t[1] %></option><% }) %>
          </select>
        </div>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>⛽ كلمة مرور الإعدادات (بالبوت)</label><input class="inp" data-text="settingsPassword" value="<%= S.settingsPassword || '' %>" maxlength="12" placeholder="7421"></div>
        <div class="field">
          <label>🎤 نظام موسيقى</label>
          <div class="spread" style="background:var(--bg-soft);border:1px solid var(--line);border-radius:var(--radius-sm);padding:10px 13px;">
            <span style="font-size:12.5px;font-weight:700;" class="text-mid">تشغيل الصوت في الرومات الصوتية</span>
            <label class="switch"><input type="checkbox" data-toggle="music.enabled" <%= S.music?.enabled ? 'checked' : '' %>><span class="track"></span></label>
          </div>
          <div class="form-row-3 mt-3">
            <div class="field"><label>الصوت الافتراضي %</label><input type="number" class="inp num" data-num="music.defaultVolume" value="<%= S.music?.defaultVolume ?? 60 %>" min="1" max="100"></div>
            <div class="field"><label>طول قائمة الانتظار</label><input type="number" class="inp num" data-num="music.maxQueueSize" value="<%= S.music?.maxQueueSize ?? 100 %>" min="5" max="500"></div>
            <div class="field">
              <label>Autoplay بعد القائمة</label>
              <label class="field-check"><input type="checkbox" data-toggle="music.autoplay" <%= S.music?.autoplay !== false ? 'checked' : '' %>><span>تابع التشغيل تلقائياً</span></label>
              <div class="text-dim" style="font-size:10.5px;">يضيف مقاطع مشابهة للنهاية</div>
            </div>
          </div>
          <label class="field-check mt-3" style="max-width:420px;"><input type="checkbox" data-toggle="music.allowDJ" <%= S.music?.allowDJ ? 'checked' : '' %>><span>رول DJ وحده يستطيع التحكم بالموسيقى (إلا فالجميع)</span></label>
        </div>
      </div>

      <div class="sec-title"><i class="bi bi-broadcast"></i> التدفق المباشر (Snipe)</div>
      <label class="field-check" style="max-width:420px;"><input type="checkbox" data-toggle="snipe.enabled" <%= S.snipe?.enabled !== false ? 'checked' : '' %>><span>سنايب — استرجاع آخر رسالة محذوفة بأمر /snipe</span></label>
    </div>
  </div>
</div>

<!-- ══════ السجلات ══════ -->
<div class="tabpane" data-group="set" id="pane-logging">
  <div class="card">
    <div class="card-head">
      <h3><i class="bi bi-journal-text"></i> السجلات</h3>
      <div class="head-side">
        <span class="chip <%= S.logging?.enabled ? 'green' : '' %>"><%= S.logging?.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="logging.enabled" <%= S.logging?.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="form-row">
        <div class="field"><label>القناة الرئيسية <span class="hint">كل الأحداث بدون قناة مخصصة</span></label>
          <select class="inp chan-sel" data-text="logging.channelId" data-types="0,5" data-value="<%= S.logging?.channelId || '' %>"></select>
        </div>
      </div>
      <div class="sec-title"><i class="bi bi-diagram-3"></i> تقسيم: كل نوع حدث في قناته</div>
      <div class="form-row-3">
        <% const LOG_TYPES = [['messages', 'الرسائل', 'chat-right'], ['members', 'الأعضاء (دخول/خروج)', 'people'], ['roles', 'الرولات', 'person-badge'], ['channels', 'الرومات', 'hash'], ['voice', 'الصوتي', 'mic'], ['moderation', 'الإشراف', 'hammer'], ['tickets', 'التذاكر', 'lifebuoy'], ['economy', 'الاقتصاد', 'coin'], ['server', 'السيرفر', 'hdd'], ['ai', 'الذكاء الاصطناعي', 'stars']]; %>
        <% LOG_TYPES.forEach(t => { const cur = (S.logging?.channels || {})[t[0]] || ''; %>
        <div class="field"><label><i class="bi bi-<%= t[2] %>"></i> <%= t[1] %></label>
          <select class="inp chan-sel" data-text="logging.channels.<%= t[0] %>" data-types="0,5" data-value="<%= cur %>"></select>
        </div>
        <% }) %>
      </div>
      <div class="label" style="font-size:11px;color:var(--text-3);font-weight:600;margin-top:12px;">تركها فارغة = تذهب للقناة الرئيسية. الأحداث تُرسل فور واقعها.</div>
    </div>
  </div>
</div>

<!-- ══════ أنظمة ══════ -->
<div class="tabpane" data-group="set" id="pane-systems">
  <div class="grid-2 mb-3">
    <div class="card">
      <div class="card-head">
        <h3><i class="bi bi-person-fill-add"></i> الرول التلقائي (Autorole)</h3>
        <div class="head-side">
          <span class="chip <%= S.autorole?.enabled ? 'green' : '' %>"><%= S.autorole?.enabled ? 'ON' : 'OFF' %></span>
          <label class="switch"><input type="checkbox" data-toggle="autorole.enabled" <%= S.autorole?.enabled ? 'checked' : '' %>><span class="track"></span></label>
        </div>
      </div>
      <div class="card-body">
        <div class="field"><label>الرول الذي يُعطى عند الانضمام</label>
          <select class="inp role-sel" data-text="autorole.roleId" data-value="<%= S.autorole?.roleId || '' %>"></select>
          <div class="text-dim" style="font-size:10.5px;">أنشئه على البوت أعلى من جميع الرولات لتعمل بدون مشاكل</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h3><i class="bi bi-person-rolodex"></i> التوثيق (Verification)</h3>
        <div class="head-side">
          <span class="chip <%= S.verification?.enabled ? 'green' : '' %>"><%= S.verification?.enabled ? 'ON' : 'OFF' %></span>
          <label class="switch"><input type="checkbox" data-toggle="verification.enabled" <%= S.verification?.enabled ? 'checked' : '' %>><span class="track"></span></label>
        </div>
      </div>
      <div class="card-body">
        <div class="form-row">
          <div class="field"><label>قناة التوثيق</label><select class="inp chan-sel" data-text="verification.channelId" data-types="0,5" data-value="<%= S.verification?.channelId || '' %>"></select></div>
          <div class="field"><label>الرول بعد التوثيق</label><select class="inp role-sel" data-text="verification.roleId" data-value="<%= S.verification?.roleId || '' %>"></select></div>
        </div>
        <div class="form-row mt-3">
          <div class="field"><label>عنوان البانل</label><input class="inp" data-text="verification.title" value="<%= S.verification?.title || 'توثيق الهوية' %>"></div>
          <div class="field"><label>نص زر التوثيق</label><input class="inp" data-text="verification.buttonLabel" value="<%= S.verification?.buttonLabel || '✅ توثيق' %>"></div>
        </div>
        <div class="field mt-3"><label>وصف البانل</label><textarea class="inp" style="min-height:64px;" data-text="verification.description" placeholder="اضغط الزر أدناه للحصول على صلاحيات الكتابة"><%= S.verification?.description || '' %></textarea></div>
        <div class="text-dim" style="font-size:11.5px;">للتطبيق النهائي: أعد نشر البانل بالبوت (/setup verification)</div>
      </div>
    </div>
  </div>

  <div class="card mb-3">
    <div class="card-head">
      <h3><i class="bi bi-lock"></i> السجن (Jail)</h3>
      <div class="head-side">
        <span class="chip <%= S.jail?.enabled ? 'green' : '' %>"><%= S.jail?.enabled ? 'ON' : 'OFF' %></span>
        <label class="switch"><input type="checkbox" data-toggle="jail.enabled" <%= S.jail?.enabled ? 'checked' : '' %>><span class="track"></span></label>
      </div>
    </div>
    <div class="card-body">
      <div class="form-row">
        <div class="field"><label>روم السجن <span class="hint">اكتب هنا فقط المسجون</span></label><select class="inp chan-sel" data-text="jail.channelId" data-types="0" data-value="<%= S.jail?.channelId || '' %>"></select></div>
        <div class="field"><label>رول السجن <span class="hint">يدخل في القناة المسجونين فقط</span></label><select class="inp role-sel" data-text="jail.jailRoleId" data-value="<%= S.jail?.jailRoleId || '' %>"></select></div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-head"><h3><i class="bi bi-tags"></i> التفاعل السريع — قوائم الرتب (اقرأ فقط)</h3></div>
    <div class="card-body tight">
      <% const rr = S.reactionRoles || []; const rm = S.roleMenus || []; %>
      <% if (!rr.length && !rm.length) { %>
        <div class="empty"><i class="bi bi-tags2"></i><h4>لا قوائم رتب بعد</h4><p>سبق أن أنشأتها بالبوت (+reaction) — ستظهر هنا للمراجعة</p></div>
      <% } else { %>
        <% rr.forEach(r => { %>
          <div class="feat"><div class="f-ico" style="background:var(--blue-soft);color:var(--blue);"><i class="bi bi-hand-index-thumb"></i></div>
            <div class="f-info"><div class="f-name">قائمة رتب بالتفاعل</div><div class="f-desc"><code class="code-cell">#<%= r.channelId %></code> · رسالة <code class="code-cell"><%= r.messageId %></code> · <%= (r.roles||[]).length %> رول</div></div>
            <a class="btn sm" target="_blank" href="https://discord.com/channels/<%= GID %>/<%= r.channelId %>/<%= r.messageId %>"><i class="bi bi-box-arrow-up-right"></i></a>
          </div>
        <% }) %>
        <% rm.forEach(r => { %>
          <div class="feat"><div class="f-ico" style="background:var(--purple-soft);color:var(--primary-2);"><i class="bi bi-menu-button"></i></div>
            <div class="f-info"><div class="f-name">قائمة رولات بالأزرار: <%= r.title %></div><div class="f-desc"><code class="code-cell">#<%= r.channelId %></code> · <%= (r.roleIds||[]).length %> رول</div></div>
            <a class="btn sm" target="_blank" href="https://discord.com/channels/<%= GID %>/<%= r.channelId %>/<%= r.messageId %>"><i class="bi bi-box-arrow-up-right"></i></a>
          </div>
        <% }) %>
      <% } %>
    </div>
  </div>
</div>

<!-- ══════ التحذيرات ══════ -->
<div class="tabpane" data-group="set" id="pane-warn">
  <div class="card">
    <div class="card-head"><h3><i class="bi bi-exclamation-square"></i> رولات التحذيرات</h3></div>
    <div class="card-body">
      <div class="form-row-3">
        <div class="field"><label>تحذير الإداري الأول</label><select class="inp role-sel" data-text="warnRoles.adminSequential.role1Id" data-value="<%= S.warnRoles?.adminSequential?.role1Id || '' %>"></select></div>
        <div class="field"><label>التحذير الثاني</label><select class="inp role-sel" data-text="warnRoles.adminSequential.role2Id" data-value="<%= S.warnRoles?.adminSequential?.role2Id || '' %>"></select></div>
        <div class="field"><label>التحذير الثالث</label><select class="inp role-sel" data-text="warnRoles.adminSequential.role3Id" data-value="<%= S.warnRoles?.adminSequential?.role3Id || '' %>"></select></div>
      </div>
      <div class="form-row mt-3">
        <div class="field"><label>رولات تحذير الأعضاء (سنبل بفاصلة)</label><input class="inp" data-array="warnRoles.memberIds" value="<%= (S.warnRoles?.memberIds || []).join(',') %>" placeholder="ID, ID"></div>
        <div class="field"><label>رولات تحذير الإداريين (توافق قديم)</label><input class="inp" data-array="warnRoles.adminIds" value="<%= (S.warnRoles?.adminIds || []).join(',') %>"></div>
      </div>
      <div class="text-dim mt-3" style="font-size:11.5px;">عند /warn يعرض البوت اختيار رول التحذير — النظام التسلسلي يلحق رول الثالث، نهايته بالحظر.</div>
    </div>
  </div>
</div>

<!-- ══════ أوامر ووسوم ══════ -->
<div class="tabpane" data-group="set" id="pane-custom">
  <div class="grid-2">
    <div class="card">
      <div class="card-head">
        <h3><i class="bi bi-terminal"></i> أوامر مخصصة</h3>
        <div class="head-side"><button class="btn sm primary" onclick="newCmd()"><i class="bi bi-plus-lg"></i> جديدة</button></div>
      </div>
      <div class="card-body tight" id="cmdList">
        <% const cmds = S.customCommands || []; %>
        <% if (!cmds.length) { %><div class="empty" style="padding:26px;"><i class="bi bi-terminal"></i><h4>لا أوامر مخصصة</h4><p>أضف أمراً مثل /lb قوانين يعطي رداً جاهزاً</p></div><% } %>
        <% cmds.forEach(c => { %>
          <div class="feat" data-cmd="<%= c.name %>">
            <div class="f-ico" style="background:var(--cyan-soft);color:var(--cyan);"><i class="bi bi-slash-square"></i></div>
            <div class="f-info">
              <div class="f-name"><span class="code-cell">/<%= c.name %></span> <span class="chip <%= c.scope === 'admin' || c.embed ? 'blue' : '' %>"><%= c.scope === 'admin' ? 'إداريون' : 'الجميع' %></span></div>
              <div class="f-desc"><%= (c.content || '').slice(0, 60) %></div>
            </div>
            <button class="btn sm danger" onclick="delCmd('<%= c.name %>')"><i class="bi bi-trash"></i></button>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="card">
      <div class="card-head">
        <h3><i class="bi bi-bookmark-star"></i> الوسوم (Tags)</h3>
        <div class="head-side"><button class="btn sm primary" onclick="newTag()"><i class="bi bi-plus-lg"></i> جديد</button></div>
      </div>
      <div class="card-body tight" id="tagList">
        <% const tags = S.tags || []; %>
        <% if (!tags.length) { %><div class="empty" style="padding:26px;"><i class="bi bi-tags2"></i><h4>لا وسوم بعد</h4><p>وسم = رد سريع باسم مثل «قوانين»</p></div><% } %>
        <% tags.forEach(t => { %>
          <div class="feat" data-tag="<%= t.name %>">
            <div class="f-ico" style="background:var(--purple-soft);color:var(--primary-2);"><i class="bi bi-bookmark"></i></div>
            <div class="f-info"><div class="f-name"><%= t.name %> <span class="chip">استُخدم <%= t.uses || 0 %></span></div><div class="f-desc"><%= (t.content || '').slice(0, 60) %></div></div>
            <button class="btn sm danger" onclick="delTag('<%= t.name %>')"><i class="bi bi-trash"></i></button>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
</div>
</div>

<script>
  const GID = '<%= GID %>';
  document.addEventListener('DOMContentLoaded', async () => {
    await LC.loadChannels(GID, $$('.chan-sel'));
    await LC.loadRoles(GID, $$('.role-sel'));
    $$('.inp[data-array]').forEach(el => el.addEventListener('change', async () => {
      const path = el.dataset.array.split('.');
      const arr = el.value.split(',').map(s => s.trim()).filter(Boolean);
      const payload = {}; let node = payload;
      path.slice(0, -1).forEach(k => { node[k] = node[k] || {}; node = node[k]; });
      node[path[path.length - 1]] = arr;
      await LC.saveSetting(GID, payload, null);
    }));
  });

  function newCmd() {
    LC.modal({
      title: 'أمر مخصص جديد',
      body: `
        <div class="field mb-3"><label>الاسم (بالإنجليزية بدون مسافات)</label><input id="nc_name" class="inp" placeholder="rules"></div>
        <div class="field"><label>الرد</label><textarea id="nc_content" class="inp" placeholder="النص أو الإندبيد"></textarea></div>
        <div class="flex mt-3">
          <label class="field-check"><input type="checkbox" id="nc_embed"><span>إندبيد</span></label>
          <label class="field-check"><input type="checkbox" id="nc_admin"><span>إداريون فقط</span></label>
        </div>`,
      actions: [
        { label: 'إنشاء', cls: 'primary', icon: 'plus-lg', onclick: async (m) => {
          const name = document.getElementById('nc_name').value.trim();
          const content = document.getElementById('nc_content').value.trim();
          if (!name || !content) { LC.toast('أكمل الاسم والرد', 'warn'); throw new Error('skip'); }
          const cmd = { name, content, embed: !!document.getElementById('nc_embed').checked, scope: document.getElementById('nc_admin').checked ? 'admin' : 'public', createdBy: '<%= user?.username || 'لوحة التحكم' %>', createdAt: new Date().toISOString(), uses: 0 };
          const ok = await LC.saveSetting(GID, { _pushCmd: cmd }, null);
          if (ok && !window.__saved) setTimeout(() => location.reload(), 700);
        }},
        { label: 'إلغاء', cls: 'ghost' },
      ],
    });
  }
  function newTag() {
    LC.modal({
      title: 'وسم جديد',
      body: `
        <div class="field mb-3"><label>الاسم</label><input id="nt_name" class="inp" placeholder="قوانين"></div>
        <div class="field"><label>المحتوى</label><textarea id="nt_content" class="inp"></textarea></div>`,
      actions: [
        { label: 'إنشاء', cls: 'primary', icon: 'plus-lg', onclick: async (m) => {
          const name = document.getElementById('nt_name').value.trim();
          const content = document.getElementById('nt_content').value.trim();
          if (!name || !content) { LC.toast('أكمل', 'warn'); throw new Error('skip'); }
          const tag = { name, content, createdBy: '<%= user?.username || 'لوحة التحكم' %>', createdAt: new Date().toISOString(), uses: 0 };
          const ok = await LC.saveSetting(GID, { _pushTag: tag }, null);
          if (ok) setTimeout(() => location.reload(), 700);
        }},
        { label: 'إلغاء', cls: 'ghost' },
      ],
    });
  }
  function delCmd(name) {
    LC.confirmBox('حذف أمر', `حذف الأمر /${name}؟`, {}).then(async ok => {
      if (!ok) return;
      if (await LC.saveSetting(GID, { _pullCmd: name }, null)) setTimeout(() => location.reload(), 700);
    });
  }
  function delTag(name) {
    LC.confirmBox('حذف وسم', `حذف الوسم ${name}؟`, {}).then(async ok => {
      if (!ok) return;
      if (await LC.saveSetting(GID, { _pullTag: name }, null)) setTimeout(() => location.reload(), 700);
    });
  }
</script>

<%- include('layout-bottom') %>
