<%- include('layout-top', { title: 'الإعدادات', activePage: 'settings' }) %>

<div class="page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
  <div>
    <h1 class="h3 fw-bold mb-1">
      <i class="bi bi-gear me-2 text-primary"></i>
      الإعدادات العامة
    </h1>
    <p class="text-muted mb-0">إعدادات البوت الأساسية للسيرفر</p>
  </div>
  <button class="btn btn-primary btn-lg" onclick="saveAllSettings()">
    <i class="bi bi-check-lg me-1"></i> حفظ جميع التغييرات
  </button>
</div>

<ul class="nav nav-pills flex-wrap mb-4" role="tablist">
  <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#tab-general"><i class="bi bi-sliders me-1"></i> عام</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-automod"><i class="bi bi-shield me-1"></i> أوتومود</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-leveling"><i class="bi bi-graph-up me-1"></i> المستويات</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-verification"><i class="bi bi-patch-check me-1"></i> التوثيق</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-logging"><i class="bi bi-journal-text me-1"></i> السجلات</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-music"><i class="bi bi-music-note me-1"></i> الموسيقى</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-warnroles"><i class="bi bi-exclamation-circle me-1"></i> رولات التحذير</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-tickets"><i class="bi bi-ticket-perforated me-1"></i> التذاكر</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-commands"><i class="bi bi-terminal me-1"></i> أوامر مخصصة</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-ai"><i class="bi bi-robot me-1"></i> الذكاء الاصطناعي</button></li>
  <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#tab-backup"><i class="bi bi-hdd me-1"></i> النسخ الاحتياطي</button></li>
</ul>

<div class="tab-content">
  <!-- General Tab -->
  <div class="tab-pane fade show active" id="tab-general">
    <%
      const genPrefix = settings?.prefix || 'lc!';
      const genLang = settings?.language || 'ar';
      const genTz = settings?.timezone || 'Asia/Riyadh';
    %>
    <div class="row g-4">
      <div class="col-12 col-lg-6">
        <div class="card h-100">
          <div class="card-header"><h5 class="mb-0"><i class="bi bi-sliders me-2"></i> الإعدادات العامة</h5></div>
          <div class="card-body">
            <div class="mb-3">
              <label class="form-label fw-bold">البادئة (Prefix)</label>
              <input type="text" class="form-control" id="genPrefix" value="<%= genPrefix %>" maxlength="5">
              <div class="form-text">البادئة المستخدمة للأوامر النصية</div>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">اللغة</label>
              <select class="form-select" id="genLang">
                <option value="ar" <%= genLang === 'ar' ? 'selected' : '' %>>العربية 🇸🇦</option>
                <option value="en" <%= genLang === 'en' ? 'selected' : '' %>>English 🇬🇧</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label fw-bold">المنطقة الزمنية</label>
              <select class="form-select" id="genTz">
                <option value="Asia/Riyadh" <%= genTz === 'Asia/Riyadh' ? 'selected' : '' %>>الرياض (GMT+3)</option>
                <option value="Asia/Dubai" <%= genTz === 'Asia/Dubai' ? 'selected' : '' %>>دبي (GMT+4)</option>
                <option value="Africa/Cairo" <%= genTz === 'Africa/Cairo' ? 'selected' : '' %>>القاهرة (GMT+2)</option>
                <option value="Europe/London" <%= genTz === 'Europe/London' ? 'selected' : '' %>>لندن (GMT+0)</option>
              </select>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="card h-100">
          <div class="card-header"><h5 class="mb-0"><i class="bi bi-info-circle me-2"></i> معلومات السيرفر</h5></div>
          <div class="card-body">
            <% const g = guild; %>
            <div class="mb-3">
              <label class="form-label small">اسم السيرفر</label>
              <input type="text" class="form-control" value="<%= g?.name || '—' %>" disabled>
            </div>
            <div class="mb-3">
              <label class="form-label small">سيرفر ID</label>
              <input type="text" class="form-control" value="<%= g?.id || '—' %>" disabled>
            </div>
            <div class="mb-3">
              <label class="form-label small">عدد الأعضاء</label>
              <input type="text" class="form-control" value="<%= stats?.memberCount || '—' %>" disabled>
            </div>
            <div class="mb-3">
              <label class="form-label small">عدد القنوات</label>
              <input type="text" class="form-control" value="<%= stats?.channelCount || '—' %>" disabled>
            </div>
            <div class="mb-3">
              <label class="form-label small">عدد الرولات</label>
              <input type="text" class="form-control" value="<%= stats?.roleCount || '—' %>" disabled>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- AutoMod Tab -->
  <div class="tab-pane fade" id="tab-automod">
    <%
      const am = settings?.automod || {};
    %>
    <div class="card">
      <div class="card-header"><h5 class="mb-0"><i class="bi bi-shield me-2"></i> أوتومود — الفلترة التلقائية</h5></div>
      <div class="card-body">
        <div class="form-check form-switch mb-4">
          <input class="form-check-input" type="checkbox" id="amEnabled" <%= am.enabled !== false ? 'checked' : '' %>>
          <label class="form-check-label fw-bold fs-5" for="amEnabled">تفعيل أوتومود</label>
        </div>
        <div class="mb-4">
          <label class="form-label fw-bold">الكلمات المحظورة</label>
          <textarea class="form-control" id="amBadWords" rows="3" placeholder="كلمة1&#10;كلمة2&#10;كلمة3"><%= (am.badWords || []).join('\n') %></textarea>
          <div class="form-text">كل كلمة في سطر مستقل</div>
        </div>
        <div class="row g-3 mb-4">
          <div class="col-12 col-md-4">
            <label class="form-label">إجراء الكلمات المحظورة</label>
            <select class="form-select" id="amBadWordsAction">
              <option value="delete" <%= am.badWordsAction === 'delete' ? 'selected' : '' %>>حذف</option>
              <option value="warn" <%= am.badWordsAction === 'warn' ? 'selected' : '' %>>تحذير</option>
              <option value="mute" <%= am.badWordsAction === 'mute' ? 'selected' : '' %>>كتم</option>
              <option value="kick" <%= am.badWordsAction === 'kick' ? 'selected' : '' %>>طرد</option>
              <option value="ban" <%= am.badWordsAction === 'ban' ? 'selected' : '' %>>حظر</option>
            </select>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">مدة الكتم (مللي ثانية)</label>
            <input type="number" class="form-control" id="amBadWordsDuration" value="<%= am.badWordsDuration || 600000 %>" min="0">
          </div>
          <div class="col-12 col-md-4">
            <div class="form-check form-switch mt-4">
              <input class="form-check-input" type="checkbox" id="amZalgo" <%= am.zalgoEnabled !== false ? 'checked' : '' %>>
              <label class="form-check-label" for="amZalgo">مكافحة Zalgo</label>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">إجراء Zalgo</label>
            <select class="form-select" id="amZalgoAction">
              <option value="delete" <%= am.zalgoAction === 'delete' ? 'selected' : '' %>>حذف</option>
              <option value="warn" <%= am.zalgoAction === 'warn' ? 'selected' : '' %>>تحذير</option>
              <option value="mute" <%= am.zalgoAction === 'mute' ? 'selected' : '' %>>كتم</option>
            </select>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">رولات مستثناة (IDs مفصولة بفاصلة)</label>
            <input type="text" class="form-control" id="amIgnoredRoles" value="<%= (am.ignoredRoles || []).join(',') %>" placeholder="123,456">
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">قنوات مستثناة (IDs مفصولة بفاصلة)</label>
            <input type="text" class="form-control" id="amIgnoredChannels" value="<%= (am.ignoredChannels || []).join(',') %>" placeholder="123,456">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Leveling Tab -->
  <div class="tab-pane fade" id="tab-leveling">
    <%
      const lv = settings?.leveling || {};
    %>
    <div class="row g-4">
      <div class="col-12 col-lg-6">
        <div class="card h-100">
          <div class="card-header"><h5 class="mb-0"><i class="bi bi-graph-up me-2"></i> إعدادات المستويات</h5></div>
          <div class="card-body">
            <div class="form-check form-switch mb-3">
              <input class="form-check-input" type="checkbox" id="lvEnabled" <%= lv.enabled !== false ? 'checked' : '' %>>
              <label class="form-check-label fw-bold" for="lvEnabled">تفعيل نظام المستويات</label>
            </div>
            <div class="row g-3 mb-3">
              <div class="col-6">
                <label class="form-label">خبرة لكل رسالة</label>
                <input type="number" class="form-control" id="lvXpPerMsg" value="<%= lv.xpPerMessage || 15 %>" min="0">
              </div>
              <div class="col-6">
                <label class="form-label">مهلة الخبرة (مللي ثانية)</label>
                <input type="number" class="form-control" id="lvXpCooldown" value="<%= lv.xpCooldown || 60000 %>" min="0">
              </div>
              <div class="col-6">
                <label class="form-label">مضاعف الخبرة</label>
                <input type="number" class="form-control" id="lvMultiplier" value="<%= lv.xpGainMultiplier || 1 %>" step="0.1" min="0">
              </div>
              <div class="col-6">
                <label class="form-label">خبرة الصوت/دقيقة</label>
                <input type="number" class="form-control" id="lvVoiceXp" value="<%= lv.voiceXpPerMinute || 10 %>" min="0">
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label">قناة الترقية (اختياري)</label>
              <input type="text" class="form-control" id="lvLevelChannel" value="<%= lv.levelUpChannelId || '' %>" placeholder="Channel ID">
            </div>
            <div class="mb-3">
              <label class="form-label">رسالة الترقية</label>
              <textarea class="form-control" id="lvLevelMsg" rows="2"><%= lv.levelUpMessage || 'تهانينا {user}! لقد وصلت للمستوى {level} 🎉' %></textarea>
              <div class="form-text">المتغيرات: {user} {level}</div>
            </div>
            <div class="mb-3">
              <label class="form-label">نمط رسالة الترقية</label>
              <select class="form-select" id="lvLevelStyle">
                <option value="embed" <%= lv.levelUpStyle === 'embed' ? 'selected' : '' %>>Embed احترافي</option>
                <option value="text" <%= lv.levelUpStyle === 'text' ? 'selected' : '' %>>نص عادي</option>
              </select>
            </div>
            <div class="row g-3">
              <div class="col-6">
                <label class="form-label">عنوان الإمبد</label>
                <input type="text" class="form-control" id="lvLevelTitle" value="<%= lv.levelUpTitle || '🎉 ترقية جديدة!' %>">
              </div>
              <div class="col-6">
                <label class="form-label">لون الإمبد</label>
                <input type="color" class="form-control form-control-color" id="lvLevelColor" value="<%= lv.levelUpColor || '#e67e22' %>">
              </div>
            </div>
            <div class="mt-3">
              <label class="form-label">قنوات مستثناة (IDs مفصولة بفاصلة)</label>
              <input type="text" class="form-control" id="lvIgnoredChannels" value="<%= (lv.ignoredChannels || []).join(',') %>" placeholder="123,456">
            </div>
            <div class="mt-3">
              <label class="form-label">رولات مستثناة (IDs مفصولة بفاصلة)</label>
              <input type="text" class="form-control" id="lvIgnoredRoles" value="<%= (lv.ignoredRoles || []).join(',') %>" placeholder="123,456">
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="card h-100">
          <div class="card-header">
            <h5 class="mb-0"><i class="bi bi-trophy me-2"></i> مكافآت المستويات</h5>
          </div>
          <div class="card-body">
            <div id="levelRewards">
              <% const rewards = lv.levelRewards || []; %>
              <% if (rewards.length > 0) { rewards.forEach((r, i) => { %>
              <div class="input-group mb-2" data-idx="<%= i %>">
                <span class="input-group-text">المستوى</span>
                <input type="number" class="form-control" style="width: 80px;" value="<%= r.level %>" min="1" data-field="level">
                <span class="input-group-text">الرول</span>
                <input type="text" class="form-control" value="<%= r.roleId %>" placeholder="Role ID" data-field="roleId">
                <button class="btn btn-outline-danger" onclick="this.closest('.input-group').remove()"><i class="bi bi-trash"></i></button>
              </div>
              <% }) } %>
            </div>
            <button class="btn btn-outline-primary w-100 mt-2" onclick="addLevelReward()">
              <i class="bi bi-plus-circle me-1"></i> إضافة مكافأة
            </button>
            <hr>
            <h6 class="fw-bold mb-3">رول الترحيب (Autorole)</h6>
            <%
              const ar = settings?.autorole || {};
            %>
            <div class="form-check form-switch mb-2">
              <input class="form-check-input" type="checkbox" id="arEnabled" <%= ar.enabled ? 'checked' : '' %>>
              <label class="form-check-label" for="arEnabled">تفعيل الرول التلقائي عند الانضمام</label>
            </div>
            <div class="mb-3">
              <label class="form-label">الرول (Role ID)</label>
              <input type="text" class="form-control" id="arRoleId" value="<%= ar.roleId || '' %>" placeholder="123456789">
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Verification Tab -->
  <div class="tab-pane fade" id="tab-verification">
    <%
      const ver = settings?.verification || {};
    %>
    <div class="row g-4">
      <div class="col-12 col-lg-6">
        <div class="card h-100">
          <div class="card-header"><h5 class="mb-0"><i class="bi bi-patch-check me-2"></i> نظام التوثيق</h5></div>
          <div class="card-body">
            <div class="form-check form-switch mb-4">
              <input class="form-check-input" type="checkbox" id="verEnabled" <%= ver.enabled ? 'checked' : '' %>>
              <label class="form-check-label fw-bold fs-5" for="verEnabled">تفعيل التوثيق</label>
            </div>
            <div class="mb-3">
              <label class="form-label">قناة التوثيق (Channel ID)</label>
              <input type="text" class="form-control" id="verChannel" value="<%= ver.channelId || '' %>" placeholder="123456789">
            </div>
            <div class="mb-3">
              <label class="form-label">رول التوثيق (Role ID)</label>
              <input type="text" class="form-control" id="verRole" value="<%= ver.roleId || '' %>" placeholder="123456789">
            </div>
            <div class="mb-3">
              <label class="form-label">العنوان</label>
              <input type="text" class="form-control" id="verTitle" value="<%= ver.title || '✅ توثيق العضوية' %>">
            </div>
            <div class="mb-3">
              <label class="form-label">الوصف</label>
              <textarea class="form-control" id="verDesc" rows="3"><%= ver.description || 'اضغط الزر بالأسفل للحصول على رتبة العضو والقدرة على التفاعل في السيرفر' %></textarea>
            </div>
            <div class="row g-3">
              <div class="col-6">
                <label class="form-label">نص الزر</label>
                <input type="text" class="form-control" id="verBtnLabel" value="<%= ver.buttonLabel || 'توثيق' %>">
              </div>
              <div class="col-6">
                <label class="form-label">إيموجي الزر</label>
                <input type="text" class="form-control" id="verBtnEmoji" value="<%= ver.buttonEmoji || '✅' %>" maxlength="4">
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-12 col-lg-6">
        <div class="card h-100">
          <div class="card-header"><h5 class="mb-0"><i class="bi bi-eye me-2"></i> معاينة</h5></div>
          <div class="card-body d-flex align-items-center justify-content-center">
            <div class="card text-center" style="max-width: 400px;">
              <div class="card-body">
                <h5 class="fw-bold mb-2"><%= ver.title || '✅ توثيق العضوية' %></h5>
                <p class="text-muted mb-3"><%= ver.description || 'اضغط الزر بالأسفل للحصول على رتبة العضو' %></p>
                <button class="btn btn-primary"><%= ver.buttonEmoji || '✅' %> <%= ver.buttonLabel || 'توثيق' %></button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Logging Tab -->
  <div class="tab-pane fade" id="tab-logging">
    <%
      const lg = settings?.logging || {};
      const allTypes = ['messageDelete', 'messageEdit', 'memberJoin', 'memberLeave', 'memberBan', 'memberUnban', 'memberKick', 'memberMute', 'roleCreate', 'roleDelete', 'roleUpdate', 'channelCreate', 'channelDelete', 'channelUpdate', 'emojiCreate', 'emojiDelete', 'voiceJoin', 'voiceLeave', 'voiceMove', 'nicknameChange', 'avatarChange', 'nameChange', 'prune', 'inviteCreate', 'inviteDelete'];
      const activeTypes = lg.types || [];
    %>
    <div class="card">
      <div class="card-header"><h5 class="mb-0"><i class="bi bi-journal-text me-2"></i> إعدادات السجلات</h5></div>
      <div class="card-body">
        <div class="form-check form-switch mb-4">
          <input class="form-check-input" type="checkbox" id="lgEnabled" <%= lg.enabled !== false ? 'checked' : '' %>>
          <label class="form-check-label fw-bold fs-5" for="lgEnabled">تفعيل السجلات</label>
        </div>
        <div class="mb-4">
          <label class="form-label fw-bold">القناة الرئيسية للسجلات</label>
          <input type="text" class="form-control" id="lgChannel" value="<%= lg.channelId || '' %>" placeholder="Channel ID">
        </div>
        <h6 class="fw-bold mb-3">أنواع الأحداث المُسجلة:</h6>
        <div class="row g-2">
          <% allTypes.forEach(t => { %>
          <div class="col-12 col-md-6 col-lg-4">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" value="<%= t %>" id="lg_<%= t %>" <%= activeTypes.includes(t) ? 'checked' : '' %>>
              <label class="form-check-label small" for="lg_<%= t %>"><%= t %></label>
            </div>
          </div>
          <% }) %>
        </div>
        <div class="mt-4 row g-3">
          <div class="col-12 col-md-6">
            <label class="form-label">قنوات مستثناة (IDs مفصولة بفاصلة)</label>
            <input type="text" class="form-control" id="lgIgnoredChannels" value="<%= (lg.ignoredChannels || []).join(',') %>" placeholder="123,456">
          </div>
          <div class="col-12 col-md-6">
            <label class="form-label">رولات مستثناة (IDs مفصولة بفاصلة)</label>
            <input type="text" class="form-control" id="lgIgnoredRoles" value="<%= (lg.ignoredRoles || []).join(',') %>" placeholder="123,456">
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Music Tab -->
  <div class="tab-pane fade" id="tab-music">
    <%
      const mu = settings?.music || {};
    %>
    <div class="card">
      <div class="card-header"><h5 class="mb-0"><i class="bi bi-music-note me-2"></i> نظام الموسيقى</h5></div>
      <div class="card-body">
        <div class="form-check form-switch mb-4">
          <input class="form-check-input" type="checkbox" id="muEnabled" <%= mu.enabled !== false ? 'checked' : '' %>>
          <label class="form-check-label fw-bold fs-5" for="muEnabled">تفعيل الموسيقى</label>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-12 col-md-4">
            <label class="form-label">مستوى الصوت الافتراضي</label>
            <input type="range" class="form-range" min="1" max="200" value="<%= mu.defaultVolume || 100 %>" id="muVolume" oninput="document.getElementById('muVolumeVal').textContent=this.value">
            <div class="text-center"><span class="fw-bold" id="muVolumeVal"><%= mu.defaultVolume || 100 %></span>%</div>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">حد أقصى لطابور التشغيل</label>
            <input type="number" class="form-control" id="muMaxQueue" value="<%= mu.maxQueueSize || 50 %>" min="1" max="500">
          </div>
          <div class="col-12 col-md-4">
            <div class="form-check form-switch mt-4">
              <input class="form-check-input" type="checkbox" id="muAutoplay" <%= mu.autoplay ? 'checked' : '' %>>
              <label class="form-check-label" for="muAutoplay">التشغيل التلقائي</label>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" id="muAllowDJ" <%= mu.allowDJ ? 'checked' : '' %>>
              <label class="form-check-label" for="muAllowDJ">رول DJ خاص</label>
            </div>
          </div>
          <div class="col-12 col-md-4">
            <label class="form-label">رول DJ (Role ID)</label>
