<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0b1020">
  <title>Liberty City — لوحة تحكم احترافية لسيرفرك</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🛡️</text></svg>">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/dashboard.css">
  <style>
    :root{
      --lp-bg:#0b1020; --lp-card:rgba(255,255,255,.045); --lp-line:rgba(255,255,255,.09);
      --lp-txt:#eef1ff; --lp-mut:#9aa3c7; --lp-indigo:#6366f1; --lp-purple:#a855f7; --lp-pink:#ec4899; --lp-gold:#f59e0b;
    }
    *{scrollbar-width:thin}
    body.lp{background:var(--lp-bg);color:var(--lp-txt);font-family:'Cairo',system-ui,sans-serif;overflow-x:hidden}
    /* -------- خلفية الهالات -------- */
    .lp-blobs{position:fixed;inset:0;z-index:0;pointer-events:none}
    .lp-blob{position:absolute;border-radius:50%;filter:blur(90px);opacity:.5;animation:lpFloat 14s ease-in-out infinite alternate}
    .lp-blob.b1{width:520px;height:520px;background:radial-gradient(circle,#6366f1,transparent 65%);top:-180px;left:-140px}
    .lp-blob.b2{width:460px;height:460px;background:radial-gradient(circle,#a855f7,transparent 65%);top:120px;right:-160px;animation-delay:2s}
    .lp-blob.b3{width:420px;height:420px;background:radial-gradient(circle,#ec4899,transparent 65%);bottom:-160px;left:35%;animation-delay:4s}
    .lp-blob.b4{width:320px;height:320px;background:radial-gradient(circle,#f59e0b,transparent 65%);top:55%;right:22%;opacity:.35;animation-delay:6s}
    @keyframes lpFloat{from{transform:translateY(0) scale(1)}to{transform:translateY(42px) scale(1.09)}}
    .lp-wrap{position:relative;z-index:1}
    /* -------- الشريط العلوي -------- */
    .lp-nav{display:flex;align-items:center;justify-content:space-between;padding:18px 34px;max-width:1200px;margin:0 auto;gap:16px}
    .lp-brand{display:flex;align-items:center;gap:12px;font-weight:900;font-size:19px;color:#fff;text-decoration:none}
    .lp-brand-badge{width:44px;height:44px;border-radius:14px;display:grid;place-items:center;font-size:22px;
      background:linear-gradient(135deg,#6366f1,#a855f7 55%,#ec4899);box-shadow:0 8px 24px rgba(99,102,241,.45)}
    .lp-nav-links{display:flex;gap:24px;font-weight:700;font-size:14.5px}
    .lp-nav-links a{color:var(--lp-mut);text-decoration:none;transition:.2s}
    .lp-nav-links a:hover{color:#fff}
    .lp-nav-cta{background:linear-gradient(135deg,#6366f1,#a855f7);border:none;color:#fff;font-weight:800;padding:10px 22px;border-radius:12px;text-decoration:none;font-size:14px;box-shadow:0 6px 18px rgba(99,102,241,.4);transition:.2s;display:inline-flex;align-items:center;gap:8px}
    .lp-nav-cta:hover{transform:translateY(-2px);box-shadow:0 10px 26px rgba(168,85,247,.5);color:#fff}
    @media(max-width:860px){.lp-nav-links{display:none}}
    /* -------- البطل Hero -------- */
    .lp-hero{max-width:1200px;margin:0 auto;padding:64px 34px 30px;display:grid;grid-template-columns:1.15fr .85fr;gap:54px;align-items:center}
    @media(max-width:960px){.lp-hero{grid-template-columns:1fr;padding-top:44px;gap:40px}}
    .lp-pill{display:inline-flex;align-items:center;gap:8px;background:rgba(99,102,241,.16);border:1px solid rgba(99,102,241,.4);color:#c7d2fe;padding:7px 16px;border-radius:999px;font-weight:700;font-size:13px;margin-bottom:22px}
    .lp-pill .dot{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e;animation:lpPulse 1.6s infinite}
    @keyframes lpPulse{50%{opacity:.35}}
    .lp-hero h1{font-size:clamp(30px,4.6vw,52px);font-weight:900;line-height:1.25;margin:0 0 18px}
    .lp-hero h1 .grad{background:linear-gradient(90deg,#818cf8,#c084fc,#f472b6);-webkit-background-clip:text;background-clip:text;color:transparent}
    .lp-hero p{color:var(--lp-mut);font-size:clamp(14.5px,1.6vw,17.5px);line-height:1.9;margin:0 0 30px;font-weight:600;max-width:520px}
    .lp-btn-discord{display:inline-flex;align-items:center;gap:12px;background:#5865F2;color:#fff;font-weight:900;font-size:17px;padding:15px 30px;border-radius:14px;text-decoration:none;box-shadow:0 12px 32px rgba(88,101,242,.45);transition:.22s}
    .lp-btn-discord:hover{transform:translateY(-3px);box-shadow:0 16px 40px rgba(88,101,242,.6);color:#fff}
    .lp-hint{margin-top:16px;font-size:12.5px;color:var(--lp-mut);font-weight:600}
    .lp-hint i{color:#22c55e;margin-inline-start:4px}
    /* -------- محاكاة الداشبورد -------- */
    .lp-mock{background:var(--lp-card);border:1px solid var(--lp-line);border-radius:24px;padding:22px;backdrop-filter:blur(14px);box-shadow:0 30px 80px rgba(0,0,0,.5);animation:lpUp 1s ease both}
    @keyframes lpUp{from{opacity:0;transform:translateY(30px)}to{opacity:1;transform:none}}
    .lp-mock-head{display:flex;align-items:center;gap:10px;margin-bottom:18px}
    .lp-mock-ava{width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,#22c55e,#0ea5e9);display:grid;place-items:center;font-size:22px}
    .lp-mock-head b{display:block;font-size:15px}
    .lp-mock-head small{color:var(--lp-mut);font-size:12px;font-weight:700}
    .lp-mock-row{display:flex;align-items:center;justify-content:space-between;background:rgba(255,255,255,.05);border:1px solid var(--lp-line);border-radius:14px;padding:13px 16px;margin-bottom:10px;font-weight:700;font-size:13.5px}
    .lp-mock-row .lft{display:flex;align-items:center;gap:10px}
    .lp-tgl{width:40px;height:22px;border-radius:999px;position:relative;flex:none}
    .lp-tgl::after{content:'';position:absolute;top:3px;width:16px;height:16px;border-radius:50%;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,.4)}
    .lp-tgl.on{background:#22c55e}.lp-tgl.on::after{right:3px}
    .lp-tgl.pn{background:linear-gradient(90deg,#f59e0b,#ec4899)}.lp-tgl.pn::after{left:3px}
    .lp-tgl.in{background:#6366f1}.lp-tgl.in::after{right:3px}
    .lp-mock-foot{display:flex;gap:10px;margin-top:16px}
    .lp-chip{flex:1;text-align:center;background:rgba(255,255,255,.05);border:1px solid var(--lp-line);border-radius:12px;padding:10px 6px}
    .lp-chip b{display:block;font-size:16px}
    .lp-chip small{color:var(--lp-mut);font-size:11px;font-weight:700}
    /* -------- رسالة الخطأ -------- */
    .lp-alert{max-width:1200px;margin:0 auto 6px;padding:0 34px}
    .lp-alert-in{display:flex;gap:12px;align-items:flex-start;background:rgba(239,68,68,.12);border:1px solid rgba(239,68,68,.45);border-radius:14px;padding:14px 18px;font-size:13.5px;font-weight:700;color:#fecaca}
    .lp-alert-in i{font-size:18px;margin-top:2px}
    /* -------- المميزات -------- */
    .lp-section{max-width:1200px;margin:0 auto;padding:46px 34px}
    .lp-sec-title{text-align:center;margin-bottom:38px}
    .lp-sec-title h2{font-size:clamp(22px,3vw,32px);font-weight:900;margin:0 0 8px}
    .lp-sec-title p{color:var(--lp-mut);font-weight:600;font-size:14px;margin:0}
    .lp-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
    @media(max-width:900px){.lp-grid{grid-template-columns:repeat(2,1fr)}}
    @media(max-width:600px){.lp-grid{grid-template-columns:1fr}}
    .lp-card{background:var(--lp-card);border:1px solid var(--lp-line);border-radius:20px;padding:26px 22px;transition:.25s;position:relative;overflow:hidden}
    .lp-card:hover{transform:translateY(-6px);border-color:rgba(255,255,255,.22);box-shadow:0 20px 44px rgba(0,0,0,.45)}
    .lp-card::before{content:'';position:absolute;inset-inline-start:0;top:0;bottom:0;width:4px;background:var(--c,linear-gradient(#6366f1,#a855f7))}
    .lp-ico{width:52px;height:52px;border-radius:16px;display:grid;place-items:center;font-size:24px;margin-bottom:16px;background:var(--c,linear-gradient(#6366f1,#a855f7));box-shadow:0 8px 20px rgba(0,0,0,.35)}
    .lp-card h3{font-size:17px;font-weight:900;margin:0 0 8px}
    .lp-card p{color:var(--lp-mut);font-size:13px;font-weight:600;line-height:1.85;margin:0}
    /* -------- الخطوات -------- */
    .lp-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;max-width:1000px;margin:0 auto}
    @media(max-width:760px){.lp-steps{grid-template-columns:1fr}}
    .lp-step{text-align:center;padding:28px 18px;background:var(--lp-card);border:1px solid var(--lp-line);border-radius:20px;position:relative}
    .lp-step-n{width:44px;height:44px;margin:0 auto 14px;border-radius:50%;display:grid;place-items:center;font-weight:900;font-size:18px;background:linear-gradient(135deg,#6366f1,#a855f7);box-shadow:0 8px 20px rgba(99,102,241,.45)}
    .lp-step h4{font-weight:900;font-size:15.5px;margin:0 0 6px}
    .lp-step p{color:var(--lp-mut);font-size:12.5px;font-weight:600;margin:0;line-height:1.8}
    /* -------- الدعوة الأخيرة -------- */
    .lp-cta{max-width:1000px;margin:0 auto;padding:30px 34px 70px;text-align:center}
    .lp-cta-box{background:linear-gradient(135deg,rgba(99,102,241,.2),rgba(168,85,247,.14),rgba(236,72,153,.12));border:1px solid rgba(255,255,255,.14);border-radius:26px;padding:52px 26px}
    .lp-cta-box h2{font-weight:900;font-size:clamp(22px,3vw,30px);margin:0 0 10px}
    .lp-cta-box p{color:var(--lp-mut);font-weight:600;margin:0 0 26px;font-size:14px}
    /* -------- الفوتر -------- */
    .lp-footer{border-top:1px solid var(--lp-line);padding:24px 34px;text-align:center;color:var(--lp-mut);font-size:12.5px;font-weight:600}
    .lp-footer b{color:#c7d2fe}
  </style>
</head>
<body class="lp">

<div class="lp-blobs">
  <div class="lp-blob b1"></div><div class="lp-blob b2"></div>
  <div class="lp-blob b3"></div><div class="lp-blob b4"></div>
</div>

<div class="lp-wrap">

  <!-- الشريط العلوي -->
  <nav class="lp-nav">
    <a class="lp-brand" href="/"><span class="lp-brand-badge">🛡️</span> Liberty City</a>
    <div class="lp-nav-links">
      <a href="#features">المميزات</a>
      <a href="#steps">كيف تبدأ؟</a>
      <a href="#cta">ابدأ الآن</a>
    </div>
    <a class="lp-nav-cta" href="/auth/discord"><i class="bi bi-box-arrow-in-left"></i> تسجيل الدخول</a>
  </nav>

  <!-- البطل -->
  <section class="lp-hero">
    <div>
      <span class="lp-pill"><span class="dot"></span> بوت عربي متكامل — حماية، ذكاء، وترفيه</span>
      <h1>سيرفرك بأفضل شكل<br><span class="grad">بضغطة زر واحدة</span></h1>
      <p>حماية متقدمة ضد الرايد والاختراق، ذكاء اصطناعي للإشراف، نظام تذاكر احترافي، اقتصاد ومتجر، ومستويات — كل ذلك من لوحة تحكم عربية سهلة تتحكم فيها من أي مكان.</p>
      <a href="/auth/discord" class="lp-btn-discord">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/></svg>
        تسجيل الدخول عبر Discord
      </a>
      <div class="lp-hint"><i class="bi bi-shield-check"></i> آمن تمامًا — OAuth2 الرسمي من Discord، بدون كلمات مرور</div>
    </div>

    <div class="lp-mock">
      <div class="lp-mock-head">
        <div class="lp-mock-ava">🛡️</div>
        <div><b>سيرفرك</b><small>لوحة التحكم — محدّث الآن</small></div>
      </div>
      <div class="lp-mock-row"><span class="lft">🚨 الحماية من الرايد</span><span class="lp-tgl on"></span></div>
      <div class="lp-mock-row"><span class="lft">🤖 الذكاء الاصطناعي</span><span class="lp-tgl in"></span></div>
      <div class="lp-mock-row"><span class="lft">🎫 نظام التذاكر</span><span class="lp-tgl on"></span></div>
      <div class="lp-mock-row"><span class="lft">💰 الاقتصاد والمتجر</span><span class="lp-tgl pn"></span></div>
      <div class="lp-mock-foot">
        <div class="lp-chip"><b>+60</b><small>أمر وميزة</small></div>
        <div class="lp-chip"><b>24/7</b><small>تشغيل دائم</small></div>
        <div class="lp-chip"><b>100%</b><small>عربي</small></div>
      </div>
    </div>
  </section>

  <% if (error) { %>
  <!-- رسالة خطأ الدخول -->
  <div class="lp-alert">
    <div class="lp-alert-in">
      <i class="bi bi-exclamation-triangle-fill"></i>
      <div>
        <%
          let msg = 'حدث خطأ غير متوقع — حاول مرة أخرى.';
          if (error === 'auth_failed') msg = 'تعذّر إكمال تسجيل الدخول مع Discord. جرّب من جديد، وإذا تكرر فراجع ضبط رابط الرجوع (Redirect URI).';
          else if (error === 'invalid_state') msg = 'انتهت جلسة الدخول أو اختلفت — اضغط زر الدخول مرة أخرى.';
          else if (error === 'access_denied') msg = 'لم توافق على صلاحيات الوصول. نحتاجها لنعرض سيرفاتك فقط.';
          else if (error === 'missing_client') msg = 'إعدادات الموقع ناقصة (Client ID/Secret) — راجع متغيرات البيئة في الاستضافة.';
        %>
        <%= msg %>
        <% if (detail) { %>
        <div style="margin-top:6px;color:#fca5a5;font-size:11.5px;direction:ltr;text-align:right;">تفاصيل تقنية: <span style="font-family:monospace"><%= detail %></span></div>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- المميزات -->
  <section class="lp-section" id="features">
    <div class="lp-sec-title">
      <h2>كل اللي يحتاجه سيرفرك <span style="color:#a855f7">بمكان واحد</span></h2>
      <p>موديولات جاهزة تشغّلها وتوقفها من لوحة تحكم واحدة</p>
    </div>
    <div class="lp-grid">
      <div class="lp-card" style="--c:linear-gradient(135deg,#6366f1,#8b5cf6)">
        <div class="lp-ico">🛡️</div>
        <h3>حماية شاملة</h3>
        <p>ضد الرايد، النيوك، السبام، البوتات المزعجة، والروابط المشبوهة — مع جزاءات تختارها انت.</p>
      </div>
      <div class="lp-card" style="--c:linear-gradient(135deg,#0ea5e9,#6366f1)">
        <div class="lp-ico">🤖</div>
        <h3>ذكاء اصطناعي</h3>
        <p>إشراف تلقائي على الرسائل، مساعد تذاكر يقرأ المشكلة ويقترح الحل، وترجمة فورية.</p>
      </div>
      <div class="lp-card" style="--c:linear-gradient(135deg,#06b6d4,#0ea5e9)">
        <div class="lp-ico">🎫</div>
        <h3>تذاكر احترافية</h3>
        <p>لوحات تذاكر، استلام وإغلاق من الداشبورد، سجل كامل، وأولويات — كل شي منظّم.</p>
      </div>
      <div class="lp-card" style="--c:linear-gradient(135deg,#f59e0b,#f97316)">
        <div class="lp-ico">💰</div>
        <h3>اقتصاد ومتجر</h3>
        <p>عملة خاصة، يومي وأسبوعي، بنك بفوايد، ومتجر تعرض فيه أي شي لأعضائك.</p>
      </div>
      <div class="lp-card" style="--c:linear-gradient(135deg,#22c55e,#84cc16)">
        <div class="lp-ico">🏆</div>
        <h3>مستويات وترحيب</h3>
        <p>نظام XP تلقائي، جوائز مستويات، ورسائل ترحيب قابلة للتخصيص حسب سيرفرك.</p>
      </div>
      <div class="lp-card" style="--c:linear-gradient(135deg,#ec4899,#a855f7)">
        <div class="lp-ico">👥</div>
        <h3>تحكم كامل بالأعضاء</h3>
        <p>طرد/حظر/توقيت وتحديد رولات من الموقع مباشرة — حتى لو البوت شغال على استضافة ثانية.</p>
      </div>
    </div>
  </section>

  <!-- الخطوات -->
  <section class="lp-section" id="steps">
    <div class="lp-sec-title">
      <h2>تبدأ في <span style="color:#22c55e">أقل من دقيقة</span></h2>
      <p>ثلاث خطوات فقط</p>
    </div>
    <div class="lp-steps">
      <div class="lp-step">
        <div class="lp-step-n">1</div>
        <h4>سجّل دخولك</h4>
        <p>زر Discord فوق — بدون تسجيل أو كلمات مرور.</p>
      </div>
      <div class="lp-step">
        <div class="lp-step-n">2</div>
        <h4>اختر سيرفرك</h4>
        <p>نعرض لك سيرفاتك اللي عندك فيها صلاحية إدارة.</p>
      </div>
      <div class="lp-step">
        <div class="lp-step-n">3</div>
        <h4>اضبط كل شي</h4>
        <p>شغّل الحماية، وافتح التذاكر والاقتصاد — من مكان واحد.</p>
      </div>
    </div>
  </section>

  <!-- الدعوة -->
  <section class="lp-cta" id="cta">
    <div class="lp-cta-box">
      <h2>جاهز تسوّي سيرفرك احترافي؟ 🚀</h2>
      <p>ادخل الآن وشوف الفرق بنفسك — كله مجاني.</p>
      <a href="/auth/discord" class="lp-btn-discord">
